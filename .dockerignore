# Secrets and local config -- pass at run time (--env-file), never bake in.
.env

# Environments and caches (rebuilt by `uv sync` inside the image)
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.code_quality/.ruff_cache/

# VCS and tool state. Without .git the image cannot run git-dependent tests or
# `pre-commit install`; mount a checkout for that (README "Container image").
.git/
.claude/
.superpowers/
.worktrees/

# Generated / local output. artifacts/ holds the published-diagram .mhtml snapshots,
# which nothing in tests/, src/ or cli/ reads (T-920 re-checks this).
/data.ttl
artifacts/

# The source .docx is not needed to run anything
*.docx
