# Copy to .env and adjust for your machine. .env is git-ignored.
# The SQL_URLS_DB/SQL_NLP_DB and KG_SCHEMA_DIR..KG_SAMPLE_NEWS_ROWS keys are consumed by
# src/etl/config.py (via python-dotenv); all are optional except SQL_URLS_DB, which
# points at the external news-collector SQLite database. The GraphDB KG_* keys at the
# bottom are for the triple store (docs/graphdb-setup.md).

# Path to the news-collector / news-crawler SQLite database (urls.db). This is
# the SOURCE side of portfolio_common.news_nlp's two-tier contract (has
# articles.body_text). In this dev container it is bind-mounted from $THESIS_HOST_DIR
# (see .devcontainer/devcontainer.json).
SQL_URLS_DB=/workspaces/thesis/data/urls.db

# Path to the portfolio-nlp results store (nlp.db) -- the RESULTS side of the
# two-tier contract (article_sentiment/article_category, no body_text).
# Defaults to <repo>/data/nlp.db.
# SQL_NLP_DB=/workspaces/thesis/data/nlp.db

# Path to portfolio-data-mining's point-in-time universe.db (SCD-2 universe_membership),
# read-only: the :Asset / :UniverseMembership source. Refreshed by hand upstream, so it can
# lag the index; each ETL run prints its latest recorded change and file date.
# Defaults to <repo>/data/universe.db.
# SQL_UNIVERSE_DB=/workspaces/thesis/data/universe.db

# Read-only SQLite database of portfolio-financial-analysis, read through its v_* views
# (cli/project_scores.py). Defaults to <repo>/data/financial.db.
# SQL_FINANCIAL_DB=/workspaces/thesis/data/financial.db

# Checkout of portfolio-financial-analysis (the repo root, with src/kg_schema). Read only by the
# opt-in drift test: PFA_CHECKOUT=<path> uv run pytest -s -m integration
# tests/test_contract_check_checkout.py. No default: unset, the test is skipped; set to a path
# that is not a checkout, it fails. Run it before every re-pin of src/projection/view_contract.py.
# PFA_CHECKOUT=/workspaces/portfolio-financial-analysis

# Directory holding tbox.ttl / shapes.ttl / reference.ttl / rules.ttl.
# Defaults to <repo>/schema.
# KG_SCHEMA_DIR=/workspaces/ontology/schema

# Where the generated flat-Turtle dataset is written. Defaults to <repo>/data.ttl.
# KG_DATA_TTL=/workspaces/ontology/data.ttl

# Rows included in the post-build SHACL validation sample. Default 500.
# KG_SAMPLE_NEWS_ROWS=500

# --- GraphDB (the knowledge-graph store; WI3 T-020) -------------------------------
# Base URL of the GraphDB server, without a repository path. From this dev container the
# host is reached as host.docker.internal (localhost is the container itself).
KG_HOST=http://host.docker.internal:7200

# Repository id inside GraphDB (created in the Workbench: Setup -> Repositories).
KG_REPOSITORY=portfolio

# GraphDB user with write access to KG_REPOSITORY. Sent as HTTP Basic auth; required once
# GraphDB security is enabled. Never commit real values.
KG_USER=
KG_PASSWORD=

# Optional, for `pytest -m integration tests/test_store_cli_exit_codes.py` only (T-175): an account
# that may create and delete repositories. The tests create a repository of their own
# (kgtest-...), run load_schema/ingest on it as this account and delete it; never `portfolio`.
# Unset, those tests are skipped.
# KG_ADMIN_USER=
# KG_ADMIN_PASSWORD=
