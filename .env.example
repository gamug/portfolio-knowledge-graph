# Copy to .env and adjust for your machine. .env is git-ignored.
# Consumed by etl/config.py (via python-dotenv). All keys are optional except
# KG_URLS_DB, which points at the external news-collector SQLite database.

# Path to the news-collector / news-crawler SQLite database (urls.db). This is
# the SOURCE side of portfolio_common.news_nlp's two-tier contract (has
# articles.body_text). In this dev container it is bind-mounted from D:\thesis
# (see .devcontainer/devcontainer.json).
KG_URLS_DB=/workspaces/thesis/data/urls.db

# Path to the portfolio-nlp results store (nlp.db) -- the RESULTS side of the
# two-tier contract (article_sentiment/article_category, no body_text).
# Defaults to <repo>/data/nlp.db.
# KG_RESULTS_DB=/workspaces/thesis/data/nlp.db

# Directory holding tbox.ttl / shapes.ttl / reference.ttl / rules.ttl.
# Defaults to <repo>/schema.
# KG_SCHEMA_DIR=/workspaces/ontology/schema

# Where the generated flat-Turtle dataset is written. Defaults to <repo>/data.ttl.
# KG_DATA_TTL=/workspaces/ontology/data.ttl

# S&P 500 constituent table to parse for the :Asset population.
# KG_SP500_SOURCE_URL=https://en.wikipedia.org/wiki/List_of_S%26P_500_companies

# Rows included in the post-build SHACL validation sample. Default 500.
# KG_SAMPLE_NEWS_ROWS=500
