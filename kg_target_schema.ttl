#################################################################
# portfolio-knowledge-graph -- target schema for the v_* views
# portfolio-financial-analysis is changing (third version, answering
# your third reply of 2026-10-06, checked at 597832a).
#
# PART 1 is portfolio-knowledge-graph's schema/tbox.ttl + shapes.ttl at
# master 5a0d1f7 (schema/ unchanged since 36ac3e5): only the classes,
# properties and SHACL shapes your views project into. It is verbatim
# EXCEPT where a "# CHANGED (T-1xx)" comment marks a correction your
# replies made necessary: five shape changes (the SECTOR rawValue
# range, the attractivenessScore lower bound, :inverted's minCount;
# from your third reply, T-171: ScoreFinanciero exempt from
# normalizedScore, and rawValue mandatory for it instead) and eleven
# comments (nine rewritten; schemeId's and rawValue's added).
# PART 2 (end of file) is PROPOSED: the terms your T-144 columns feed.
# Neither the CHANGED lines nor PART 2 are on our master yet; they are
# planned in our Work items 12 (T-121) and 15 (T-151..T-156, T-171).
# T-171's two shape changes and two comments are already in our
# schema/ in portfolio-knowledge-graph PR #56; T-121's scheme terms are
# in PR #65 (see the T-121 block below: the date became :cycleDate).
# T-210 also mirrors the FIBO rdfs:seeAlso links for the four terms this
# file declares (:Portfolio, :PortfolioPosition, :tickerSymbol,
# :SECFiling); :Sector and :Industry are only referred to as ranges here,
# so they have no declaration to mirror. T-211 mirrors the Spanish
# rdfs:label@es and skos:definition@es for the 14 leaf classes this file
# declares from that same Phase 2 set. T-233/T-234 mirror the required
# :runLabel and the window/segment sh:pattern constraints.
#
# Namespace: https://thesis.local/kg/portfolio#  (prefix ":")
# OWL = what can be inferred (open world); SHACL = what our ingest
# gate rejects (closed world). A row that cannot satisfy a shape
# here is rejected on write, so the shapes are the contract.
#################################################################

@prefix : <https://thesis.local/kg/portfolio#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AssetCoOccurrenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :coOccurrenceMethod ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :coOccurrenceWeight ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :coOccurrenceComputedOn ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :provenanceId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :runId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :runAsOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :codeVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :engineVersion ],
        [ sh:class :Asset ;
            sh:maxCount 2 ;
            sh:minCount 2 ;
            sh:path :coOccurrenceAsset ],
        [ sh:in ( "SHARED_EXECUTIVE_CANDIDATE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :coOccurrenceKind ] ;
    sh:targetClass :AssetCoOccurrence .

:AssetShape a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path :cikNumber ] [ sh:minCount 1 ;
                sh:node [ sh:property [ sh:minCount 1 ;
                                sh:path :validTo ] ] ;
                sh:path :hasUniverseMembership ] ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :tickerSymbol ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :cikNumber ] ;
    sh:targetClass :Asset .

:AttractivenessSnapshotShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :attractivenessOfAsset ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:minCount 1 ;
            # CHANGED (T-155): sh:minInclusive 0.0 removed. blended_score / 100,
            # and soft-veto penalties can make it negative (your reply, 1.2).
            sh:path :attractivenessScore ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :computedAt ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :computedWithScheme ] ;
    sh:targetClass :AttractivenessSnapshot .

:AttractivenessWeightSchemeShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :schemeId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :validFrom ],
        [ sh:minCount 1 ;
            sh:path :hasWeightComponent ] ;
    sh:targetClass :AttractivenessWeightScheme .

:BenchmarkObservationShape a sh:NodeShape ;
    sh:or ( [ sh:node [ sh:property [ sh:hasValue "BENCHMARK" ;
                                sh:path :portfolioKind ] ] ;
                sh:path :quantPortfolio ] [ sh:in ( "realized_return" "cumulative_return" "benchmark_return" "active_return" ) ;
                sh:path :quantMetric ] ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :runId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :runAsOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :codeVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :engineVersion ],
        [ sh:class :Portfolio ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node :QuantSubjectShape ;
            sh:path :quantPortfolio ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :quantMetric ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :quantValue ],
        [ sh:class :Asset ;
            sh:maxCount 1 ;
            sh:path :quantAsset ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :quantUnit ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :quantAsOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :quantBenchmark ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :provenanceId ] ;
    sh:targetClass :BenchmarkObservation .

:DataQualityIssueShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :runId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :runAsOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :codeVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :engineVersion ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :dqIssueOfAsset ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :dqRaisedOn ],
        [ sh:maxCount 1 ;
            sh:path :dqIssueOfFiling ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :dqMetricName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :provenanceId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :dqGateCode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :dqSeverity ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :quarantined ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path :gatedValue ] ;
    sh:targetClass :DataQualityIssue .

:PortfolioPositionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :runId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :runAsOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :codeVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :engineVersion ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :positionAsset ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path :weightPct ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :validFrom ] ;
    sh:targetClass :PortfolioPosition .

:PortfolioShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :portfolioName ],
        [ sh:in ( "LIVE" "BENCHMARK" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :portfolioKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :benchmarkObjective ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:not [ sh:in ( "live_book" ) ] ;
            sh:path :benchmarkKind ] ;
    sh:targetClass :Portfolio .

:RuleDefinitionShape a sh:NodeShape ;
    sh:or ( [ sh:minCount 1 ;
                sh:path :validTo ] [ sh:minCount 1 ;
                sh:path :ruleSeverity ] [ sh:hasValue "GUARD" ;
                sh:path :category ] ) ;
    # CHANGED (T-187): a HARD rule excludes the asset, so it carries no penaltyPoints. Needs no action from upstream:
    # their penalty_points is already null on HARD rules and the rank is ours. A HARD rule's SOFT stint is charged the
    # run's soft_veto_penalty (our assumption, not yet confirmed: T-189).
    sh:not [ a sh:NodeShape ;
            sh:property [ sh:hasValue "HARD" ;
                    sh:path :ruleSeverity ],
                [ sh:minCount 1 ;
                    sh:path :penaltyPoints ] ] ;
    # T-206: a GUARD rule is a RuleDefinition but not a veto rule. It carries :category "GUARD" and no
    # :ruleSeverity/:penaltyPoints/:priorityRank; every non-GUARD rule still needs a priorityRank.
    sh:or ( [ sh:hasValue "GUARD" ;
                sh:path :category ] [ sh:minCount 1 ;
                sh:path :priorityRank ] ) ;
    sh:not [ a sh:NodeShape ;
            sh:property [ sh:hasValue "GUARD" ;
                    sh:path :category ] ;
            sh:or ( [ sh:minCount 1 ;
                        sh:path :ruleSeverity ] [ sh:minCount 1 ;
                        sh:path :penaltyPoints ] [ sh:minCount 1 ;
                        sh:path :priorityRank ] ) ] ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :validFrom ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :hasClause ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 10 ;
            sh:minInclusive 1 ;
            sh:path :priorityRank ],
        # CHANGED (T-187): upstream's penalty_points, on SOFT rules only (null on HARD ones: no triple); at least 0.
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path :penaltyPoints ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :ruleId ],
        [ sh:in ( "HARD" "SOFT" ) ;
            sh:maxCount 1 ;
            sh:path :ruleSeverity ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 4 ;
            sh:minInclusive 1 ;
            sh:path :guardLayer ] ;
    sh:targetClass :RuleDefinition .

:ScoreSnapshotShape a sh:NodeShape ;
    # CHANGED (T-171, D17): "ScoreFinanciero" added. Your normalized_score is rewritten in place by
    # every cycle that re-normalizes a filing (your third reply), which breaks our immutable-observation
    # principle for a value keyed only by the filing. normalizedScore is now optional (not forbidden)
    # for FUNDAMENTAL too; the cohort-relative value is read instead as :componentValue (below) on the
    # WeightComponent your per-asset effective_weight produces, correctly scoped to one cycle_run.
    sh:or ( [ sh:hasValue "SectorRelativeMomentum" ;
                sh:path :metricType ] [ sh:hasValue "Sentiment" ;
                sh:path :metricType ] [ sh:hasValue "ScoreFinanciero" ;
                sh:path :metricType ] [ sh:minCount 1 ;
                sh:path :normalizedScore ] ),
        ( [ sh:not [ sh:hasValue "Sentiment" ;
                        sh:path :metricType ] ] [ sh:datatype xsd:decimal ;
                sh:maxInclusive 1.0 ;
                sh:minCount 1 ;
                sh:minInclusive -1.0 ;
                sh:path :rawValue ] ),
        # CHANGED (T-155): was [-1.0, 1.0]. Your SECTOR raw_value read verbatim,
        # in TECHNICAL points (your reply, 1.1).
        ( [ sh:not [ sh:hasValue "SectorRelativeMomentum" ;
                        sh:path :metricType ] ] [ sh:datatype xsd:decimal ;
                sh:maxInclusive 100.0 ;
                sh:minCount 1 ;
                sh:minInclusive -100.0 ;
                sh:path :rawValue ] ),
        # CHANGED (T-171, D17): new. With normalizedScore optional for FUNDAMENTAL (above), rawValue
        # becomes mandatory in its place, so a FUNDAMENTAL snapshot can't carry neither.
        # T-177: bounded to [0,100], your answer to Q6 (2026-10-09).
        ( [ sh:not [ sh:hasValue "ScoreFinanciero" ;
                        sh:path :metricType ] ] [ sh:datatype xsd:decimal ;
                sh:maxInclusive 100.0 ;
                sh:minCount 1 ;
                sh:minInclusive 0.0 ;
                sh:path :rawValue ] ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:minInclusive 0.0 ;
            sh:path :normalizedScore ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :timestamp ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :availableAt ],
        [ sh:datatype xsd:date ;
            sh:lessThanOrEquals :availableAt ;
            sh:maxCount 1 ;
            sh:path :eventTime ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :scoreMethod ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :runId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :runAsOf ],
        [ sh:in ( "FUNDAMENTAL" "SEMANTIC" "VALORIZATION" "TECHNICAL" "SECTOR" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :agentOrigin ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :codeVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :engineVersion ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path :rawValue ],
        [ sh:datatype xsd:string ;
            sh:in ( "ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :metricType ] ;
    sh:targetClass :ScoreSnapshot ;
    sh:xone ( [ sh:property [ sh:hasValue "FUNDAMENTAL" ;
                        sh:path :agentOrigin ],
                    [ sh:hasValue "ScoreFinanciero" ;
                        sh:path :metricType ] ] [ sh:property [ sh:hasValue "VALORIZATION" ;
                        sh:path :agentOrigin ],
                    [ sh:hasValue "ScoreCuantitativo" ;
                        sh:path :metricType ] ] [ sh:property [ sh:hasValue "TECHNICAL" ;
                        sh:path :agentOrigin ],
                    [ sh:hasValue "ScoreTecnico" ;
                        sh:path :metricType ] ] [ sh:property [ sh:hasValue "SECTOR" ;
                        sh:path :agentOrigin ],
                    [ sh:hasValue "SectorRelativeMomentum" ;
                        sh:path :metricType ] ] [ sh:property [ sh:hasValue "SEMANTIC" ;
                        sh:path :agentOrigin ],
                    [ sh:hasValue "Sentiment" ;
                        sh:path :metricType ] ] ) .

:SectorAggregateSnapshotShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :runId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :runAsOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :codeVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :engineVersion ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :sectorSnapshotOfSector ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path :normalizedScore ],
        [ sh:hasValue "ScoreTecnico" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :metricType ],
        [ sh:hasValue "SECTOR" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :agentOrigin ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :timestamp ] ;
    sh:targetClass :SectorAggregateSnapshot .

:VetoShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :runId ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :runAsOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :codeVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path :engineVersion ],
        [ sh:datatype xsd:date ;
            sh:lessThan :clearedOn ;
            sh:lessThanOrEquals :expiresOn,
                :lastSeenOn ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :raisedOn ],
        # CHANGED (T-188): upstream's expires_on, optional, multi-valued like lastSeenOn (they move it while the condition
        # holds; current = MAX), every value not before raisedOn. It never closes a stint (only clearedOn does). Needs no
        # action from upstream: it is their own column, filled only on the temporary HARD rules' stints.
        [ sh:datatype xsd:date ;
            sh:path :expiresOn ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path :clearedOn ],
        [ sh:datatype xsd:date ;
            sh:lessThanOrEquals :clearedOn ;
            sh:path :lastSeenOn ],
        [ sh:in ( "HARD" "SOFT" ) ;
            sh:maxCount 1 ;
            sh:path :vetoSeverity ],
        # T-206: a GUARD rule is not a veto rule; refuse it as the object of either rule link.
        [ sh:node [ sh:not [ sh:property [ sh:hasValue "GUARD" ;
                                sh:path :category ] ] ] ;
            sh:path :appliesRule ],
        [ sh:node [ sh:not [ sh:property [ sh:hasValue "GUARD" ;
                                sh:path :category ] ] ] ;
            sh:path :primaryRule ] ;
    sh:targetClass :Veto .

:WeightComponentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :weightMetricName ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path :weightValue ],
        # CHANGED (T-121): sh:minCount 1 removed; never emitted for your schemes.
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path :inverted ] ;
    sh:targetClass :WeightComponent .

:accessionNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :SECFiling ;
    rdfs:range xsd:string .

:appliesRule a owl:ObjectProperty ;
    rdfs:comment "All rules that fired for this Veto (v1 'Mapeo de Activaciones Multiples')." ;
    rdfs:domain :Veto ;
    rdfs:range :RuleDefinition .

:classifiedAs a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "An Asset's GICS industry group. Functional: one primary industry per Asset at a time." ;
    rdfs:domain :Asset ;
    rdfs:range :Industry ;
    owl:inverseOf :industryOfAsset .

:companyName a owl:DatatypeProperty ;
    rdfs:domain :Asset ;
    rdfs:range xsd:string .

:decidedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Veto ;
    rdfs:range xsd:dateTime .

:evidenceForRiskEvent a owl:ObjectProperty ;
    rdfs:comment "Inverse of backedBy — supports 'which risk events cite this article/section' audit queries (evolution layer B9)." ;
    rdfs:domain :EvidenceSource ;
    rdfs:range :RiskEvent .

:filingDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :SECFiling ;
    rdfs:range xsd:date .

:filingOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :SECFiling ;
    rdfs:range :Asset .

:formType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "'10-K' | '10-Q' | '8-K' | 'DEF 14A'." ;
    rdfs:domain :SECFiling ;
    rdfs:range xsd:string .

:hasExecutive a owl:ObjectProperty ;
    rdfs:comment "Extracted from DEF 14A (v1 §2B)." ;
    rdfs:domain :Asset ;
    rdfs:range :Executive .

:hasScoreObservation a owl:ObjectProperty ;
    rdfs:comment "v1 §3A: (Asset)-[:HAS_SCORE_OBSERVATION]->(ScoreSnapshot)." ;
    rdfs:domain :Asset ;
    rdfs:range :ScoreSnapshot ;
    owl:inverseOf :scoreSnapshotOfAsset .

:holdsPosition a owl:ObjectProperty ;
    rdfs:domain :Portfolio ;
    rdfs:range :PortfolioPosition .

:primaryRule a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The single lowest-priorityRank rule among appliesRule (v1 §4)." ;
    rdfs:domain :Veto ;
    rdfs:range :RuleDefinition .

:sharedExecutiveWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Derived/asserted by the entity-resolution service (roadmap step 7), never hand-authored. Backs VETO_RED_01's HasSharedPrimaryVetoExecutive(A) check (v1 §4). T-107 (D10): reserved for VERIFIED shared directorships (e.g. from DEF 14A). Upstream's news co-occurrence candidates are projected as :AssetCoOccurrence individuals instead and must never be written as this property." ;
    rdfs:domain :Asset ;
    rdfs:range :Asset .

:triggeredBy a owl:ObjectProperty ;
    rdfs:comment "v1 §3B: (Veto)-[:DISPARADO_POR]->(RiskEvent)." ;
    rdfs:domain :Veto ;
    rdfs:range :RiskEvent .

:triggeredVeto a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Veto ;
    owl:inverseOf :vetoOfAsset .

:QuantSubjectShape a sh:NodeShape ;
    sh:property [ sh:in ( "LIVE" "BENCHMARK" ) ;
            sh:path :portfolioKind ] .

:attractivenessOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :AttractivenessSnapshot ;
    rdfs:range :Asset ;
    owl:inverseOf :hasAttractivenessSnapshot .

:attractivenessScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-155): comment rewritten; the blend formula is no longer described here.
    rdfs:comment "Upstream v_cycle_ranking.blended_score / 100: higher = more attractive, at most 1.0, negative when soft-veto penalties exceed the blend. Read, never computed here; the inverse sense of ScoreSnapshot.normalizedScore's risk convention." ;
    rdfs:domain :AttractivenessSnapshot ;
    rdfs:range xsd:decimal .

:benchmarkKind a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Optional. Upstream's v_quant_portfolio.kind, verbatim: the name the book was configured under. It is the join key v_quant_vs_live uses (with as_of), so it is kept next to the objective label. Never live_book (those are not projected as Portfolios)." ;
    rdfs:domain :Portfolio ;
    rdfs:range xsd:string .

:benchmarkObjective a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Upstream's objective label for a BENCHMARK book, carried verbatim and not interpreted: v_quant_portfolio.objective, the solver result's label. Not a closed list (upstream's configurable defaults are min_var, tangency, target_vol, risk_parity; T-109)." ;
    rdfs:domain :Portfolio ;
    rdfs:range xsd:string .

:coOccurrenceAsset a owl:ObjectProperty ;
    rdfs:comment "The two assets linked (SHACL: exactly 2). Unordered, so no direction is implied." ;
    rdfs:domain :AssetCoOccurrence ;
    rdfs:range :Asset .

:coOccurrenceComputedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-154): comment rewritten; your T-144 adds computed_at.
    rdfs:comment "Date the edge set was computed: the date part of upstream v_shared_executive_edge.computed_at (ISO 8601 UTC, +00:00 or Z), read once upstream's T-144 adds the column. first_seen/last_seen are not read until upstream fills them. The individual is immutable and a recompute is a new individual in a new dated graph." ;
    rdfs:domain :AssetCoOccurrence ;
    rdfs:range xsd:date .

:coOccurrenceKind a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "SHARED_EXECUTIVE_CANDIDATE (upstream shared_executive_edge). The MEDIA kind for media_cooccurrence (non-executive; table unpopulated until upstream's T-082, endpoints unknown) is deliberately NOT enumerated yet: add it, and its own shape rules, once the columns are known; as of T-109 there is no v_* view for media_cooccurrence at all." ;
    rdfs:domain :AssetCoOccurrence ;
    rdfs:range xsd:string .

:coOccurrenceMethod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Upstream method id, e.g. news-per-cooccurrence-v1. Upstream recomputes per method, so different methods are different individuals; readers must filter on it." ;
    rdfs:domain :AssetCoOccurrence ;
    rdfs:range xsd:string .

:coOccurrenceWeight a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Upstream's edge weight, in the method's own unit (not normalized, not comparable across methods). Upstream emits no separate confidence; none is invented here." ;
    rdfs:domain :AssetCoOccurrence ;
    rdfs:range xsd:decimal .

:computedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :AttractivenessSnapshot ;
    rdfs:range xsd:dateTime .

:computedWithScheme a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Audit trail -- same role appliesRule/primaryRule play for Veto." ;
    rdfs:domain :AttractivenessSnapshot ;
    rdfs:range :AttractivenessWeightScheme .

:dqGateCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The Ring-1 gate that fired, e.g. DQ_* code from upstream's data_quality_issue." ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range xsd:string .

:dqIssueOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range :Asset .

:dqIssueOfFiling a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Optional: the filing whose data the gate fired on (what DATA_QUALITY's 'latest filing' refers to)." ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range :SECFiling .

:dqMetricName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Optional: the gated metric (a ThresholdComparison metricName-style id). Provenance back to upstream's row uses :provenanceId." ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range xsd:string .

:dqRaisedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Cycle date the gate fired (as-of key for the issue, like :raisedOn on a Veto)." ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range xsd:date .

:dqSeverity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Upstream's issue severity; HARD escalates to the DATA_QUALITY veto. Other values pass through unconstrained." ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range xsd:string .

:eventTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "T-101 (D2): what the observation is ABOUT -- filing period-end (FUNDAMENTAL), cycle date (TECHNICAL, VALORIZATION -- formerly QUANTITATIVE, SECTOR), article day (SEMANTIC). Never used to filter as-of reads; see availableAt." ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:date .

:gatedValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "The value the gate rejected, when numeric (upstream's type is unconfirmed, T-030); a non-numeric value is carried as :dqMetricName context only, not here." ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range xsd:decimal .

:hasAttractivenessSnapshot a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :AttractivenessSnapshot .

:hasUniverseMembership a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :UniverseMembership ;
    owl:inverseOf :membershipAsset .

:hasWeightComponent a owl:ObjectProperty ;
    rdfs:domain :AttractivenessWeightScheme ;
    rdfs:range :WeightComponent .

:inverted a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-121): comment rewritten.
    rdfs:comment "Design history only (WeightScheme_v1). Upstream's weights apply to its own 0-100 strength scores, so no scheme projected from v_weight_component carries it." ;
    rdfs:domain :WeightComponent ;
    rdfs:range xsd:boolean .

:portfolioName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Portfolio ;
    rdfs:range xsd:string .

:positionAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :PortfolioPosition ;
    rdfs:range :Asset .

:penaltyPoints a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :RuleDefinition ; rdfs:range xsd:decimal ;
    rdfs:comment "T-187: upstream's penalty_points, in points of its 0-100 blend, charged once per active SOFT stint of the rule. SOFT rules only (null on HARD ones: no triple). A SOFT stint whose rule has none costs the run's soft_veto_penalty (T-189); that includes a SOFT stint of a HARD rule (our assumption, not yet confirmed). At least 0." .

:priorityRank a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "1 (highest) .. 9 (lowest), used to pick primaryRule (v1 §4); upstream's nine-rule catalog uses 1 to 9 since T-187 (unique among active definitions only). (Comment corrected 2026-08-23: stale '6' predates VETO_MKT_02, added 2026-08-13 as the 7th rule -- shapes.ttl's RuleDefinitionShape already had priorityRank's range right; widened to [1,9] by T-187.)" ;
    rdfs:domain :RuleDefinition ;
    rdfs:range xsd:integer .

:quantAsOf a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Optional date the number refers to: v_quant_portfolio.as_of for a book metric, v_quant_vs_live.as_of for an active weight, v_quant_benchmark_performance.date for a performance row (T-109). Immutable: a recompute is a new individual." ;
    rdfs:domain :BenchmarkObservation ;
    rdfs:range xsd:date .

:quantAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Only for per-asset numbers (active weight vs the live book); absent for whole-book metrics." ;
    rdfs:domain :BenchmarkObservation ;
    rdfs:range :Asset .

:quantBenchmark a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Optional. The reference index a performance number is measured against (v_quant_benchmark_performance.benchmark, e.g. bench-v2 or SPY_TR), verbatim. benchmark_return and active_return are meaningless without it." ;
    rdfs:domain :BenchmarkObservation ;
    rdfs:range xsd:string .

:quantUnit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Optional unit of quantValue. Values are never converted. Vocabulary (T-109): fraction (0.05 = 5%, no time basis), fraction_annual (expected_return, expected_vol: annualised), fraction_daily (realized_return, benchmark_return, active_return: one trading day), ratio (sharpe: unitless), count. Only quant_position weights are scaled by the projection, x100, because weightPct is 0-100." ;
    rdfs:domain :BenchmarkObservation ;
    rdfs:range xsd:string .

:quantValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Upstream's value, in its own unit." ;
    rdfs:domain :BenchmarkObservation ;
    rdfs:range xsd:decimal .

:quarantined a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "True when the gated metric was quarantined (reads as NULL upstream)." ;
    rdfs:domain :DataQualityIssue ;
    rdfs:range xsd:boolean .

:raisedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Cycle date on which the stint began (upstream raised_on). Required. Active at cutoff C iff raisedOn <= C AND (no clearedOn OR clearedOn > C); the T-1 lag is this predicate applied at read time (schema/README.md has the SPARQL), not an orchestrator feature. Added 2026-10-03 (T-102)." ;
    rdfs:domain :Veto ;
    rdfs:range xsd:date .

:ruleId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :RuleDefinition ;
    rdfs:range xsd:string .

:schemeId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-121): comment added.
    rdfs:comment "Identifies the blend: 'cycle_run:<id>' of the run that recorded it. Not upstream's scheme_id, which is the book-weighting rule (:bookWeightingRule)." ;
    rdfs:domain :AttractivenessWeightScheme ;
    rdfs:range xsd:string .

:scoreMethod a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "T-111 (D14): optional method discriminator, so two ways of producing the same agentOrigin/metricType can coexist without a reader double-counting or picking the wrong one (upstream semantic-score-boundary.md W11, for the cut-over window). Open vocabulary: upstream has not fixed the value for its per-(asset, day) SEMANTIC aggregate yet, so SHACL does not enumerate it. Every SEMANTIC snapshot carries one: this repo's per-article FinBERT sentiment from src/etl/ is ARTICLE_SENTIMENT, and the worked per-(asset, day) snapshots in instances.trig use the illustrative placeholder ASSET_DAY_AGGREGATE until upstream names its value. A snapshot without scoreMethod is the single method of its agentOrigin (every non-SEMANTIC snapshot today); a new SEMANTIC producer must set it. Not the same as upstream's score_snapshot.model, a label that defaults to 'deterministic'." ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:string .

:scoreSnapshotOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range :Asset .

:sectorSnapshotOfSector a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :SectorAggregateSnapshot ;
    rdfs:range :Sector ;
    owl:inverseOf :hasSectorSnapshot .

:tickerSymbol a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Asset ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIdentification/TickerSymbol> .

:vetoOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :Veto ;
    rdfs:range :Asset .

:vetoSeverity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "HARD | SOFT -- this stint's severity, which can differ from its rule's :ruleSeverity (LEVERAGE_EXTREME emits SOFT for a negative-equity firm). A SOFT stint charges its rule's :penaltyPoints once, or the run's soft_veto_penalty if the rule declares none, a HARD rule's SOFT stint included (our assumption, not yet confirmed by upstream: T-189). Optional: absent means the severity of the stint's :primaryRule (:ruleSeverity; the superseded design-history rules carry none). Added 2026-10-03 (T-102)." ;
    rdfs:domain :Veto ;
    rdfs:range xsd:string .

:weightMetricName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Matches a ScoreSnapshot.metricType value. Named distinctly from ThresholdComparison's metricName to avoid a shared-property domain clash (see ObservationSnapshot's rationale)." ;
    rdfs:domain :WeightComponent ;
    rdfs:range xsd:string .

:weightPct a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :PortfolioPosition ;
    rdfs:range xsd:decimal .

:weightValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :WeightComponent ;
    rdfs:range xsd:decimal .

:EvidenceSource a owl:Class ;
    rdfs:label "Evidence Source" ;
    rdfs:comment "Anything a RiskEvent can be backedBy." ;
    rdfs:subClassOf :Evidence .

:SectorAggregateSnapshot a owl:Class ;
    rdfs:label "Sector Aggregate Snapshot" ;
    rdfs:label "instantánea agregada por sector"@es ;
    skos:definition "Instantánea inmutable y con marca de tiempo que agrega el ScoreTecnico de los activos miembros de un sector en una fecha, escrita por el agente de sector."@es ;
    rdfs:comment "Immutable, timestamped roll-up of member Assets' ScoreTecnico for one Sector on one date, written by the Sector Agent (08-agent-architecture.md). Added 2026-08-13, closes part of critique #3 (sector layer) -- see docs/superpowers/specs/2026-08-13-attractiveness-sector-momentum-design.md." ;
    rdfs:subClassOf :ObservationSnapshot .

:availableAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-153): cycle lanes added to the comment.
    rdfs:comment "T-101 (D2): first date the observation may be used by a reader (look-ahead guard; for FUNDAMENTAL, the first NYSE trading day after the filing date; for TECHNICAL, VALORIZATION and SECTOR, the cycle date, as upstream's v_score_snapshot defines it). Read from upstream, never filled in here: a row without it is not projected. Every as-of-D query MUST filter availableAt <= D, never eventTime or timestamp. Distinct from timestamp, which is when the row was computed/ingested." ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:date .

:cikNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "SEC Central Index Key — stable join key to edgar_tool.py output." ;
    rdfs:domain :Asset ;
    rdfs:range xsd:string .

:clearedOn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Cycle date on which the stint closed (upstream cleared_on): a HARD veto clears when its rule re-evaluates clean. Absent = still active. Closed by writing this triple (in the clearing cycle's ORCHESTRATOR graph), never by deleting the Veto. Added 2026-10-03 (T-102)." ;
    rdfs:domain :Veto ;
    rdfs:range xsd:date .

:expiresOn a owl:DatatypeProperty ;
    rdfs:comment "T-188: upstream's expires_on, the date a temporary HARD stint (VOLATILITY_SHOCK, CRASH_Z_SCORE) is next re-checked; never set on a SOFT stint. Optional and not functional, like lastSeenOn: the cycle moves expires_on 10 NYSE sessions on while the condition holds, so each move is a new value and the current one is the MAX. Each value is not before raisedOn. It does NOT close the stint: only clearedOn does (the cycle writes it at the first cycle on or after expires_on when the condition is gone)." ;
    rdfs:domain :Veto ;
    rdfs:range xsd:date .

:hasClause a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Root of the rule's expression tree. May point directly to a leaf comparison for single-signal rules (e.g. VETO_FIN_01) — the tree degenerates gracefully to one node." ;
    rdfs:domain :RuleDefinition ;
    rdfs:range :RuleOperand .

:lastSeenOn a owl:DatatypeProperty ;
    rdfs:comment "Most recent cycle date on which the rule still fired for this stint (upstream last_seen_on). Optional and deliberately NOT functional: ORCHESTRATOR graphs are append-only, so each cycle adds a new value in its own graph and the current one is MAX(?lastSeenOn). Added 2026-10-03 (T-102)." ;
    rdfs:domain :Veto ;
    rdfs:range xsd:date .

:quantMetric a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Upstream's metric name, verbatim; no vocabulary is imposed, but T-109 found these: v_quant_portfolio expected_return, expected_vol, sharpe; v_quant_benchmark_performance realized_return, cumulative_return, benchmark_return, active_return; v_quant_vs_live active_weight. Not projected: n_positions (a count), rf_annual (an input), turnover (not set by upstream's writer)." ;
    rdfs:domain :BenchmarkObservation ;
    rdfs:range xsd:string .

:quantPortfolio a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The Portfolio the number is about: a BENCHMARK book, or the LIVE book for the performance numbers upstream measured on its live_book snapshot." ;
    rdfs:domain :BenchmarkObservation ;
    rdfs:range :Portfolio .

:ruleSeverity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "HARD | SOFT — the severity upstream's rule_catalog assigns the rule (T-103). An individual veto stint's severity can differ (LEVERAGE_EXTREME emits SOFT for a negative-equity firm with no corroborating metric); :Veto carries the per-stint value as :vetoSeverity (T-102). Distinct from :severity, which is a RiskEvent field." ;
    rdfs:domain :RuleDefinition ;
    rdfs:range xsd:string .

:timestamp a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ObservationSnapshot ;
    rdfs:range xsd:dateTime .

:validTo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Valid-time end. Absent/unbound == currently active. Exclusive on a RuleDefinition (T-187) and on UniverseMembership/PortfolioPosition/AttractivenessWeightScheme; INCLUSIVE on a TickerHistory (T-206), where validFrom <= d <= validTo because v_ticker_history.valid_to is the symbol's last valid date (handoff §3.1)." ;
    rdfs:range xsd:date .

:normalizedScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-153): cohort-relative reading stated.
    # CHANGED (T-171, D17): optional on a FUNDAMENTAL snapshot.
    rdfs:comment "[0.0, 1.0], 0=no risk, 1=critical risk on ScoreSnapshot; sector-aggregate reading on SectorAggregateSnapshot. Range enforced by SHACL. Projected as 1 - x/100 from upstream's normalized_score (50 + 10*z, clamped to [0, 100]), so it is relative to the cohort, not an absolute risk level. Optional (not required, not forbidden) on a FUNDAMENTAL ScoreSnapshot (ScoreFinanciero) since T-171/D17: upstream rewrites this value in place on every cycle that re-normalizes the filing, which would make an individual carrying it a mutable observation. The per-cycle value is read instead as :componentValue on the matching AttractivenessSnapshot's WeightComponent, scoped to its cycle_run." ;
    rdfs:domain :ObservationSnapshot ;
    rdfs:range xsd:decimal .

:portfolioKind a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "LIVE | BENCHMARK, required. Set by which upstream view the book was read from, a fixed mapping and not a judgement: LIVE for the book built from v_portfolio_position (the cycle's selected book), BENCHMARK for optimizer books from v_quant_portfolio. v_quant_portfolio also holds kind='live_book' rows (upstream's snapshot of the live book, taken to measure its return): those are NOT projected as a Portfolio (that would duplicate the live holdings under a BENCHMARK label); their performance numbers attach to the LIVE Portfolio through quantPortfolio (T-109 review). The projection writes the label explicitly; nothing relies on absence." ;
    rdfs:domain :Portfolio ;
    rdfs:range xsd:string .

:provenanceId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "On NewsArticle: 'articles:<id>' / 'discovered_urls:<id>' from the existing SQLite pipeline. On SECFilingSection: an accession-number-based id from the EDGAR batch pipeline." ;
    rdfs:range xsd:string .

:rawValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-171, D17): comment added.
    rdfs:comment "Stable at the source, unlike normalizedScore for some metrics (D17). Carried for SectorRelativeMomentum, Sentiment, and FUNDAMENTAL (ScoreFinanciero, T-171); FUNDAMENTAL's rawValue is bounded to [0, 100] in shapes.ttl (T-177, upstream's answer to Q6)." ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:decimal .

:validFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Valid-time start (06-ontology-definition.md §1.4)." ;
    rdfs:range xsd:date .

:AttractivenessWeightScheme a owl:Class ;
    rdfs:label "Attractiveness Weight Scheme" ;
    rdfs:label "esquema de ponderación del atractivo"@es ;
    skos:definition "Combinación de pesos que respalda attractivenessScore de una instantánea de atractivo, tal como la registró el ejecutor de ciclos del sistema de origen para un solo cycle_run. Se lee del sistema de origen y nunca se aplica aquí. Un esquema por ejecución es una observación, no un esquema válido en el tiempo; el esquema histórico WeightScheme_v1 sí lo es."@es ;
    # CHANGED (T-121): comment rewritten.
    rdfs:comment "The configured blend weights one upstream cycle_run recorded (v_weight_scheme, v_weight_component), one component per score_type. Read, never applied here; the per-asset effective weights are on each AttractivenessSnapshot (:hasEffectiveWeight)." ;
    rdfs:subClassOf :AttractivenessScheme .

:PortfolioPosition a owl:Class ;
    rdfs:label "Portfolio Position" ;
    rdfs:label "posición del portafolio"@es ;
    skos:definition "Relación n-aria: la posición ponderada de un activo dentro de un portafolio durante [validFrom, validTo). Una posición siempre tiene un activo; CASH no es una posición del portafolio: aparece solo como un BookWeightDaily con holdingKey \"CASH\" en el backtest."@es ;
    rdfs:comment "N-ary relation: one Asset's weighted position within one Portfolio over [validFrom, validTo). A position always has an asset; CASH is not a PortfolioPosition: it appears only as a BookWeightDaily with holdingKey \"CASH\" in the backtest." ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/FinancialProductsAndServices/Position> ;
    rdfs:subClassOf :TemporalRelation .

:SECFiling a owl:Class ;
    rdfs:label "SEC Filing" ;
    rdfs:label "documento presentado ante la SEC"@es ;
    skos:definition "Documento individual presentado ante la SEC a través de EDGAR (10-K, 10-Q, 8-K o DEF 14A) para un activo."@es ;
    rdfs:comment "A single document filed with the SEC through EDGAR (10-K, 10-Q, 8-K, DEF 14A) for one Asset." ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/Report> ;
    rdfs:subClassOf :SourceDocument .

:WeightComponent a owl:Class ;
    rdfs:label "Weight Component" ;
    rdfs:label "componente de ponderación"@es ;
    skos:definition "Par (métrica, peso) dentro de un esquema de ponderación del atractivo, configurado por el sistema de origen para una ejecución: uno por score_type (FUNDAMENTAL, VALORIZATION, TECHNICAL y, en ejecuciones antiguas, SEMANTIC). SectorRelativeMomentum no tiene peso en el sistema de origen. :inverted es historia de diseño opcional."@es ;
    # CHANGED (T-121): comment rewritten.
    rdfs:comment "One (metric, weight) pair: a configured weight inside an AttractivenessWeightScheme, or an effective weight on an AttractivenessSnapshot. :inverted survives only on the design-history WeightScheme_v1." ;
    rdfs:subClassOf :AttractivenessScheme .

:AssetCoOccurrence a owl:Class ;
    rdfs:label "Asset Co-occurrence" ;
    rdfs:label "coocurrencia de activos"@es ;
    skos:definition "Vínculo candidato, ponderado y versionado por método, entre dos activos, derivado de su coocurrencia en noticias. Está reificado porque el vínculo transporta método y peso; no es un vínculo verificado de dirección compartida y nunca implica sharedExecutiveWith."@es ;
    rdfs:comment "T-107 (D10): one method-versioned, weighted CANDIDATE link between two assets derived from news co-occurrence (upstream shared_executive_edge, method news-per-cooccurrence-v1; or the media_cooccurrence table once populated). Reified because the link carries method/weight. It is NOT a verified shared directorship and never implies :sharedExecutiveWith." ;
    rdfs:subClassOf :Observation .

:AttractivenessSnapshot a owl:Class ;
    rdfs:label "Attractiveness Snapshot" ;
    rdfs:label "instantánea de atractivo"@es ;
    skos:definition "Resultado inmutable del ranking de atractivo de un activo en un ciclo de selección: su puntuación combinada de atractivo. No es lo contrario de un veto: un activo puede tener ambos, y un veto SOFT resta de la puntuación combinada los penaltyPoints de su regla."@es ;
    rdfs:comment "The Orchestrator's immutable attractiveness ranking result for one Asset in one selection cycle: its combined attractiveness score. It is not the opposite of a Veto: an Asset can have both, and a SOFT veto subtracts its rule's penaltyPoints from the blended score. The class stores the Asset, the score, the computation time and the scheme; v_cycle_ranking also carries rank, selected and status, but they are not modelled here. Closes part of critique #2/evolution layer B3's ranking half (not the position-sizing half). Added 2026-08-13." ;
    rdfs:subClassOf :ObservationSnapshot .

:ObservationSnapshot a owl:Class ;
    rdfs:label "Observation Snapshot" ;
    rdfs:comment "Groups the ScoreSnapshot-shaped individuals: metricType/agentOrigin/timestamp/normalizedScore's shared shape. Added 2026-08-13 (ScoreSnapshot, SectorAggregateSnapshot); AttractivenessSnapshot added 2026-08-23 (§1.2) — it shares the same immutable/timestamped shape even though it's also thematically an Orchestrator decision output like Veto." ;
    rdfs:subClassOf :Observation .

:RuleDefinition a owl:Class ;
    rdfs:label "Rule Definition" ;
    rdfs:label "definición de regla"@es ;
    skos:definition "Regla versionada del catálogo, válida durante [validFrom, validTo): puede ser una regla de selección, cuya activación da lugar a un veto, o una regla de protección diaria GUARD, que no es una regla de veto. Se almacena como datos del grafo, no como código de la aplicación."@es ;
    rdfs:comment "A versioned catalog rule, valid over [validFrom, validTo): either a selection rule, whose firing can raise a veto, or a GUARD protection rule, which is not a veto rule. Stored as graph data, not application code (closes critique #6)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty :hasClause ],
        :RuleSystem .

:ScoreSnapshot a owl:Class ;
    rdfs:label "Score Snapshot" ;
    rdfs:label "instantánea de puntuación"@es ;
    skos:definition "Observación inmutable y con marca de tiempo, registrada por un agente especializado; nunca se actualiza en el mismo individuo."@es ;
    rdfs:comment "Immutable, timestamped observation persisted by one specialist agent (v1 §3A). Never updated in place." ;
    rdfs:subClassOf :ObservationSnapshot .

:agentOrigin a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of FUNDAMENTAL | SEMANTIC | VALORIZATION | TECHNICAL | SECTOR. SHACL sh:in enforced." ;
    rdfs:domain :ObservationSnapshot ;
    rdfs:range xsd:string .

:codeVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "T-106 (D7): upstream git SHA of the code that produced the row ('-dirty' suffix only when upstream ran with --allow-dirty)." ;
    rdfs:range xsd:string .

:engineVersion a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "T-106 (D7): upstream engine_version. Upstream writes parallel rows per engine_version and its v_* views pick the newest per key; this records which one was projected. It is a free string with no defined order: readers must NOT rank by it (docs/07 'Run provenance' gives the read rule)." ;
    rdfs:range xsd:string .

:runAsOf a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "T-106 (D7): the run log's as_of (the date the run was evaluated for). NOT a read filter -- as-of reads use availableAt (T-101). Emit it only where it can differ from eventTime (FUNDAMENTAL, backfill replays); for cycle types it equals eventTime." ;
    rdfs:range xsd:date .

:runId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    # CHANGED (T-151): reuse caveat added to the comment.
    rdfs:comment "T-106 (D7): upstream run_id of the analysis/pricing/quant/cycle run that wrote the row. Upstream's run_id is an INTEGER numbered separately in each run table (analysis_run, pricing_run, quant_run, cycle_run), so a bare number is ambiguous: write it as '<run table>:<id>' (e.g. cycle_run:42; T-109). Joins to the v_analysis_run / v_pricing_run / v_quant_run / v_cycle_run log (params, dirty-tree reason) which stays upstream; no Run class is modelled. T-151: upstream ids can be reused until upstream's T-145 (non-reusable ids) and T-100 (fresh database) have both landed; until then it is emitted only when read checks pass (run row exists, cycle_type matches for cycle_run, row time inside the run), which lowers the risk but does not prove uniqueness." ;
    rdfs:range xsd:string .

:BenchmarkObservation a owl:Class ;
    rdfs:label "Benchmark Observation" ;
    rdfs:label "observación de referencia"@es ;
    skos:definition "Un número terminado que el módulo cuantitativo del sistema de origen calculó sobre un portafolio: una métrica de desempeño de un libro de referencia o un peso activo por activo frente al libro vivo. Se proyecta tal como se recibe, nunca se calcula aquí; los retornos, mu y Sigma no se proyectan."@es ;
    rdfs:comment "T-108 (D11): one finished number that upstream's quant module computed about a Portfolio -- a benchmark book's performance metric (v_quant_benchmark_performance) or a per-asset active weight against the live book (v_quant_vs_live, with quantAsset). Projected as handed over, never computed here; returns, mu and Sigma are not projected." ;
    rdfs:subClassOf :Observation .

:Portfolio a owl:Class ;
    rdfs:label "Portfolio" ;
    rdfs:label "portafolio"@es ;
    skos:definition "El libro de posiciones activas."@es ;
    rdfs:comment "The actively-held book. Closes critique #2 (v1 had exclusion/veto only, no inclusion/holding model)." ;
    rdfs:seeAlso <https://spec.edmcouncil.org/fibo/ontology/FND/OwnershipAndControl/Ownership/Portfolio> ;
    rdfs:subClassOf :Collection .

:DataQualityIssue a owl:Class ;
    rdfs:label "Data Quality Issue" ;
    rdfs:label "problema de calidad de datos"@es ;
    skos:definition "Fuente de evidencia: una activación de una verificación DQ_* de la primera ronda (fila data_quality_issue del sistema de origen, dq-v2) sobre los datos de una declaración de un activo. Una métrica bloqueada se lee como NULL en el sistema de origen. Un problema HARD es el que cita el veto DATA_QUALITY: un evento de riesgo lo respalda o la regla del veto evalúa el predicado HasHardDataQualityIssue sobre él."@es ;
    rdfs:comment "Evidence leaf (T-104): one Ring-1 DQ_* gate firing (upstream's data_quality_issue row, dq-v2) on an asset's filing data. A quarantined gated metric reads as NULL upstream. A HARD issue is what the DATA_QUALITY veto cites: a RiskEvent is backedBy it, or the veto's rule evaluates the HasHardDataQualityIssue predicate over it." ;
    rdfs:subClassOf :EvidenceSource .

:Veto a owl:Class ;
    rdfs:label "Veto" ;
    rdfs:label "veto"@es ;
    skos:definition "Nodo de decisión del orquestador para un activo: qué regla o reglas se activaron y por qué. Desde T-102, un veto es un período (raisedOn..clearedOn, filas de veto del sistema de origen), no un evento de un solo ciclo."@es ;
    rdfs:comment "The orchestrator's decision node for one Asset: which rule(s) fired and why (v1 §4). Since T-102 a Veto is a stint (raisedOn..clearedOn, upstream veto rows), not a single-cycle event." ;
    rdfs:subClassOf :RiskAndDecision .

:metricType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ObservationSnapshot ;
    rdfs:range xsd:string .

:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:label "activo"@es ;
    skos:definition "Línea cotizada del S&P 500 que sigue el sistema, identificada por su símbolo bursátil. Una empresa con varias clases de acciones en el índice tiene un nodo por clase (GOOGL y GOOG, FOXA y FOX, NWSA y NWS); un símbolo reutilizado por otra empresa es un solo nodo, descrito por su uso más reciente (por ejemplo, CEG)."@es ;
    rdfs:comment "A publicly traded S&P 500 constituent tracked by the system (v1 §2A, §3A)." ;
    rdfs:subClassOf :DomainEntity .


#################################################################
# PART 2 -- PROPOSED (NOT on portfolio-knowledge-graph master yet)
#
# What our Work items 12 (T-121) and 15 (T-152..T-156) add once your T-144
# lands. Revised after your reply of 2026-10-06. Names and
# cardinalities may still change in our review; the columns they read
# will not.
#################################################################

# --- T-152: v_fundamental_metric -> FundamentalMetricObservation -------------
# Placed under :Observation by property shape (a value about an asset at a
# date, no normalizedScore), like AssetCoOccurrence/BenchmarkObservation.
# Own date properties on purpose: :eventTime/:availableAt have rdfs:domain
# :ScoreSnapshot, and reusing them would entail a disjoint class.
# Written to urn:graph:ingest:FUNDAMENTAL:{year}-Q{n}. One immutable
# individual per (filing, metric_id, engine_version): a new current
# version is a new individual, never an overwrite. Only rows with
# is_current are read, so a filing with no current row has no
# observation. The filing is resolved to its accession number through
# v_sec_filing in the same read: :SECFiling IRIs are keyed by accession
# number, never by sec_filings.id (reusable).
:FundamentalMetricObservation a owl:Class ;
    rdfs:subClassOf :Observation ;
    rdfs:label "Fundamental Metric Observation" ;
    rdfs:comment "PROPOSED (T-152). One upstream fundamental_metrics value (v_fundamental_metric, is_current rows only) for one filing, e.g. leverage.debt_to_equity or valuation.market_capitalization. Read, never recomputed or converted." .
:metricOfAsset a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range :Asset .
:metricOfFiling a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range :SECFiling .
:fundamentalMetricGroup a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range xsd:string ;
    rdfs:comment "Upstream metric_group verbatim (leverage, cashflow, liquidity, ...)." .
:fundamentalMetricName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range xsd:string ;
    rdfs:comment "Upstream metric_name verbatim, without the group prefix (debt_to_equity)." .
:fundamentalMetricId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range xsd:string ;
    rdfs:comment "Upstream metric_id verbatim (metric_group.metric_name, e.g. leverage.debt_to_equity): the join to v_rule_catalog.param_metric and to ThresholdComparison.metricName in rules.ttl." .
:fundamentalMetricUnit a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range xsd:string ;
    rdfs:comment "Upstream unit verbatim: ratio (a fraction, 0.12 = 12%), x (a multiple), usd (US dollars). Open vocabulary: a new unit upstream documents needs no schema change." .
:fundamentalMetricValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range xsd:decimal ;
    rdfs:comment "Upstream value, in fundamentalMetricUnit. Never converted." .
:metricEventTime a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range xsd:date ;
    rdfs:comment "Upstream event_time (filing period end). Not an as-of filter." .
:metricAvailableAt a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :FundamentalMetricObservation ; rdfs:range xsd:date ;
    rdfs:comment "Upstream available_at. Every as-of-D read filters on this, as for ScoreSnapshot.availableAt." .

:FundamentalMetricObservationShape a sh:NodeShape ;
    sh:targetClass :FundamentalMetricObservation ;
    sh:property [ sh:path :metricOfAsset ; sh:class :Asset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :metricOfFiling ; sh:class :SECFiling ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :fundamentalMetricGroup ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :fundamentalMetricName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :fundamentalMetricId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :fundamentalMetricUnit ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :fundamentalMetricValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :metricAvailableAt ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :metricEventTime ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:lessThanOrEquals :metricAvailableAt ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] .

# --- T-153: v_score_snapshot.prompt_hash / forensic_flags_json -------------
# forensic_flags_json (your T-074) is an object of four booleans. One
# :forensicFlag per key whose value is true; :forensicFlagsEvaluated is
# true when the column is non-NULL. So all four false (evaluated, none
# fired) gives evaluated=true and no flag, and NULL gives neither.
:promptHash a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :ScoreSnapshot ; rdfs:range xsd:string ;
    rdfs:comment "PROPOSED (T-153). Upstream prompt_hash, verbatim. FUNDAMENTAL snapshots only." .
:forensicFlag a owl:DatatypeProperty ; rdfs:domain :ScoreSnapshot ; rdfs:range xsd:string ;
    rdfs:comment "PROPOSED (T-153). One value per key of upstream forensic_flags_json whose value is true. FUNDAMENTAL snapshots only." .
:forensicFlagsEvaluated a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :ScoreSnapshot ; rdfs:range xsd:boolean ;
    rdfs:comment "PROPOSED (T-153). true when upstream forensic_flags_json is non-NULL (the flags were evaluated), whether or not any fired. FUNDAMENTAL snapshots only." .
:ScoreSnapshotFundamentalExtrasShape a sh:NodeShape ;
    sh:targetClass :ScoreSnapshot ;
    sh:property [ sh:path :promptHash ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :forensicFlag ; sh:datatype xsd:string ;
                  sh:in ( "data_error_suspected" "negative_equity_buyback" "value_destroyer_sub_wacc" "severe_sbc_dilution" ) ] ;
    sh:property [ sh:path :forensicFlagsEvaluated ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    # Any of the three only on FUNDAMENTAL.
    sh:or ( [ sh:path :agentOrigin ; sh:hasValue "FUNDAMENTAL" ]
            [ sh:and ( [ sh:path :promptHash ; sh:maxCount 0 ]
                       [ sh:path :forensicFlag ; sh:maxCount 0 ]
                       [ sh:path :forensicFlagsEvaluated ; sh:maxCount 0 ] ) ] ) ;
    # A flag implies the flags were evaluated.
    sh:or ( [ sh:path :forensicFlag ; sh:maxCount 0 ]
            [ sh:path :forensicFlagsEvaluated ; sh:hasValue true ] ) .

# --- T-154: v_shared_executive_edge.computed_at, v_media_cooccurrence_edge --
# coOccurrenceComputedOn (already on master, optional) is filled from
# computed_at (date part; we parse both +00:00 and Z). The kind list widens
# to MEDIA when your v_media_cooccurrence_edge exists (after your T-100);
# written as a separate shape. On master today the sh:in is
# ("SHARED_EXECUTIVE_CANDIDATE") only. first_seen/last_seen stay unread.
:AssetCoOccurrenceKindProposedShape a sh:NodeShape ;
    sh:targetClass :AssetCoOccurrence ;
    sh:property [ sh:path :coOccurrenceKind ; sh:in ( "SHARED_EXECUTIVE_CANDIDATE" "MEDIA" ) ] .

# --- T-155: v_cycle_ranking + v_cycle_ranking_component -> AttractivenessSnapshot
# One individual per (cycle_run_id, asset_id) of a completed, non-REPLAY
# run, in urn:graph:ingest:ORCHESTRATOR:{cycle_date}. attractivenessScore
# = blended_score / 100 (PART 1, CHANGED). A ranking row whose asset has
# no v_cycle_ranking_component row is skipped: its 0.0 is a placeholder
# (confirmed, your third reply, Q1: always vetoed=1/"UNSCORED", no
# dedicated marker beyond the missing rows). Effective weights: one
# :WeightComponent per v_cycle_ranking_component row (effective_weight ->
# weightValue; component_value -> componentValue, below; score_type ->
# weightMetricName as its lane's metricType name, the fixed pairing
# ScoreSnapshotShape uses: FUNDAMENTAL -> ScoreFinanciero, VALORIZATION ->
# ScoreCuantitativo, TECHNICAL -> ScoreTecnico, SEMANTIC -> Sentiment).
# Configured weights use the same names. Still not read: configured_weight
# (it repeats v_weight_component). vetoedAtRanking is true only for a HARD
# veto (with the T-1 lag) or "UNSCORED" (your third reply, Q2) -- never
# for a SOFT veto alone.
:rankPosition a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range xsd:integer ;
    rdfs:comment "PROPOSED (T-155). Upstream rank (1 = best)." .
:selectedForBook a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range xsd:boolean ;
    rdfs:comment "PROPOSED (T-155). Upstream selected." .
:vetoedAtRanking a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range xsd:boolean ;
    rdfs:comment "PROPOSED (T-155). Upstream vetoed: true only for a HARD veto or \"UNSCORED\", never for a SOFT veto alone (your third reply, Q2). The stints themselves are :Veto individuals (v_veto)." .
:targetWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range xsd:decimal ;
    rdfs:comment "PROPOSED (T-155). Upstream target_weight verbatim. A fraction of the book (confirmed, your third reply, Q5); NULL for an unselected row and on a MONITORING run." .
:hasEffectiveWeight a owl:ObjectProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range :WeightComponent ;
    rdfs:comment "PROPOSED (T-155). The weight each component actually had for THIS asset (your per-asset renormalization), read from v_cycle_ranking_component.effective_weight. A component absent for the asset has no entry; the entries of one snapshot sum to 1 (upstream's rule, not recomputed here)." .
:componentValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :WeightComponent ; rdfs:range xsd:decimal ;
    rdfs:comment "PROPOSED (T-155/T-171). v_cycle_ranking_component.component_value verbatim, on an effective-weight WeightComponent only (not on a configured-weight one). Added by your third reply: for FUNDAMENTAL this is NOT a repeat of its ScoreSnapshot's normalizedScore -- that value is rewritten in place by whichever cycle last re-normalized the filing, while this is the value THIS run actually used. 0-100, same cohort-relative scale as normalized_score; the cohort-mean guard (T-162) runs over this column grouped by (cycle_run_id, score_type), not over FUNDAMENTAL ScoreSnapshot rows, which mix cohorts." .
:AttractivenessSnapshotProposedShape a sh:NodeShape ;
    sh:targetClass :AttractivenessSnapshot ;
    sh:property [ sh:path :rankPosition ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :selectedForBook ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path :vetoedAtRanking ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path :targetWeight ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasEffectiveWeight ; sh:class :WeightComponent ; sh:minCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] .
:WeightComponentProposedShape a sh:NodeShape ;
    sh:targetClass :WeightComponent ;
    sh:property [ sh:path :componentValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ; sh:maxCount 1 ] .
# componentValue is only ever written on an effective-weight WeightComponent (reached via
# :hasEffectiveWeight), never a configured-weight one (reached via :hasWeightComponent) -- same class,
# so sh:targetClass above can't tell them apart. sh:targetObjectsOf scopes the mandatory-presence rule to
# just the former: your T-144 keeps component_value in v_cycle_ranking_component regardless of score_type
# (reversed decline, third reply), and T-155 only creates a WeightComponent for a present component ("no
# row for an absent component"), so every effective-weight one always has one to read.
:EffectiveWeightComponentProposedShape a sh:NodeShape ;
    sh:targetObjectsOf :hasEffectiveWeight ;
    sh:property [ sh:path :componentValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ; sh:minCount 1 ; sh:maxCount 1 ] .

# --- T-121: v_weight_scheme / v_weight_component -> AttractivenessWeightScheme
# One scheme per cycle_run: schemeId = "cycle_run:<id>" (PART 1, CHANGED
# comment). DECIDED (T-121, portfolio-knowledge-graph PR #65): a per-run
# scheme is an observation, not a valid-time record. Its date is a new
# :cycleDate (your cycle_date verbatim), not validFrom, and it is never
# closed; the shape takes either validFrom (our design-history
# WeightScheme_v1) or cycleDate with no validTo. The validFrom shape in
# PART 1 is therefore superseded for your schemes. Your scheme_id is the book-weighting
# rule and gets its own property, beside the scalar knobs. New runs carry
# three components (1/3 each), older runs four (0.4/0.3/0.2/0.1).
:bookWeightingRule a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessWeightScheme ; rdfs:range xsd:string ;
    rdfs:comment "PROPOSED (T-121). Upstream v_weight_scheme.scheme_id verbatim: the rule that turns the ranking into book weights (score_proportional, score_tilt). Open vocabulary." .
:topN a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessWeightScheme ; rdfs:range xsd:integer ;
    rdfs:comment "PROPOSED (T-121). Upstream top_n." .
:maxNameWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessWeightScheme ; rdfs:range xsd:decimal ;
    rdfs:comment "PROPOSED (T-121). Upstream max_name_weight verbatim. Assumed a fraction of the book (hence [0, 1]) until upstream states its unit." .
:maxSectorWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessWeightScheme ; rdfs:range xsd:decimal ;
    rdfs:comment "PROPOSED (T-121). Upstream max_sector_weight verbatim. Assumed a fraction of the book (hence [0, 1]) until upstream states its unit." .
:softVetoPenalty a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessWeightScheme ; rdfs:range xsd:decimal ;
    rdfs:comment "PROPOSED (T-121). Upstream soft_veto_penalty, in blended_score points (15 by default), verbatim; charged once per active SOFT stint whose rule declares no :penaltyPoints, a HARD rule's SOFT stint included (our assumption, not yet confirmed: T-189)." .
:AttractivenessWeightSchemeProposedShape a sh:NodeShape ;
    sh:targetClass :AttractivenessWeightScheme ;
    sh:property [ sh:path :bookWeightingRule ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :topN ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :maxNameWeight ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :maxSectorWeight ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :softVetoPenalty ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] .


#################################################################
# PART 3 -- CONTRACT v18 (T-206, 2026-11-01)
#
# The m015/m016/m018 classes, properties and SHACL shapes, mirrored
# from portfolio-knowledge-graph's schema/tbox.ttl and shapes.ttl.
# PROPOSED to upstream: the eight m018 views are read-only here, so
# these terms describe what our projection will write, not a change
# requested from portfolio-financial-analysis. No FIBO seeAlso
# (FIBO_INTEGRATION_BRIEF.md §2/§4.1: FIBO has no class for backtest
# runs, strategy arms, GUARD rules, Sharpe, drawdown, turnover, costs
# or paired tests). Spanish labels/definitions are handoff §6.2.
#################################################################

# 1.0 CONTRACT v18 CLASSES (T-206, 2026-11-01) — one class per
# view added between v12 and v18. Backbone placement is in section
# 1.2 below, by property shape. Spanish labels/definitions are the
# approved handoff §6.2 text verbatim (outer « » delimiters dropped).
# No rdfs:seeAlso to FIBO: handoff §6.1 says FIBO has no class for
# backtest runs, strategy arms, GUARD rules, Sharpe, drawdown,
# turnover, costs or paired statistical tests. Every m018 class
# carries :knowledgeDate (section 3) so knowledgeDate <= D queries
# work uniformly; the m015/m016 classes do not (their views have no
# knowledge_date column).
#################################################################

:TickerHistory
    a owl:Class ;
    rdfs:label "Ticker History" ;
    rdfs:label "historial de símbolo bursátil"@es ;
    skos:definition "Registro histórico de cada símbolo bursátil (ticker) utilizado por una línea de emisor (identificada por su CIK en la SEC) durante un intervalo [validFrom, validTo]. Permite resolver el símbolo vigente en cada fecha histórica."@es ;
    rdfs:comment "One row of v_ticker_history (m016): a point-in-time symbol for one CIK line over the INCLUSIVE interval [validFrom, validTo]. validTo absent means the current symbol. The optional :tickerHistoryAsset link is v_ticker_history.asset_id (LEFT JOIN on canonical_symbol); :evidenceUrl/:evidenceDate are optional here because the v18 shape contract keeps them optional even though the m016 DDL marks them NOT NULL." .

:OrchestratorRun
    a owl:Class ;
    rdfs:label "Orchestrator Run" ;
    rdfs:label "ejecución del orquestador"@es ;
    skos:definition "Registro de una corrida del orquestador del sistema (pipeline completo o comando individual), con su identificador de seguimiento (handle), fecha de corte (as_of), estado y configuración."@es ;
    rdfs:comment "One row of v_orchestrator_run (m015): a pipeline or single-command run with its handle, as_of, status, surface and settings. Immutable dated process record (Observation), not a metric snapshot; no knowledgeDate because the view has none. The view has 0 rows in the completed backtest databases, so its shape is exercised by synthetic cases only." .

:OrchestratorStep
    a owl:Class ;
    rdfs:label "Orchestrator Step" ;
    rdfs:label "paso de ejecución del orquestador"@es ;
    skos:definition "Paso individual ejecutado dentro de una corrida del orquestador, con su orden, estado, tiempos de inicio y fin, código de salida y referencia al registro de corrida del subsistema correspondiente."@es ;
    rdfs:comment "One row of v_orchestrator_step (m015): one step of an OrchestratorRun, keyed by (orchestrator_run_id, ordinal). Links to its run by :stepOfOrchestratorRun; :runId (when present) is the step's own run-log id written '<run table>:<id>' from run_kind. The view has 0 rows in the completed backtest databases, so its shape is exercised by synthetic cases only." .

:StrategyBook
    a owl:Class ;
    rdfs:label "Strategy Book" ;
    rdfs:label "libro de estrategia de backtest"@es ;
    skos:definition "Brazo experimental de una corrida de backtest en una ventana histórica (P1, P2 o P3): MARKOWITZ_BASE (optimización de mínima varianza sobre todo el universo elegible sin selección de ciclo), TOPN_MV_NOGUARD (selección Top-30 del ciclo + mínima varianza sin GUARD) o TOPN_MV_GUARD_NO_NLP (selección Top-30 + mínima varianza con protección diaria GUARD activa)."@es ;
    rdfs:comment "One row of v_book (m018): an experimental arm of one backtest run (the name :StrategyBook, not :BacktestBook). A named pool of holdings, so a Collection like Portfolio. The backtest run itself has no class (no v_backtest_run view); :backtestRunId is the literal link to it. :guardLayers is optional and :excludeHardVetoed is a boolean with no per-arm constraint (see their comments)." .

:BookRebalance
    a owl:Class ;
    rdfs:label "Book Rebalance" ;
    rdfs:label "rebalanceo programado del libro"@es ;
    skos:definition "Rebalanceo periódico de un libro de estrategia (cada 21 sesiones de NYSE): vincula la fecha de decisión (cierre de t-1) y la fecha de ejecución (cierre de t) con el portafolio de Markowitz, el modelo de riesgo y la corrida de selección del ciclo."@es ;
    rdfs:comment "One row of v_book_rebalance (m018): a scheduled rebalance of one StrategyBook every 21 NYSE sessions. A dated n-ary relation (book, decision/execution dates, upstream quant/cycle/risk-model ids), so a TemporalRelation. :cycleRunId is optional (NULL on MARKOWITZ_BASE); the three upstream ids are literals, not nodes in this graph." .

:GuardAlert
    a owl:Class ;
    rdfs:label "Guard Alert" ;
    rdfs:label "alerta diaria de GUARD"@es ;
    skos:definition "Alerta de riesgo generada al cierre de una sesión por las capas de protección diaria GUARD: corte individual por pérdida acumulada (capa 1, L1_STOP_LOSS / L1_REENTRY), volatilidad ex-ante del portafolio (capa 3, L3_VOL) o caída acumulada desde el máximo (capa 4, L4_DD)."@es ;
    rdfs:comment "One row of v_guard_alert (m018): a GUARD layer's daily alert, with :alertRule pointing at its GUARD RuleDefinition. A dated measurement (value/threshold/state), so an Observation. :guardAsset and :guardTicker are optional (NULL on layers 3 and 4); :alertValue is optional (NULL on layer 1); :alertThreshold and :alertState are always populated. The view has no book_id: an alert reaches a book through its :alertHasGuardAction actions, never a direct alert-to-book property." .

:GuardAction
    a owl:Class ;
    rdfs:label "Guard Action" ;
    rdfs:label "acción de GUARD sobre un libro"@es ;
    skos:definition "Evaluación y efecto de una alerta de GUARD sobre un libro de estrategia para la sesión siguiente (effective_date): APPLIED (aplicada), ARM_DISABLED (registrada como contrafactual en el brazo sin GUARD), NOT_HELD (activo no mantenido en cartera) o SUPERSEDED."@es ;
    rdfs:comment "One row of v_guard_action (m018): the effect of a GuardAlert on one StrategyBook for the next session. A decision/action record, so a RiskAndDecision leaf. :guardAsset/:guardTicker and :weightBefore/:weightAfter are optional (NULL on layer 1 asset actions and on NOT_HELD); :actionAlert and :actionOfBook are required." .

:BookWeightDaily
    a owl:Class ;
    rdfs:label "Book Weight Daily" ;
    rdfs:label "peso de tenencia en el libro"@es ;
    skos:definition "Peso objetivo de un activo o de la posición en efectivo (CASH) dentro de un libro de estrategia en sus fechas de decisión y ejecución (peso objetivo de Markowitz y peso objetivo final tras GUARD)."@es ;
    rdfs:comment "One row of v_book_weight_daily (m018): one holding's weight in one StrategyBook on one date, keyed by (book, date, holding_key). A dated measurement, so an Observation. A holding_key 'CASH' row has no :holdingAsset and must not require an Asset node; :holdingName and both target weights are optional (NULL on ordinary sessions, where the view masks them)." .

:BookDailyPerformance
    a owl:Class ;
    rdfs:label "Book Daily Performance" ;
    rdfs:label "desempeño diario del libro"@es ;
    skos:definition "Serie diaria a nivel de portafolio de un libro de estrategia: retorno bruto, rotación (turnover), costo de transacción (10 bps), retorno neto, valor liquidativo (NAV), caída desde el máximo (drawdown), peso en efectivo, número de acciones y retorno del índice equiponderado interno (SP500_EW_INTERNAL)."@es ;
    rdfs:comment "One row of v_book_daily_performance (m018): one StrategyBook's portfolio-level daily series, keyed by (book, date). A dated measurement, so an Observation. :benchmarkReturn is optional (NULL upstream). No sign or range constraint is placed on :drawdown or :costReturn: the handoff states no sign convention, even though the three completed databases hold non-negative magnitudes." .

:PortfolioPeriodSummary
    a owl:Class ;
    rdfs:label "Portfolio Period Summary" ;
    rdfs:label "resumen de desempeño por período"@es ;
    skos:definition "Estadísticas consolidadas de un libro de estrategia en una ventana o subperíodo de backtest (P1, P2, P2a, P2b, P3): retorno acumulado y anualizado, volatilidad anualizada, ratio de Sharpe ex-post sobre la tasa libre de riesgo diaria (FF_RF_DAILY), máximo drawdown, rotación total, costo total en puntos básicos, número de rebalanceos y número de acciones de GUARD."@es ;
    rdfs:comment "One row of v_portfolio_period_summary (m018): consolidated statistics of one StrategyBook over one segment (P1, P2, P2a, P2b, P3), keyed by (book, segment). A derived observation. No sign or range constraint is placed on :maxDrawdown (the handoff states no sign convention)." .

:BacktestTest
    a owl:Class ;
    rdfs:label "Backtest Test" ;
    rdfs:label "prueba estadística pareada de backtest"@es ;
    skos:definition "Resultado de una prueba de hipótesis pareada entre dos brazos de estrategia en un segmento (Jobson-Korkie con corrección de Memmel, bootstrap en bloques de Ledoit-Wolf para el ratio de Sharpe y diferencia de medias diarias con errores estándar HAC de Newey-West): estadístico, valor p y número de sesiones."@es ;
    rdfs:comment "One row of v_backtest_test (m018): a paired hypothesis test between two strategy arms in one segment, keyed by (backtest_run_id, segment, arm_a, arm_b, test). A derived observation. :armA/:armB use the same arm vocabulary as :armCode; :testName is memmel_jk | ledoit_wolf | hac_mean_diff. No BacktestRun class: :backtestRunId is the literal link." .

#################################################################

# T-206 (Contract v18): the 11 new classes, placed by property shape, not theme.
# - TickerHistory and BookRebalance are dated n-ary relations carrying data (a symbol interval;
#   a book x decision/execution date x upstream ids), so TemporalRelation, like UniverseMembership.
# - StrategyBook is a named pool of holdings, so Collection, like Portfolio.
# - OrchestratorRun/Step, GuardAlert, BookWeightDaily, BookDailyPerformance,
#   PortfolioPeriodSummary and BacktestTest are immutable dated records with scalar fields and no
#   valid-time interval, so Observation, like PriceObservation/BenchmarkObservation. OrchestratorRun
#   and OrchestratorStep are process provenance, not metric snapshots, which is why they are plain
#   Observation and not ObservationSnapshot.
# - GuardAction is the effect/decision taken on a book for the next session, not a measurement,
#   so RiskAndDecision, beside RiskEvent/Veto.
:TickerHistory rdfs:subClassOf :TemporalRelation .
:BookRebalance rdfs:subClassOf :TemporalRelation .
:StrategyBook rdfs:subClassOf :Collection .
:OrchestratorRun rdfs:subClassOf :Observation .
:OrchestratorStep rdfs:subClassOf :Observation .
:GuardAlert rdfs:subClassOf :Observation .
:GuardAction rdfs:subClassOf :RiskAndDecision .
:BookWeightDaily rdfs:subClassOf :Observation .
:BookDailyPerformance rdfs:subClassOf :Observation .
:PortfolioPeriodSummary rdfs:subClassOf :Observation .
:BacktestTest rdfs:subClassOf :Observation .

#################################################################

# 2.1 CONTRACT v18 OBJECT PROPERTIES (T-206, 2026-11-01)
#
# The m018 links between new classes. Functional only where the data
# guarantees one value: a step has one run, a rebalance one book, an
# action one book and one alert, a weight/performance/summary row one
# book, a ticker-history row at most one asset. The inverse is
# declared only where a reader would traverse the other way.
#
# There is no BacktestRun class (no v_backtest_run view; the run log
# stays upstream, as T-106 decided), so a book or a test links to its
# run by the literal :backtestRunId, never by an invented node.
# v_guard_alert has no book_id, so an alert reaches a book through
# its :alertHasGuardAction actions; there is deliberately no direct
# alert-to-book property.
#################################################################

:stepOfOrchestratorRun a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorStep ; rdfs:range :OrchestratorRun ;
    owl:inverseOf :orchestratorRunHasStep ;
    rdfs:comment "v_orchestrator_step.orchestrator_run_id, resolved to the OrchestratorRun individual. A step belongs to exactly one run." .
:orchestratorRunHasStep a owl:ObjectProperty ; rdfs:domain :OrchestratorRun ; rdfs:range :OrchestratorStep .

:tickerHistoryAsset a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :TickerHistory ; rdfs:range :Asset ;
    owl:inverseOf :assetTickerHistory ;
    rdfs:comment "Optional: v_ticker_history.asset_id (LEFT JOIN on canonical_symbol). A history row is for one CIK line, so at most one asset; a row with no matching asset simply has no link." .
:assetTickerHistory a owl:ObjectProperty ; rdfs:domain :Asset ; rdfs:range :TickerHistory .

:rebalanceOfBook a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :BookRebalance ; rdfs:range :StrategyBook ;
    owl:inverseOf :bookHasRebalance .
:bookHasRebalance a owl:ObjectProperty ; rdfs:domain :StrategyBook ; rdfs:range :BookRebalance .

:actionOfBook a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :GuardAction ; rdfs:range :StrategyBook ;
    owl:inverseOf :bookHasGuardAction .
:bookHasGuardAction a owl:ObjectProperty ; rdfs:domain :StrategyBook ; rdfs:range :GuardAction .

:actionAlert a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :GuardAction ; rdfs:range :GuardAlert ;
    owl:inverseOf :alertHasGuardAction ;
    rdfs:comment "v_guard_action.alert_id: the alert this action evaluates. An alert can have several actions (one per book), so the inverse is not functional." .
:alertHasGuardAction a owl:ObjectProperty ; rdfs:domain :GuardAlert ; rdfs:range :GuardAction .

:alertRule a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :GuardAlert ; rdfs:range :RuleDefinition ;
    rdfs:comment "v_guard_alert.rule_id, resolved to the GUARD RuleDefinition (L1_STOP_LOSS, L1_REENTRY, L2_NEWS, L3_VOL or L4_DD). This is the only way a GUARD rule is reached from an alert; it is not a Veto :appliesRule/:primaryRule target (VetoShape refuses category GUARD)." .

:guardAsset a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:range :Asset ;
    rdfs:comment "Optional on GuardAlert and GuardAction. No rdfs:domain so the two classes can share it without entailing each other (the :runId pattern). NULL on layer 3/4 portfolio-level alerts/actions; a CASH weight row uses no asset link at all." .

:weightOfBook a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :BookWeightDaily ; rdfs:range :StrategyBook ;
    owl:inverseOf :bookHasWeight .
:bookHasWeight a owl:ObjectProperty ; rdfs:domain :StrategyBook ; rdfs:range :BookWeightDaily .
:holdingAsset a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :BookWeightDaily ; rdfs:range :Asset ;
    rdfs:comment "Optional: v_book_weight_daily.asset_id. A holding_key 'CASH' row has no asset link and must not require an Asset node." .

:performanceOfBook a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range :StrategyBook ;
    owl:inverseOf :bookHasPerformance .
:bookHasPerformance a owl:ObjectProperty ; rdfs:domain :StrategyBook ; rdfs:range :BookDailyPerformance .

:summaryOfBook a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range :StrategyBook ;
    owl:inverseOf :bookHasSummary .
:bookHasSummary a owl:ObjectProperty ; rdfs:domain :StrategyBook ; rdfs:range :PortfolioPeriodSummary .

#################################################################

# 3.1 CONTRACT v18 DATATYPE PROPERTIES (T-206, 2026-11-01)
#
# Properties shared across classes have NO rdfs:domain, the :runId
# pattern (T-106): a domain would RDFS-entail one new class on an
# individual of another and clash with AllDisjointClasses. The
# shared ones are :bookId, :backtestRunId, :armCode, :windowId,
# :runLabel, :knowledgeDate, :status, :decisionDate, :guardTicker, :guardLayer,
# :segment, :handle, :startedAt, :finishedAt and :runKind. Per-class
# fields carry a domain.
#
# Nullability follows the m015/m016/m018 DDL and the handoff §3.3:
# only columns the views guarantee non-null are required in SHACL
# (shapes.ttl). :drawdown, :costReturn and :maxDrawdown have no sign
# or range constraint because the handoff states no sign convention.
#################################################################

# --- shared across the m018 views (no rdfs:domain) ---
:bookId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:comment "v_book.book_id and the book_id of the five other m018 views that carry it. No rdfs:domain: shared across StrategyBook, BookRebalance, GuardAction, BookWeightDaily, BookDailyPerformance and PortfolioPeriodSummary." .
:backtestRunId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:comment "v_*.backtest_run_id. No rdfs:domain: shared across all eight m018 classes. There is no BacktestRun class (no v_backtest_run view), so this literal is the link from a book or a test to its run." .
:armCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "MARKOWITZ_BASE | TOPN_MV_NOGUARD | TOPN_MV_GUARD_NO_NLP | TOPN_MV_GUARD. No rdfs:domain: shared across StrategyBook, BookRebalance, GuardAction, BookWeightDaily, BookDailyPerformance and PortfolioPeriodSummary. SHACL sh:in." .
:windowId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "P<number> (P1, P2, P3, …; T-234 opened the vocabulary). No rdfs:domain: shared across StrategyBook, GuardAlert, BookDailyPerformance, PortfolioPeriodSummary and BacktestTest. SHACL sh:pattern ^P[0-9]+$." .
:knowledgeDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:date ;
    rdfs:comment "The date the m018 row became known (v_* knowledge_date, the view's own date or the run's created_at date). No rdfs:domain: every m018 individual carries it, so a knowledgeDate <= D query works uniformly (handoff checklist 3). It is not valid time and not a replacement for :knowledgeDate-less m015/m016 rows." .
:status a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "No rdfs:domain: shared by OrchestratorRun/OrchestratorStep, BookRebalance and GuardAction, whose vocabularies differ. Open per class; GuardActionShape closes its values to APPLIED | ARM_DISABLED | NOT_HELD | SUPERSEDED." .
:decisionDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:date ;
    rdfs:comment "The session close at which the decision was made. No rdfs:domain: shared by BookRebalance (the close before execution_date) and GuardAction (the alert's session)." .
:guardTicker a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "Optional on GuardAlert and GuardAction (v_*.ticker). No rdfs:domain, so the two classes share it without entailment. NULL on layers 3/4." .
:guardLayer a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:comment "T-206: 1..4, the GUARD protection layer. No rdfs:domain: it is the alert's v_guard_alert.layer and the GUARD RuleDefinition's layer. SHACL bounds it to 1..4 on both." .
:segment a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "P<number> plus an optional lowercase sub-period suffix (P1, P2, P2a, P2b, P3, …; T-234 opened the vocabulary). No rdfs:domain: shared by PortfolioPeriodSummary and BacktestTest. SHACL sh:pattern ^P[0-9]+[a-z]?$." .
:runLabel a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "The operator's name for one backtest result family (--db LABEL=PATH; T-233). [a-z][a-z0-9_]{1,31}. No rdfs:domain: StrategyBook and BacktestTest share it, the two m018 classes with no book link. SHACL sh:pattern, the same one the CLI and the graph name enforce." .
:handle a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "v_orchestrator_run.handle, the uuid4 the run endpoints return; repeated on v_orchestrator_step from the joined run. No rdfs:domain." .
:startedAt a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:dateTime ;
    rdfs:comment "Start time. No rdfs:domain: OrchestratorRun and OrchestratorStep share it. Optional on a step (the DDL allows NULL)." .
:finishedAt a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:dateTime ;
    rdfs:comment "Finish time, optional. No rdfs:domain: OrchestratorRun and OrchestratorStep share it." .
:runKind a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:comment "OrchestratorRun.kind (pipeline | pricing-agent | ...) and OrchestratorStep.run_kind (pricing | analysis | cycle | quant). Open vocabulary. No rdfs:domain." .

# --- OrchestratorRun / OrchestratorStep ---
:orchestratorRunId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorRun ; rdfs:range xsd:integer ;
    rdfs:comment "v_orchestrator_run.run_id (orchestrator_run.id). The run's natural key." .
:settingsJson a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorRun ; rdfs:range xsd:string ;
    rdfs:comment "v_orchestrator_run.settings_json, the JSON object of the given settings, or absent when NULL. Optional." .
:surface a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorRun ; rdfs:range xsd:string ;
    rdfs:comment "v_orchestrator_run.surface ('http' | 'cli' in the DDL; open)." .
:stepName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorStep ; rdfs:range xsd:string ;
    rdfs:comment "v_orchestrator_step.step, the T-011 step name." .
:ordinal a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorStep ; rdfs:range xsd:integer ;
    rdfs:comment "1-based position of the step in its run; part of the (orchestrator_run_id, ordinal) natural key." .
:argvJson a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorStep ; rdfs:range xsd:string ;
    rdfs:comment "v_orchestrator_step.argv_json: a JSON array without the interpreter path." .
:exitCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorStep ; rdfs:range xsd:integer ;
    rdfs:comment "Optional: v_orchestrator_step.exit_code, absent when NULL." .
:reason a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorStep ; rdfs:range xsd:string ;
    rdfs:comment "Optional: v_orchestrator_step.reason." .
:outputTail a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :OrchestratorStep ; rdfs:range xsd:string ;
    rdfs:comment "Optional: v_orchestrator_step.output_tail, a JSON array of the last 40 lines." .

# --- TickerHistory ---
:tickerHistoryCik a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :TickerHistory ; rdfs:range xsd:string ;
    rdfs:comment "v_ticker_history.cik. Named distinctly from :cikNumber (whose rdfs:domain is Asset) so a TickerHistory is not entailed to be an Asset." .
:historicalSymbol a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :TickerHistory ; rdfs:range xsd:string ;
    rdfs:comment "v_ticker_history.symbol: the symbol in use over the inclusive interval [validFrom, validTo]." .
:canonicalSymbol a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :TickerHistory ; rdfs:range xsd:string ;
    rdfs:comment "v_ticker_history.canonical_symbol: the CIK line's current ticker, the one every other view shows." .
:evidenceUrl a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :TickerHistory ; rdfs:range xsd:anyURI ;
    rdfs:comment "Optional: v_ticker_history.evidence_url. The m016 DDL marks it NOT NULL, but the task's v18 shape contract keeps it optional (the expectation file dropped its non-null rule after the P1/P2/P3 check)." .
:evidenceDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :TickerHistory ; rdfs:range xsd:date ;
    rdfs:comment "Optional: v_ticker_history.evidence_date, for the same reason as :evidenceUrl." .
:tickerHistoryRules a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :TickerHistory ; rdfs:range xsd:string ;
    rdfs:comment "Optional: v_ticker_history.rules (e.g. 'L-11;APP-10a'), a provenance tag read verbatim and never parsed." .

# --- StrategyBook ---
:runStatus a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :StrategyBook ; rdfs:range xsd:string ;
    rdfs:comment "v_book.run_status = backtest_run.status (running | completed | failed in the DDL; open). Distinct from :status." .
:objective a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :StrategyBook ; rdfs:range xsd:string ;
    rdfs:comment "v_book.objective, upstream's strategy_book.objective ('min_var' in the three backtest databases; 'equal_weight' is the benchmark in the DDL). Open, read verbatim." .
:excludeHardVetoed a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :StrategyBook ; rdfs:range xsd:boolean ;
    rdfs:comment "v_book.exclude_hard_vetoed, upstream INTEGER 0/1 projected as false/true. The DDL comment says 0 on MARKOWITZ_BASE and 1 on TOPN_MV_*; the completed P1/P2/P3 databases hold 0 on all three arms, so the shape requires only a boolean and does NOT constrain it per arm (data over DDL comment)." .
:guardLayers a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :StrategyBook ; rdfs:range xsd:string ;
    rdfs:comment "v_book.guard_layers, the JSON list text verbatim. Optional: the DDL comment says '[]' on BASE/NOGUARD, but the completed P1/P2/P3 databases hold NULL there and '[1, 3, 4]' on TOPN_MV_GUARD_NO_NLP, so the shape does not require it and never parses it." .
:backtestStartDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :StrategyBook ; rdfs:range xsd:date ;
    rdfs:comment "v_book.d_start (backtest_run.d_start)." .
:backtestEndDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :StrategyBook ; rdfs:range xsd:date ;
    rdfs:comment "v_book.d_end (backtest_run.d_end)." .
:formationDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :StrategyBook ; rdfs:range xsd:date ;
    rdfs:comment "Optional: v_book.formation_date, the first execution whose cycle selection succeeded; NULL until then." .

# --- BookRebalance ---
:rebalanceId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookRebalance ; rdfs:range xsd:integer ;
    rdfs:comment "v_book_rebalance.rebalance_id (book_rebalance.id)." .
:executionDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookRebalance ; rdfs:range xsd:date ;
    rdfs:comment "v_book_rebalance.execution_date: the NYSE session E_k = D1 + 21*k, one session after decision_date." .
:quantPortfolioId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookRebalance ; rdfs:range xsd:integer ;
    rdfs:comment "Optional: v_book_rebalance.quant_portfolio_id, an upstream id. It is a literal, not a :Portfolio node: no v_quant_portfolio individual is minted by this class." .
:cycleRunId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Upstream cycle_run id. No rdfs:domain: shared by BookRebalance, SelectionCycle and AttractivenessWeightScheme." ;
    rdfs:comment "Optional: v_book_rebalance.cycle_run_id. Always NULL on MARKOWITZ_BASE (no cycle Top-30 selection); an upstream id literal, not a node." .
:riskModelId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookRebalance ; rdfs:range xsd:integer ;
    rdfs:comment "Optional: v_book_rebalance.risk_model_id, an upstream id literal, not a node." .

# --- GuardAlert ---
:alertId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAlert ; rdfs:range xsd:integer ;
    rdfs:comment "v_guard_alert.alert_id (guard_alert.id)." .
:alertDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAlert ; rdfs:range xsd:date ;
    rdfs:comment "v_guard_alert.date, the session close the alert was raised at." .
:alertValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAlert ; rdfs:range xsd:decimal ;
    rdfs:comment "Optional: v_guard_alert.value. Always NULL on layer 1 (the asset's return is masked under the Tiingo non-redistribution rule); :alertThreshold and :alertState are always populated." .
:alertThreshold a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAlert ; rdfs:range xsd:decimal ;
    rdfs:comment "v_guard_alert.threshold; always populated (handoff §3.3)." .
:alertState a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAlert ; rdfs:range xsd:string ;
    rdfs:comment "v_guard_alert.state: ENTER | EXIT | ACTIVE | COOLDOWN | SCALE. SHACL sh:in." .

# --- GuardAction ---
:actionId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAction ; rdfs:range xsd:integer ;
    rdfs:comment "v_guard_action.action_id (guard_action.id)." .
:effectiveDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAction ; rdfs:range xsd:date ;
    rdfs:comment "v_guard_action.effective_date: the session the target applies to (t+1)." .
:weightBefore a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAction ; rdfs:range xsd:decimal ;
    rdfs:comment "Optional: v_guard_action.weight_before. NULL on layer 1 asset actions (masked) and on NOT_HELD; portfolio-level L3/L4 scale factors keep it." .
:weightAfter a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :GuardAction ; rdfs:range xsd:decimal ;
    rdfs:comment "Optional: v_guard_action.weight_after, the same nullability as :weightBefore." .

# --- BookWeightDaily ---
:weightDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookWeightDaily ; rdfs:range xsd:date ;
    rdfs:comment "v_book_weight_daily.date." .
:holdingKey a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookWeightDaily ; rdfs:range xsd:string ;
    rdfs:comment "v_book_weight_daily.holding_key: a ticker, or 'CASH' for the cash position. A CASH row has no :holdingAsset and must not require an Asset node." .
:holdingName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookWeightDaily ; rdfs:range xsd:string ;
    rdfs:comment "Optional: v_book_weight_daily.holding_name; NULL when holding_key = 'CASH'." .
:markowitzTargetWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookWeightDaily ; rdfs:range xsd:decimal ;
    rdfs:comment "Optional: v_book_weight_daily.markowitz_target_weight; NULL on ordinary sessions (only decision/execution dates expose targets)." .
:finalTargetWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookWeightDaily ; rdfs:range xsd:decimal ;
    rdfs:comment "Optional: v_book_weight_daily.final_target_weight; the same ordinary-session masking as :markowitzTargetWeight." .

# --- BookDailyPerformance ---
:performanceDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:date ;
    rdfs:comment "v_book_daily_performance.date." .
:grossReturn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal .
:turnover a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal .
:costReturn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal ;
    rdfs:comment "v_book_daily_performance.cost_return. No sign or range constraint: the handoff states no sign convention." .
:netReturn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal .
:nav a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal .
:drawdown a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal ;
    rdfs:comment "v_book_daily_performance.drawdown. No sign or range constraint: the handoff states no sign convention, even though P1/P2/P3 hold non-negative magnitudes (0 to 0.2492)." .
:cashWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal .
:nEquity a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:integer .
:benchmarkReturn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BookDailyPerformance ; rdfs:range xsd:decimal ;
    rdfs:comment "Optional: v_book_daily_performance.benchmark_return (SP500_EW_INTERNAL equal-weight total return); NULL upstream." .

# --- PortfolioPeriodSummary ---
:dateFrom a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:date .
:dateTo a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:date .
:cumulativeReturn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:decimal .
:annualizedReturn a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:decimal .
:annualizedVol a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:decimal .
:exPostSharpe a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:decimal .
:maxDrawdown a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:decimal ;
    rdfs:comment "v_portfolio_period_summary.max_drawdown. No sign or range constraint: the handoff states no sign convention." .
:totalTurnover a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:decimal .
:totalCostBps a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:decimal .
:nRebalances a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:integer .
:nGuardActions a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :PortfolioPeriodSummary ; rdfs:range xsd:integer .

# --- BacktestTest ---
:armA a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BacktestTest ; rdfs:range xsd:string ;
    rdfs:comment "v_backtest_test.arm_a, the same four-value arm vocabulary as :armCode. SHACL sh:in." .
:armB a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BacktestTest ; rdfs:range xsd:string ;
    rdfs:comment "v_backtest_test.arm_b. SHACL sh:in." .
:testName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BacktestTest ; rdfs:range xsd:string ;
    rdfs:comment "v_backtest_test.test: memmel_jk | ledoit_wolf | hac_mean_diff. SHACL sh:in." .
:statistic a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BacktestTest ; rdfs:range xsd:decimal .
:pValue a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BacktestTest ; rdfs:range xsd:decimal .
:nObs a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BacktestTest ; rdfs:range xsd:integer .
:paramsJson a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :BacktestTest ; rdfs:range xsd:string ;
    rdfs:comment "Optional: v_backtest_test.params_json." .

#################################################################

# CONTRACT v18 SHAPES (T-206, 2026-11-01)
#
# One NodeShape per new class. Required (minCount 1) only what the
# view guarantees non-null; the handoff §3.3 nullable columns are
# optional and must never be required. Closed vocabularies use sh:in
# where the handoff enumerates the values; where a vocabulary may
# grow upstream it stays open and says so in a comment (the
# :scoreMethod pattern). No sign or range constraint is placed on
# :drawdown, :costReturn or :maxDrawdown: the handoff states no sign
# convention, even though the three completed databases hold
# non-negative magnitudes.
#################################################################

:TickerHistoryShape
    a sh:NodeShape ;
    sh:targetClass :TickerHistory ;
    sh:property [ sh:path :tickerHistoryCik ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :historicalSymbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :canonicalSymbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # validTo is INCLUSIVE and optional (NULL = current symbol): v_ticker_history.valid_to is the
    # symbol's last valid date (handoff §3.1), so validFrom <= validTo when present. This differs
    # from RuleDefinition's exclusive validTo (T-187).
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:lessThanOrEquals :validTo ] ;
    sh:property [ sh:path :validTo ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    # Optional: the LEFT JOIN can leave no asset; evidence_url/evidence_date are optional per the
    # v18 shape contract even though the m016 DDL marks them NOT NULL.
    sh:property [ sh:path :tickerHistoryAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :evidenceUrl ; sh:datatype xsd:anyURI ; sh:maxCount 1 ] ;
    sh:property [ sh:path :evidenceDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :tickerHistoryRules ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:OrchestratorRunShape
    a sh:NodeShape ;
    sh:targetClass :OrchestratorRun ;
    # Only the natural key is required: the handoff §3.1 gives the view SQL but not the base table's
    # NOT NULL constraints, and both orchestrator views have 0 rows in P1/P2/P3. Every other property
    # is optional with its datatype and maxCount 1.
    sh:property [ sh:path :orchestratorRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :handle ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runKind ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :surface ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :startedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finishedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :settingsJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:OrchestratorStepShape
    a sh:NodeShape ;
    sh:targetClass :OrchestratorStep ;
    # Only the natural key is required, for the same reason as OrchestratorRunShape: handoff §3.1 has
    # no base-table nullability and both views have 0 rows. Every other property is optional.
    sh:property [ sh:path :stepOfOrchestratorRun ; sh:class :OrchestratorRun ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :ordinal ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :handle ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :stepName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :argvJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :startedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finishedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :exitCode ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runKind ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :reason ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :outputTail ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:StrategyBookShape
    a sh:NodeShape ;
    sh:targetClass :StrategyBook ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^P[0-9]+$" ] ;
    sh:property [ sh:path :backtestStartDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestEndDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runStatus ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    sh:property [ sh:path :objective ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Confirmed by the upstream maintainer: exclude_hard_vetoed is 0 on all three arms. The TOPN_MV_*
    # arms optimize over the 30 candidates cycle already filtered of HARD vetoes, so the column is
    # persisted as 0 (upstream's DDL comment reads `0 (the arms) | 1`). Only the boolean type is
    # enforced, never a per-arm value.
    sh:property [ sh:path :excludeHardVetoed ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Confirmed by the upstream maintainer: guard_layers is NULL (not '[]') for MARKOWITZ_BASE and
    # TOPN_MV_NOGUARD, and '[1, 3, 4]' for TOPN_MV_GUARD_NO_NLP. Upstream's driver writes None when
    # the arm has no guard, else a sorted JSON list. Optional; never required, never parsed.
    sh:property [ sh:path :guardLayers ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :formationDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BookRebalanceShape
    a sh:NodeShape ;
    sh:targetClass :BookRebalance ;
    sh:property [ sh:path :rebalanceId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rebalanceOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    sh:property [ sh:path :decisionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # v_book_rebalance.knowledge_date = execution_date (handoff §3.2).
    sh:property [ sh:path :executionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Optional: cycle_run_id is always NULL on MARKOWITZ_BASE; the other two are upstream ids as literals.
    sh:property [ sh:path :quantPortfolioId ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cycleRunId ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :riskModelId ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:GuardAlertShape
    a sh:NodeShape ;
    sh:targetClass :GuardAlert ;
    sh:property [ sh:path :alertId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^P[0-9]+$" ] ;
    # v_guard_alert.knowledge_date = date (handoff §3.2).
    sh:property [ sh:path :alertDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :guardLayer ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 1 ; sh:maxInclusive 4 ] ;
    # The rule id is resolved to its GUARD RuleDefinition; the five IRIs are the closed vocabulary.
    sh:property [ sh:path :alertRule ; sh:class :RuleDefinition ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( :Rule_L1_STOP_LOSS :Rule_L1_REENTRY :Rule_L2_NEWS :Rule_L3_VOL :Rule_L4_DD ) ] ;
    sh:property [ sh:path :alertThreshold ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :alertState ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ENTER" "EXIT" "ACTIVE" "COOLDOWN" "SCALE") ] ;
    # Optional: asset/ticker are NULL on layers 3 and 4; value is NULL on layer 1.
    sh:property [ sh:path :guardAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :guardTicker ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :alertValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:GuardActionShape
    a sh:NodeShape ;
    sh:targetClass :GuardAction ;
    sh:property [ sh:path :actionId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :actionOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :actionAlert ; sh:class :GuardAlert ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    sh:property [ sh:path :decisionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # v_guard_action.knowledge_date = effective_date (handoff §3.2).
    sh:property [ sh:path :effectiveDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("APPLIED" "ARM_DISABLED" "NOT_HELD" "SUPERSEDED") ] ;
    # Optional: asset/ticker are NULL on L3/L4 portfolio-scale actions; weight_before/after are NULL
    # on layer 1 asset actions and on NOT_HELD.
    sh:property [ sh:path :guardAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :guardTicker ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :weightBefore ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :weightAfter ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BookWeightDailyShape
    a sh:NodeShape ;
    sh:targetClass :BookWeightDaily ;
    sh:property [ sh:path :weightOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    # v_book_weight_daily.knowledge_date = date (handoff §3.2).
    sh:property [ sh:path :weightDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :holdingKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Optional: CASH has no asset/holding_name; target weights are NULL on ordinary sessions.
    sh:property [ sh:path :holdingAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :holdingName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :markowitzTargetWeight ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finalTargetWeight ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    # CASH is never an asset (handoff §3.3): either the holding is not CASH, or it has no asset link.
    sh:or ( [ sh:path :holdingKey ; sh:not [ sh:hasValue "CASH" ] ]
            [ sh:path :holdingAsset ; sh:maxCount 0 ] ) ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BookDailyPerformanceShape
    a sh:NodeShape ;
    sh:targetClass :BookDailyPerformance ;
    sh:property [ sh:path :performanceOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^P[0-9]+$" ] ;
    # v_book_daily_performance.knowledge_date = date (handoff §3.2).
    sh:property [ sh:path :performanceDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :grossReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :turnover ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # No sign/range on cost_return or drawdown: the handoff states no sign convention.
    sh:property [ sh:path :costReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :netReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nav ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :drawdown ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cashWeight ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nEquity ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Optional: benchmark_return is NULL upstream.
    sh:property [ sh:path :benchmarkReturn ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:PortfolioPeriodSummaryShape
    a sh:NodeShape ;
    sh:targetClass :PortfolioPeriodSummary ;
    sh:property [ sh:path :summaryOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^P[0-9]+$" ] ;
    sh:property [ sh:path :segment ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^P[0-9]+[a-z]?$" ] ;
    sh:property [ sh:path :dateFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # v_portfolio_period_summary.knowledge_date = date_to (handoff §3.2).
    sh:property [ sh:path :dateTo ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :cumulativeReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :annualizedReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :annualizedVol ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :exPostSharpe ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # No sign/range on max_drawdown: the handoff states no sign convention.
    sh:property [ sh:path :maxDrawdown ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :totalTurnover ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :totalCostBps ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nRebalances ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nGuardActions ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BacktestTestShape
    a sh:NodeShape ;
    sh:targetClass :BacktestTest ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^P[0-9]+$" ] ;
    sh:property [ sh:path :segment ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^P[0-9]+[a-z]?$" ] ;
    sh:property [ sh:path :armA ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    sh:property [ sh:path :armB ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD") ] ;
    sh:property [ sh:path :testName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("memmel_jk" "ledoit_wolf" "hac_mean_diff") ] ;
    sh:property [ sh:path :statistic ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :pValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nObs ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :paramsJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

# --- Work item 26: backtest selection side (v_cycle_run, v_veto, v_cycle_ranking)
# The master schema implements the T-155 ranking properties above and adds the cycle/run context
# the backtest side needs. :cycleRunId is shared with BookRebalance (no rdfs:domain), the ticker
# literals survive an asset the universe database does not know, and the no-component ranking rows
# stay visible as placeholders without an :hasEffectiveWeight entry.
:SelectionCycle a owl:Class ;
    rdfs:label "Selection Cycle" ;
    rdfs:label "ciclo de selección"@es ;
    skos:definition "Registro de una corrida del motor de ciclos del sistema de origen (v_cycle_run): tipo de ciclo, fecha de corte, estado y marcas de tiempo de una corrida de selección, monitoreo o repetición."@es ;
    rdfs:comment "One row of v_cycle_run (m018 selection side). A process record, so an Observation. :cycleRunId joins BookRebalance and AttractivenessWeightScheme." ;
    rdfs:subClassOf :Observation .

:cycleType a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :SelectionCycle ; rdfs:range xsd:string .
:rankingOfCycle a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range :SelectionCycle .
:rankingTicker a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range xsd:string .
:vetoTicker a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :Veto ; rdfs:range xsd:string .
:vetoRulesJson a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain :AttractivenessSnapshot ; rdfs:range xsd:string .

:SelectionCycleShape a sh:NodeShape ;
    sh:targetClass :SelectionCycle ;
    sh:property [ sh:path :cycleRunId ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cycleType ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("SELECTION" "MONITORING" "ENTITY_RESOLUTION" "REPLAY") ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :startedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finishedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^P[0-9]+$" ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] .

:BacktestRankingShape a sh:NodeShape ;
    sh:targetSubjectsOf :rankingOfCycle ;
    sh:property [ sh:path :rankingOfCycle ; sh:class :SelectionCycle ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rankPosition ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :selectedForBook ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :vetoedAtRanking ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rankingTicker ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :vetoRulesJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasEffectiveWeight ; sh:class :WeightComponent ] .

:EffectiveWeightComponentShape a sh:NodeShape ;
    sh:targetObjectsOf :hasEffectiveWeight ;
    sh:property [ sh:path :componentValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ; sh:minCount 1 ; sh:maxCount 1 ] .
