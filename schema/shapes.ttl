@prefix :      <https://thesis.local/kg/portfolio#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Portfolio Knowledge Graph — SHACL data-quality shapes
#
# Loads into named graph urn:graph:tbox alongside tbox.ttl (shapes
# describe the schema's data-quality contract, so they travel with
# it), but kept as a separate file/concern deliberately: tbox.ttl
# is OWL semantics (what CAN be inferred, open-world), this file is
# SHACL validation (what MUST hold for data to be accepted,
# closed-world) — see schema/README.md for why both exist.
#################################################################

:ScoreSnapshotShape
    a sh:NodeShape ;
    sh:targetClass :ScoreSnapshot ;
    sh:property [ sh:path :normalizedScore ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :agentOrigin ; sh:in ("FUNDAMENTAL" "SEMANTIC" "VALORIZATION" "TECHNICAL" "SECTOR") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :metricType ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum") ] ;
    sh:property [ sh:path :timestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # T-101: two-clock look-ahead guard. availableAt is mandatory; eventTime is optional but can never postdate it.
    sh:property [ sh:path :availableAt ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :eventTime ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:lessThanOrEquals :availableAt ] ;
    # T-106: optional upstream run provenance (run log itself stays upstream).
    # T-111 (D14): optional method discriminator; open vocabulary (see tbox.ttl).
    sh:property [ sh:path :scoreMethod ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # T-080/T-081: normalizedScore is required unless the metric compares on rawValue (SectorRelativeMomentum,
    # Sentiment) or is FUNDAMENTAL (T-171, D17): upstream rewrites ScoreFinanciero's normalized_score in place
    # on every cycle that re-normalizes its filing, which breaks the immutable-observation principle for a
    # value keyed only by filing. The cohort-relative value lives instead on AttractivenessSnapshot's
    # WeightComponent (:componentValue, T-155), scoped to the cycle_run that produced it. Optional here, not
    # forbidden, so a FUNDAMENTAL snapshot that already carries one (instances.trig; the closed design-history
    # rules that compare on it) still conforms.
    sh:or ( [ sh:path :metricType ; sh:hasValue "SectorRelativeMomentum" ]
            [ sh:path :metricType ; sh:hasValue "Sentiment" ]
            [ sh:path :metricType ; sh:hasValue "ScoreFinanciero" ]
            [ sh:path :normalizedScore ; sh:minCount 1 ] ) ;
    # Sentiment veto rules compare on rawValue ([-1,1]), so every Sentiment snapshot must carry it, whatever else it carries.
    sh:or ( [ sh:not [ sh:path :metricType ; sh:hasValue "Sentiment" ] ]
            [ sh:path :rawValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive -1.0 ; sh:maxInclusive 1.0 ] ) ;
    # T-140: rawValue is owl:FunctionalProperty (tbox.ttl); enforce it closed-world for every metric.
    sh:property [ sh:path :rawValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    # T-140: SectorRelativeMomentum compares on rawValue too (WC_SectorMom), so it must carry one. T-155 widened
    # its range from [-1,1] (that bound only served the attractiveness formula's (rawValue + 1) / 2, which is not
    # computed here) to [-100,100]: upstream's SECTOR raw_value is the asset's TECHNICAL raw score minus its
    # sector's mean, in TECHNICAL points (observed -54 to +46), read verbatim. Its 0-100 normalized_score is an
    # optional normalizedScore (T-031 rescales it).
    sh:or ( [ sh:not [ sh:path :metricType ; sh:hasValue "SectorRelativeMomentum" ] ]
            [ sh:path :rawValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive -100.0 ; sh:maxInclusive 100.0 ] ) ;
    # T-171 (D17): dropping normalizedScore's requirement for ScoreFinanciero must not leave it free to carry
    # neither value, so rawValue becomes its mandatory replacement, same pairing as the two sh:or above.
    # T-177: bounded to [0,100], upstream's answer to Q6 (2026-10-09): it is the assessment's score, which their
    # model bounds with ge=0 and le=100 (the rule-based fallback clamps to the same range).
    sh:or ( [ sh:not [ sh:path :metricType ; sh:hasValue "ScoreFinanciero" ] ]
            [ sh:path :rawValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ] ) ;
    # T-140: each agent writes exactly one metric (SPEC D6; upstream score_type = agentOrigin).
    sh:xone ( [ sh:property [ sh:path :agentOrigin ; sh:hasValue "FUNDAMENTAL" ] , [ sh:path :metricType ; sh:hasValue "ScoreFinanciero" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "VALORIZATION" ] , [ sh:path :metricType ; sh:hasValue "ScoreCuantitativo" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "TECHNICAL" ] , [ sh:path :metricType ; sh:hasValue "ScoreTecnico" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "SECTOR" ] , [ sh:path :metricType ; sh:hasValue "SectorRelativeMomentum" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "SEMANTIC" ] , [ sh:path :metricType ; sh:hasValue "Sentiment" ] ] ) .

:RiskEventShape
    a sh:NodeShape ;
    sh:targetClass :RiskEvent ;
    sh:property [ sh:path :backedBy ; sh:minCount 1 ] ;
    sh:property [ sh:path :severity ; sh:in ("CRITICAL" "HIGH" "MODERATE" "LOW") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :category ; sh:in ("LEGAL" "FINANCIAL" "MARKET" "NETWORK") ; sh:minCount 1 ; sh:maxCount 1 ] .

:VetoShape
    a sh:NodeShape ;
    sh:targetClass :Veto ;
    # T-106: optional upstream run provenance (D7). A Veto is a stint appended to by later cycles: these four record the run that OPENED it (raisedOn);
    # later cycles must not re-emit them and the closing run is not recorded.
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # T-102: a Veto is a stint. raisedOn is required; clearedOn absent = still active.
    sh:property [ sh:path :raisedOn ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:lessThan :clearedOn ; sh:lessThanOrEquals :lastSeenOn, :expiresOn ] ;
    sh:property [ sh:path :clearedOn ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    # T-188: optional and multi-valued like lastSeenOn (upstream moves it while the condition holds, and the graphs are
    # append-only: current = MAX); every value not before raisedOn (the same day passes). Upstream sets it on the
    # temporary HARD rules' stints only (VOLATILITY_SHOCK, CRASH_Z_SCORE); not enforced here, the shape cannot see the
    # rule's severity. It never closes a stint: only clearedOn does.
    sh:property [ sh:path :expiresOn ; sh:datatype xsd:date ] ;
    # lastSeenOn is multi-valued (append-only graphs): one value per cycle, current = MAX. A cycle that
    # clears a stint did not see it raised, so no sighting is later than the clearing (T-185; the same
    # day passes). The gate makes the same check when a stored Veto is cleared later.
    sh:property [ sh:path :lastSeenOn ; sh:datatype xsd:date ; sh:lessThanOrEquals :clearedOn ] ;
    sh:property [ sh:path :vetoSeverity ; sh:in ("HARD" "SOFT") ; sh:maxCount 1 ] ;
    # Work item 26: upstream ticker, always written by the backtest selection projector; the asset
    # link is optional because the shared universe database may not know the line.
    sh:property [ sh:path :vetoTicker ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # T-206: a GUARD rule is not a veto rule. Refuse it as the object of either rule link, so a Veto
    # can never reach one even though both are :RuleDefinition individuals. (No sh:class here: the
    # canonical pyshacl command validates instances.trig without rules.ttl, so the rule nodes are not
    # typed in that data graph; the range is declared in tbox.ttl.)
    sh:property [ sh:path :appliesRule ;
                  sh:node [ sh:not [ sh:property [ sh:path :category ; sh:hasValue "GUARD" ] ] ] ] ;
    sh:property [ sh:path :primaryRule ;
                  sh:node [ sh:not [ sh:property [ sh:path :category ; sh:hasValue "GUARD" ] ] ] ] .

:DataQualityIssueShape
    a sh:NodeShape ;
    sh:targetClass :DataQualityIssue ;
    # T-106: optional upstream run provenance (D7).
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqIssueOfAsset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqRaisedOn ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqIssueOfFiling ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqMetricName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :provenanceId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqGateCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqSeverity ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quarantined ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :gatedValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ] .

:AssetCoOccurrenceShape
    a sh:NodeShape ;
    sh:targetClass :AssetCoOccurrence ;
    # T-107 (D10): candidate, not verified. Exactly two assets; method and weight mandatory. Kind is limited to
    # SHARED_EXECUTIVE_CANDIDATE until media_cooccurrence has a v_* view (none exists, T-109). computedOn is optional:
    # v_shared_executive_edge has no computed-at column, only first_seen/last_seen (T-109); runId/runAsOf can carry it.
    # T-106: optional upstream run provenance (D7).
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceAsset ; sh:class :Asset ; sh:minCount 2 ; sh:maxCount 2 ] ;
    sh:property [ sh:path :coOccurrenceKind ; sh:in ("SHARED_EXECUTIVE_CANDIDATE") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceMethod ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceWeight ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceComputedOn ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :provenanceId ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:PortfolioShape
    a sh:NodeShape ;
    sh:targetClass :Portfolio ;
    # T-108 (D11): kind required (written explicitly by the projection, by source view).
    sh:property [ sh:path :portfolioName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :portfolioKind ; sh:in ("LIVE" "BENCHMARK") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :benchmarkObjective ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # live_book is upstream's snapshot of the live book and is never projected as a Portfolio (T-109).
    sh:property [ sh:path :benchmarkKind ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:not [ sh:in ("live_book") ] ] .

:QuantSubjectShape
    a sh:NodeShape ;
    # T-108/T-109: a BenchmarkObservation is about a BENCHMARK book, or about the LIVE book (performance upstream measured on its
    # live_book snapshot). Any other kind is rejected. Today this restates PortfolioShape's own sh:in; it is kept as the
    # single place to widen or narrow what a quant number may be about if a third kind is added.
    sh:property [ sh:path :portfolioKind ; sh:in ("LIVE" "BENCHMARK") ] .

:BenchmarkObservationShape
    a sh:NodeShape ;
    sh:targetClass :BenchmarkObservation ;
    # T-108 (D11): a finished upstream quant number about a BENCHMARK book or the LIVE book. Metric is free text (columns pinned in T-109,
    # see tbox.ttl). T-106: optional run provenance.
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantPortfolio ; sh:class :Portfolio ; sh:node :QuantSubjectShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantMetric ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantUnit ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    # T-109: a LIVE subject only carries performance numbers measured on upstream's live_book snapshot; book metrics
    # (expected_*, sharpe) and active_weight are about optimizer books.
    sh:or ( [ sh:path :quantPortfolio ; sh:node [ sh:property [ sh:path :portfolioKind ; sh:hasValue "BENCHMARK" ] ] ]
            [ sh:path :quantMetric ; sh:in ("realized_return" "cumulative_return" "benchmark_return" "active_return") ] ) ;
    sh:property [ sh:path :quantBenchmark ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :provenanceId ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:RuleDefinitionShape
    a sh:NodeShape ;
    sh:targetClass :RuleDefinition ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasClause ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # T-206: widened from [1,9] to [1,10] for UTILITY_CASH_COVERAGE (rank 10).
    sh:property [ sh:path :priorityRank ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 10 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :ruleId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # T-187: upstream's penalty_points, SOFT rules only; at least 0. A HARD rule excludes the asset, so it has none; a HARD rule's SOFT stint is charged the run's soft_veto_penalty (assumed, T-191 ask 8).
    sh:property [ sh:path :penaltyPoints ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxCount 1 ] ;
    sh:not [ a sh:NodeShape ;
             sh:property [ sh:path :ruleSeverity ; sh:hasValue "HARD" ] ;
             sh:property [ sh:path :penaltyPoints ; sh:minCount 1 ] ] ;
    sh:property [ sh:path :ruleSeverity ; sh:in ("HARD" "SOFT") ; sh:maxCount 1 ] ;
    # T-206: a GUARD rule is a RuleDefinition but not a veto rule. It carries :category "GUARD" and
    # no :ruleSeverity/:penaltyPoints/:priorityRank; the three sh:or/sh:not blocks below are the only
    # shape change. They do not weaken the veto rules: a non-GUARD active rule still needs a severity
    # and every non-GUARD rule still needs a priorityRank.
    sh:or ( [ sh:path :validTo ; sh:minCount 1 ]
            [ sh:path :ruleSeverity ; sh:minCount 1 ]
            [ sh:path :category ; sh:hasValue "GUARD" ] ) ;
    sh:or ( [ sh:path :category ; sh:hasValue "GUARD" ]
            [ sh:path :priorityRank ; sh:minCount 1 ] ) ;
    sh:not [ a sh:NodeShape ;
             sh:property [ sh:path :category ; sh:hasValue "GUARD" ] ;
             sh:or ( [ sh:path :ruleSeverity ; sh:minCount 1 ]
                     [ sh:path :penaltyPoints ; sh:minCount 1 ]
                     [ sh:path :priorityRank ; sh:minCount 1 ] ) ] ;
    # T-206: the GUARD layer is optional on a rule, but bounded 1..4 when present.
    sh:property [ sh:path :guardLayer ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 4 ; sh:maxCount 1 ] .

:RuleClauseShape
    a sh:NodeShape ;
    sh:targetClass :RuleClause ;
    sh:property [ sh:path :clauseType ; sh:in ("AND" "OR") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :operand1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :operand2 ; sh:minCount 1 ; sh:maxCount 1 ] .

:ThresholdComparisonShape
    a sh:NodeShape ;
    sh:targetClass :ThresholdComparison ;
    sh:property [ sh:path :metricName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum"
                         "leverage.debt_to_equity" "cashflow.free_cash_flow_margin" "liquidity.current_ratio"
                         "max_drawdown_90d" "fundamental_score_age_days"
                         "leverage.interest_coverage" "cashflow.operating_cash_flow_margin"
                         "rule_input.utility_cash_coverage_3y") ] ;
    sh:property [ sh:path :operator ; sh:in (">" "<" ">=" "<=") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :thresholdValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] .

:CategoricalComparisonShape
    a sh:NodeShape ;
    sh:targetClass :CategoricalComparison ;
    sh:property [ sh:path :attributeName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :expectedValue ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

:GraphPredicateShape
    a sh:NodeShape ;
    sh:targetClass :GraphPredicate ;
    sh:property [ sh:path :predicateName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

:UniverseMembershipShape
    a sh:NodeShape ;
    sh:targetClass :UniverseMembership ;
    # T-220/T-227: the Asset and Universe ends' classes, so the gate's context read follows a
    # stored Asset a membership batch points at. Without `sh:class :Asset` it fetched only
    # rdf:type, and AssetShape then failed on tickerSymbol/cikNumber for the five assets
    # reference.ttl already declares; without `sh:class :Universe` the projector's dry-run context
    # did not type :SP500Index.
    sh:property [ sh:path :membershipAsset ; sh:class :Asset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :membershipUniverse ; sh:class :Universe ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:lessThanOrEquals :validTo ] ;
    # T-260: validTo is INCLUSIVE and is the last day of membership (upstream's
    # valid_from <= D AND (valid_to IS NULL OR valid_to >= D)). A one-day stint
    # (validFrom == validTo) conforms; validTo < validFrom still fails.
    sh:property [ sh:path :validTo ; sh:datatype xsd:date ; sh:maxCount 1 ] .

:PortfolioPositionShape
    a sh:NodeShape ;
    sh:targetClass :PortfolioPosition ;
    # T-106: optional upstream run provenance (D7). Valid-time record closed later by validTo: these four record the run that OPENED it (validFrom);
    # later runs must not re-emit them and the closing run is not recorded.
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :positionAsset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :weightPct ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:AssetShape
    a sh:NodeShape ;
    sh:targetClass :Asset ;
    sh:property [ sh:path :tickerSymbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cikNumber ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # T-100 (D1): upstream's universe.db has no CIK for a company that has left the index. cikNumber is therefore
    # required unless the Asset has at least one UniverseMembership and EVERY one of them is closed (has a validTo):
    # a current (open-membership) Asset without a CIK still fails. Work item 33: an ExchangeTradedFund is a core
    # ETF, not an S&P 500 constituent, so it has no CIK, no membership and no GICS classification (classification
    # was never required by this shape). Every ordinary Asset keeps all of the above unchanged.
    sh:or (
        [ sh:path :cikNumber ; sh:minCount 1 ]
        [ sh:path :hasUniverseMembership ; sh:minCount 1 ;
          sh:node [ sh:property [ sh:path :validTo ; sh:minCount 1 ] ] ]
        [ sh:path rdf:type ; sh:hasValue :ExchangeTradedFund ]
    ) .

:SectorAggregateSnapshotShape
    a sh:NodeShape ;
    sh:targetClass :SectorAggregateSnapshot ;
    # T-106: optional upstream run provenance (D7).
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :sectorSnapshotOfSector ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :normalizedScore ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :metricType ; sh:hasValue "ScoreTecnico" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :agentOrigin ; sh:hasValue "SECTOR" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :timestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .

:AttractivenessSnapshotShape
    a sh:NodeShape ;
    sh:targetClass :AttractivenessSnapshot ;
    # Work item 26: an asset link is preferred, but a backtest ticker the shared universe database
    # does not know keeps its :rankingTicker instead of losing the ranking row. Existing live
    # individuals (asset link only) still conform.
    sh:property [ sh:path :attractivenessOfAsset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rankingTicker ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:or ( [ sh:path :attractivenessOfAsset ; sh:minCount 1 ]
            [ sh:path :rankingTicker ; sh:minCount 1 ] ) ;
    # T-155: no lower bound: upstream's blended_score / 100 goes negative when the SOFT-veto penalties exceed the blend (T-189: the sum of the active SOFT stints' rules' :penaltyPoints, 15 each unless the stint's rule declares its own).
    sh:property [ sh:path :attractivenessScore ; sh:datatype xsd:decimal ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :computedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :computedWithScheme ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Selection-side fields (Work item 26). Optional on the pre-existing live examples; the
    # BacktestRankingShape below requires them where :rankingOfCycle is written.
    sh:property [ sh:path :rankingOfCycle ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rankPosition ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :selectedForBook ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path :vetoedAtRanking ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    sh:property [ sh:path :targetWeight ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :vetoRulesJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasEffectiveWeight ; sh:class :WeightComponent ] .

:BacktestRankingShape
    a sh:NodeShape ;
    # Scoped to the snapshots the selection-side projector writes, so the pre-existing live examples
    # (which have no cycle/rank fields) are not retroactively required to grow them.
    sh:targetSubjectsOf :rankingOfCycle ;
    sh:property [ sh:path :rankingOfCycle ; sh:class :SelectionCycle ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rankPosition ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :selectedForBook ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :vetoedAtRanking ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rankingTicker ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :vetoRulesJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasEffectiveWeight ; sh:class :WeightComponent ] .

:AttractivenessWeightSchemeShape
    a sh:NodeShape ;
    sh:targetClass :AttractivenessWeightScheme ;
    # T-121: exactly one of two kinds. An upstream scheme is a per-run observation dated by :cycleDate
    # (v_weight_scheme.cycle_date) and never closed, so it carries no validTo; the design-history
    # WeightScheme_v1 is a valid-time record (validFrom, optionally validTo). A scheme with both dates,
    # or neither, or a per-run scheme with a validTo, fails the sh:xone.
    sh:xone ( [ sh:path :validFrom ; sh:minCount 1 ]
              [ sh:property [ sh:path :cycleDate ; sh:minCount 1 ] ; sh:property [ sh:path :validTo ; sh:maxCount 0 ] ] ) ;
    sh:property [ sh:path :schemeId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cycleDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cycleRunId ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookWeightingRule ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :topN ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :maxNameWeight ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :maxSectorWeight ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :softVetoPenalty ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasWeightComponent ; sh:minCount 1 ] .

:WeightComponentShape
    a sh:NodeShape ;
    sh:targetClass :WeightComponent ;
    sh:property [ sh:path :weightMetricName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum") ] ;
    sh:property [ sh:path :weightValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :inverted ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
    # Work item 26: only effective-weight components carry this (the configured ones do not); the
    # targetObjectsOf shape below makes it mandatory exactly for those reached by :hasEffectiveWeight.
    sh:property [ sh:path :componentValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ; sh:maxCount 1 ] .

:EffectiveWeightComponentShape
    a sh:NodeShape ;
    sh:targetObjectsOf :hasEffectiveWeight ;
    sh:property [ sh:path :componentValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ; sh:minCount 1 ; sh:maxCount 1 ] .

#################################################################
# CONTRACT v18 SHAPES (T-206, 2026-11-01)
#
# One NodeShape per new class. Required (minCount 1) only what the
# view guarantees non-null; the handoff §3.3 nullable columns are
# optional and must never be required. Closed vocabularies use sh:in
# where the handoff enumerates the values; where a vocabulary may
# grow upstream it stays open and says so in a comment (the
# :scoreMethod pattern). No sign or range constraint is placed on
# :drawdown, :costReturn or :maxDrawdown: the handoff states no sign
# convention, even though the three completed databases hold
# non-negative magnitudes.
#################################################################

:TickerHistoryShape
    a sh:NodeShape ;
    sh:targetClass :TickerHistory ;
    sh:property [ sh:path :tickerHistoryCik ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :historicalSymbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :canonicalSymbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # validTo is INCLUSIVE and optional (NULL = current symbol): v_ticker_history.valid_to is the
    # symbol's last valid date (handoff §3.1), so validFrom <= validTo when present. This differs
    # from RuleDefinition's exclusive validTo (T-187).
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:lessThanOrEquals :validTo ] ;
    sh:property [ sh:path :validTo ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    # Optional: the LEFT JOIN can leave no asset; evidence_url/evidence_date are optional per the
    # v18 shape contract even though the m016 DDL marks them NOT NULL.
    sh:property [ sh:path :tickerHistoryAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :evidenceUrl ; sh:datatype xsd:anyURI ; sh:maxCount 1 ] ;
    sh:property [ sh:path :evidenceDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :tickerHistoryRules ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:OrchestratorRunShape
    a sh:NodeShape ;
    sh:targetClass :OrchestratorRun ;
    # Only the natural key is required: the handoff §3.1 gives the view SQL but not the base table's
    # NOT NULL constraints, and both orchestrator views have 0 rows in P1/P2/P3. Every other property
    # is optional with its datatype and maxCount 1.
    sh:property [ sh:path :orchestratorRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :handle ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runKind ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :surface ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :startedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finishedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :settingsJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:OrchestratorStepShape
    a sh:NodeShape ;
    sh:targetClass :OrchestratorStep ;
    # Only the natural key is required, for the same reason as OrchestratorRunShape: handoff §3.1 has
    # no base-table nullability and both views have 0 rows. Every other property is optional.
    sh:property [ sh:path :stepOfOrchestratorRun ; sh:class :OrchestratorRun ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :ordinal ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :handle ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :stepName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :argvJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :startedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finishedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :exitCode ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runKind ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :reason ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :outputTail ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:StrategyBookShape
    a sh:NodeShape ;
    sh:targetClass :StrategyBook ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # The operator's run label (T-233), required on the two classes with no book link. Window and
    # segment are patterns since T-234: a typo in a window's letter or digits is no longer caught.
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[PH][0-9]+$" ] ;
    sh:property [ sh:path :backtestStartDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestEndDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runStatus ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    sh:property [ sh:path :objective ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Confirmed by the upstream maintainer: exclude_hard_vetoed is 0 on all four arms. The TOPN_MV_*
    # arms optimize over the 30 candidates cycle already filtered of HARD vetoes, so the column is
    # persisted as 0 (upstream's DDL comment reads `0 (the arms) | 1`). Only the boolean type is
    # enforced, never a per-arm value.
    sh:property [ sh:path :excludeHardVetoed ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Confirmed by the upstream maintainer: guard_layers is NULL (not '[]') for MARKOWITZ_BASE and
    # TOPN_MV_NOGUARD, and '[1, 3, 4]' for TOPN_MV_GUARD_NO_NLP. Upstream's driver writes None when
    # the arm has no guard, else a sorted JSON list. Optional; never required, never parsed.
    sh:property [ sh:path :guardLayers ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :formationDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BookRebalanceShape
    a sh:NodeShape ;
    sh:targetClass :BookRebalance ;
    sh:property [ sh:path :rebalanceId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :rebalanceOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    sh:property [ sh:path :decisionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # v_book_rebalance.knowledge_date = execution_date (handoff §3.2).
    sh:property [ sh:path :executionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Optional: cycle_run_id is always NULL on MARKOWITZ_BASE; the other two are upstream ids as literals.
    sh:property [ sh:path :quantPortfolioId ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cycleRunId ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :riskModelId ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:GuardAlertShape
    a sh:NodeShape ;
    sh:targetClass :GuardAlert ;
    sh:property [ sh:path :alertId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[PH][0-9]+$" ] ;
    # v_guard_alert.knowledge_date = date (handoff §3.2).
    sh:property [ sh:path :alertDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :guardLayer ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 1 ; sh:maxInclusive 4 ] ;
    # The rule id is resolved to its GUARD RuleDefinition; the seven IRIs are the closed vocabulary.
    sh:property [ sh:path :alertRule ; sh:class :RuleDefinition ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( :Rule_L1_STOP_LOSS :Rule_L1_REENTRY :Rule_L1_BP_STOP :Rule_L1_BP_REENTRY
                          :Rule_L2_NEWS :Rule_L3_VOL :Rule_L4_DD ) ] ;
    # PUBLICATION RULE (Work item 33): the Basing Points stop's threshold is the individual
    # asset's stop price level, which upstream's licence forbids redistributing. It is therefore
    # forbidden on L1_BP_STOP/L1_BP_REENTRY alerts and still required, as before, on every other
    # alert (L1_STOP_LOSS/L1_REENTRY keep their fixed parameter). sh:xone is the conditional
    # mechanism already used in this file (AttractivenessWeightSchemeShape).
    sh:xone (
        [ sh:property [ sh:path :alertRule ; sh:in ( :Rule_L1_BP_STOP :Rule_L1_BP_REENTRY ) ] ;
          sh:property [ sh:path :alertThreshold ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path :alertRule ;
                        sh:not [ sh:in ( :Rule_L1_BP_STOP :Rule_L1_BP_REENTRY ) ] ] ;
          sh:property [ sh:path :alertThreshold ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ]
    ) ;
    sh:property [ sh:path :alertState ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ENTER" "EXIT" "ACTIVE" "COOLDOWN" "SCALE") ] ;
    # Optional: asset/ticker are NULL on layers 3 and 4; value is NULL on layer 1.
    sh:property [ sh:path :guardAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :guardTicker ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :alertValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:GuardActionShape
    a sh:NodeShape ;
    sh:targetClass :GuardAction ;
    sh:property [ sh:path :actionId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :actionOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :actionAlert ; sh:class :GuardAlert ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    sh:property [ sh:path :decisionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # v_guard_action.knowledge_date = effective_date (handoff §3.2).
    sh:property [ sh:path :effectiveDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("APPLIED" "ARM_DISABLED" "NOT_HELD" "SUPERSEDED") ] ;
    # Optional: asset/ticker are NULL on L3/L4 portfolio-scale actions; weight_before/after are NULL
    # on layer 1 asset actions and on NOT_HELD.
    sh:property [ sh:path :guardAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :guardTicker ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :weightBefore ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :weightAfter ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BookWeightDailyShape
    a sh:NodeShape ;
    sh:targetClass :BookWeightDaily ;
    sh:property [ sh:path :weightOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    # v_book_weight_daily.knowledge_date = date (handoff §3.2).
    sh:property [ sh:path :weightDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :holdingKey ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Optional: CASH has no asset/holding_name; target weights are NULL on ordinary sessions.
    sh:property [ sh:path :holdingAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :holdingName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :markowitzTargetWeight ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finalTargetWeight ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    # CASH is never an asset (handoff §3.3): either the holding is not CASH, or it has no asset link.
    sh:or ( [ sh:path :holdingKey ; sh:not [ sh:hasValue "CASH" ] ]
            [ sh:path :holdingAsset ; sh:maxCount 0 ] ) ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BookDailyPerformanceShape
    a sh:NodeShape ;
    sh:targetClass :BookDailyPerformance ;
    sh:property [ sh:path :performanceOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[PH][0-9]+$" ] ;
    # v_book_daily_performance.knowledge_date = date (handoff §3.2).
    sh:property [ sh:path :performanceDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :grossReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :turnover ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # No sign/range on cost_return or drawdown: the handoff states no sign convention.
    sh:property [ sh:path :costReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :netReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nav ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :drawdown ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cashWeight ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nEquity ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Optional: benchmark_return is NULL upstream.
    sh:property [ sh:path :benchmarkReturn ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:PortfolioPeriodSummaryShape
    a sh:NodeShape ;
    sh:targetClass :PortfolioPeriodSummary ;
    sh:property [ sh:path :summaryOfBook ; sh:class :StrategyBook ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :bookId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :armCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[PH][0-9]+$" ] ;
    sh:property [ sh:path :segment ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[PH][0-9]+[a-z]?$" ] ;
    sh:property [ sh:path :dateFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # v_portfolio_period_summary.knowledge_date = date_to (handoff §3.2).
    sh:property [ sh:path :dateTo ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:equals :knowledgeDate ] ;
    sh:property [ sh:path :cumulativeReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :annualizedReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :annualizedVol ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :exPostSharpe ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # No sign/range on max_drawdown: the handoff states no sign convention.
    sh:property [ sh:path :maxDrawdown ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :totalTurnover ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :totalCostBps ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nRebalances ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nGuardActions ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:BacktestTestShape
    a sh:NodeShape ;
    sh:targetClass :BacktestTest ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[PH][0-9]+$" ] ;
    sh:property [ sh:path :segment ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[PH][0-9]+[a-z]?$" ] ;
    sh:property [ sh:path :armA ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    sh:property [ sh:path :armB ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("MARKOWITZ_BASE" "TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP" "TOPN_MV_GUARD" "MARKOWITZ_BASE_GUARD") ] ;
    sh:property [ sh:path :testName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("memmel_jk" "ledoit_wolf" "hac_mean_diff" "bootstrap_mdd") ] ;
    sh:property [ sh:path :statistic ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :pValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nObs ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :paramsJson ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

#################################################################
# BACKTEST SELECTION-SIDE SHAPE (Work item 26, T-322)
#
# v_cycle_run -> :SelectionCycle. Required only what the view
# guarantees non-null; the run label, window and backtest run id
# are projector context (the view itself is per database).
#################################################################

:SelectionCycleShape
    a sh:NodeShape ;
    sh:targetClass :SelectionCycle ;
    sh:property [ sh:path :cycleRunId ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cycleType ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("SELECTION" "MONITORING" "ENTITY_RESOLUTION" "REPLAY") ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :status ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :startedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :finishedAt ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[PH][0-9]+$" ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] .

#################################################################
# BACKTEST RUN METADATA (Work item 33, T-475)
#
# One :BacktestRun per label and window, one :RunConfiguration per
# label, both written by the loader in Work item 35 into the
# append-only urn:graph:derived:backtest:meta:{label} graph. The
# source hash is the SHA-256SUMS value, lowercase, never recomputed
# here; the configuration text is the fixed English text of the
# run's config_<label>.md.
#################################################################

:BacktestRunShape
    a sh:NodeShape ;
    sh:targetClass :BacktestRun ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :windowId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[PH][0-9]+$" ] ;
    sh:property [ sh:path :backtestRunId ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :sourceFile ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :sourceSha256 ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path :knowledgeDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runConfiguration ; sh:class :RunConfiguration ; sh:minCount 1 ; sh:maxCount 1 ] .

:RunConfigurationShape
    a sh:NodeShape ;
    sh:targetClass :RunConfiguration ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :configCodeCommit ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :configPr ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :configResultsDoc ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :configId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :configStatus ; sh:datatype xsd:string ; sh:maxCount 1 ] .

#################################################################
# AGGREGATES FILE (Work item 37)
#
# aggregates_<label>.json projects into one append-only
# urn:graph:derived:backtest:aggregates:{label} graph. One
# AggregatesSet per label, one TrendFilterState per window and
# decision date, one ReferenceReturn per window, segment and
# reference. Only per-segment aggregates; no daily series, price
# level or 210-session mean is stored.
#################################################################

:AggregatesSetShape
    a sh:NodeShape ;
    sh:targetClass :AggregatesSet ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :aggregatesSourceFile ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^aggregates_[a-z][a-z0-9_]{1,31}[.]json$" ] ;
    sh:property [ sh:path :aggregatesSourceSha256 ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path :aggregatesConfigId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :aggregatesRunDatabasesSource ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :aggregatesSpySource ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :aggregatesSp500EwInternalSource ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

:TrendFilterStateShape
    a sh:NodeShape ;
    sh:targetClass :TrendFilterState ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :trendWindow ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[PH][0-9]+$" ] ;
    sh:property [ sh:path :trendDecisionDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :trendState ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("below" "at_or_above" "not_evaluable") ] ;
    sh:property [ sh:path :cashFraction ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ] ;
    sh:property [ sh:path :appliesToArm ; sh:datatype xsd:string ; sh:minCount 2 ; sh:maxCount 2 ;
                  sh:in ("TOPN_MV_NOGUARD" "TOPN_MV_GUARD_NO_NLP") ] ;
    sh:property [ sh:path :aggregatesSet ; sh:class :AggregatesSet ; sh:minCount 1 ; sh:maxCount 1 ] .

:ReferenceReturnShape
    a sh:NodeShape ;
    sh:targetClass :ReferenceReturn ;
    sh:property [ sh:path :runLabel ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[a-z][a-z0-9_]{1,31}$" ] ;
    sh:property [ sh:path :returnWindow ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[PH][0-9]+$" ] ;
    sh:property [ sh:path :returnSegment ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[PH][0-9]+[a-z]?$" ] ;
    sh:property [ sh:path :referenceDateFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:lessThanOrEquals :referenceDateTo ] ;
    sh:property [ sh:path :referenceDateTo ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :nSessions ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 1 ] ;
    sh:property [ sh:path :referenceName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("SPY" "SP500_EW_INTERNAL") ] ;
    sh:property [ sh:path :referenceTotalReturn ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :referenceMaxDrawdown ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 0.0 ] ;
    sh:property [ sh:path :aggregatesSet ; sh:class :AggregatesSet ; sh:minCount 1 ; sh:maxCount 1 ] .
