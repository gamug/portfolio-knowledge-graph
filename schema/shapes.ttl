@prefix :      <https://thesis.local/kg/portfolio#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Portfolio Knowledge Graph — SHACL data-quality shapes
#
# Loads into named graph urn:graph:tbox alongside tbox.ttl (shapes
# describe the schema's data-quality contract, so they travel with
# it), but kept as a separate file/concern deliberately: tbox.ttl
# is OWL semantics (what CAN be inferred, open-world), this file is
# SHACL validation (what MUST hold for data to be accepted,
# closed-world) — see schema/README.md for why both exist.
#################################################################

:ScoreSnapshotShape
    a sh:NodeShape ;
    sh:targetClass :ScoreSnapshot ;
    sh:property [ sh:path :normalizedScore ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :agentOrigin ; sh:in ("FUNDAMENTAL" "SEMANTIC" "VALORIZATION" "TECHNICAL" "SECTOR") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :metricType ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum") ] ;
    sh:property [ sh:path :timestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # T-101: two-clock look-ahead guard. availableAt is mandatory; eventTime is optional but can never postdate it.
    sh:property [ sh:path :availableAt ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :eventTime ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:lessThanOrEquals :availableAt ] ;
    # T-106: optional upstream run provenance (run log itself stays upstream).
    # T-111 (D14): optional method discriminator; open vocabulary (see tbox.ttl).
    sh:property [ sh:path :scoreMethod ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # T-080/T-081: normalizedScore is required unless the metric compares on rawValue (SectorRelativeMomentum,
    # Sentiment) or is FUNDAMENTAL (T-171, D17): upstream rewrites ScoreFinanciero's normalized_score in place
    # on every cycle that re-normalizes its filing, which breaks the immutable-observation principle for a
    # value keyed only by filing. The cohort-relative value lives instead on AttractivenessSnapshot's
    # WeightComponent (:componentValue, T-155), scoped to the cycle_run that produced it. Optional here, not
    # forbidden, so a FUNDAMENTAL snapshot that already carries one (instances.trig; the closed design-history
    # rules that compare on it) still conforms.
    sh:or ( [ sh:path :metricType ; sh:hasValue "SectorRelativeMomentum" ]
            [ sh:path :metricType ; sh:hasValue "Sentiment" ]
            [ sh:path :metricType ; sh:hasValue "ScoreFinanciero" ]
            [ sh:path :normalizedScore ; sh:minCount 1 ] ) ;
    # Sentiment veto rules compare on rawValue ([-1,1]), so every Sentiment snapshot must carry it, whatever else it carries.
    sh:or ( [ sh:not [ sh:path :metricType ; sh:hasValue "Sentiment" ] ]
            [ sh:path :rawValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive -1.0 ; sh:maxInclusive 1.0 ] ) ;
    # T-140: rawValue is owl:FunctionalProperty (tbox.ttl); enforce it closed-world for every metric.
    sh:property [ sh:path :rawValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ;
    # T-140: SectorRelativeMomentum compares on rawValue too (WC_SectorMom), so it must carry one, in [-1,1]:
    # ScoreTecnico minus its sector aggregate, both [0,1] (docs/06 §1.8), which the attractiveness formula's
    # (rawValue + 1) / 2 needs. Mapping upstream's SECTOR score into this range is the projector's job (T-031).
    sh:or ( [ sh:not [ sh:path :metricType ; sh:hasValue "SectorRelativeMomentum" ] ]
            [ sh:path :rawValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive -1.0 ; sh:maxInclusive 1.0 ] ) ;
    # T-140: each agent writes exactly one metric (SPEC D6; upstream score_type = agentOrigin).
    sh:xone ( [ sh:property [ sh:path :agentOrigin ; sh:hasValue "FUNDAMENTAL" ] , [ sh:path :metricType ; sh:hasValue "ScoreFinanciero" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "VALORIZATION" ] , [ sh:path :metricType ; sh:hasValue "ScoreCuantitativo" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "TECHNICAL" ] , [ sh:path :metricType ; sh:hasValue "ScoreTecnico" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "SECTOR" ] , [ sh:path :metricType ; sh:hasValue "SectorRelativeMomentum" ] ]
              [ sh:property [ sh:path :agentOrigin ; sh:hasValue "SEMANTIC" ] , [ sh:path :metricType ; sh:hasValue "Sentiment" ] ] ) .

:RiskEventShape
    a sh:NodeShape ;
    sh:targetClass :RiskEvent ;
    sh:property [ sh:path :backedBy ; sh:minCount 1 ] ;
    sh:property [ sh:path :severity ; sh:in ("CRITICAL" "HIGH" "MODERATE" "LOW") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :category ; sh:in ("LEGAL" "FINANCIAL" "MARKET" "NETWORK") ; sh:minCount 1 ; sh:maxCount 1 ] .

:VetoShape
    a sh:NodeShape ;
    sh:targetClass :Veto ;
    # T-106: optional upstream run provenance (D7). A Veto is a stint appended to by later cycles: these four record the run that OPENED it (raisedOn);
    # later cycles must not re-emit them and the closing run is not recorded.
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # T-102: a Veto is a stint. raisedOn is required; clearedOn absent = still active.
    sh:property [ sh:path :raisedOn ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:lessThan :clearedOn ; sh:lessThanOrEquals :lastSeenOn ] ;
    sh:property [ sh:path :clearedOn ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    # lastSeenOn is multi-valued (append-only graphs): one value per cycle, current = MAX.
    sh:property [ sh:path :lastSeenOn ; sh:datatype xsd:date ] ;
    sh:property [ sh:path :vetoSeverity ; sh:in ("HARD" "SOFT") ; sh:maxCount 1 ] .

:DataQualityIssueShape
    a sh:NodeShape ;
    sh:targetClass :DataQualityIssue ;
    # T-106: optional upstream run provenance (D7).
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqIssueOfAsset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqRaisedOn ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqIssueOfFiling ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqMetricName ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :provenanceId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqGateCode ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dqSeverity ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quarantined ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :gatedValue ; sh:datatype xsd:decimal ; sh:maxCount 1 ] .

:AssetCoOccurrenceShape
    a sh:NodeShape ;
    sh:targetClass :AssetCoOccurrence ;
    # T-107 (D10): candidate, not verified. Exactly two assets; method and weight mandatory. Kind is limited to
    # SHARED_EXECUTIVE_CANDIDATE until media_cooccurrence has a v_* view (none exists, T-109). computedOn is optional:
    # v_shared_executive_edge has no computed-at column, only first_seen/last_seen (T-109); runId/runAsOf can carry it.
    # T-106: optional upstream run provenance (D7).
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceAsset ; sh:class :Asset ; sh:minCount 2 ; sh:maxCount 2 ] ;
    sh:property [ sh:path :coOccurrenceKind ; sh:in ("SHARED_EXECUTIVE_CANDIDATE") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceMethod ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceWeight ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :coOccurrenceComputedOn ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :provenanceId ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:PortfolioShape
    a sh:NodeShape ;
    sh:targetClass :Portfolio ;
    # T-108 (D11): kind required (written explicitly by the projection, by source view).
    sh:property [ sh:path :portfolioName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :portfolioKind ; sh:in ("LIVE" "BENCHMARK") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :benchmarkObjective ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # live_book is upstream's snapshot of the live book and is never projected as a Portfolio (T-109).
    sh:property [ sh:path :benchmarkKind ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:not [ sh:in ("live_book") ] ] .

:QuantSubjectShape
    a sh:NodeShape ;
    # T-108/T-109: a BenchmarkObservation is about a BENCHMARK book, or about the LIVE book (performance upstream measured on its
    # live_book snapshot). Any other kind is rejected. Today this restates PortfolioShape's own sh:in; it is kept as the
    # single place to widen or narrow what a quant number may be about if a third kind is added.
    sh:property [ sh:path :portfolioKind ; sh:in ("LIVE" "BENCHMARK") ] .

:BenchmarkObservationShape
    a sh:NodeShape ;
    sh:targetClass :BenchmarkObservation ;
    # T-108 (D11): a finished upstream quant number about a BENCHMARK book or the LIVE book. Metric is free text (columns pinned in T-109,
    # see tbox.ttl). T-106: optional run provenance.
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantPortfolio ; sh:class :Portfolio ; sh:node :QuantSubjectShape ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantMetric ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantAsset ; sh:class :Asset ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantUnit ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quantAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    # T-109: a LIVE subject only carries performance numbers measured on upstream's live_book snapshot; book metrics
    # (expected_*, sharpe) and active_weight are about optimizer books.
    sh:or ( [ sh:path :quantPortfolio ; sh:node [ sh:property [ sh:path :portfolioKind ; sh:hasValue "BENCHMARK" ] ] ]
            [ sh:path :quantMetric ; sh:in ("realized_return" "cumulative_return" "benchmark_return" "active_return") ] ) ;
    sh:property [ sh:path :quantBenchmark ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :provenanceId ; sh:datatype xsd:string ; sh:maxCount 1 ] .

:RuleDefinitionShape
    a sh:NodeShape ;
    sh:targetClass :RuleDefinition ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasClause ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :priorityRank ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 7 ] ;
    sh:property [ sh:path :ruleId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :ruleSeverity ; sh:in ("HARD" "SOFT") ; sh:maxCount 1 ] ;
    # T-103: an active rule (no validTo) must declare its severity; the closed design-history rules need not.
    sh:or ( [ sh:path :validTo ; sh:minCount 1 ] [ sh:path :ruleSeverity ; sh:minCount 1 ] ) .

:RuleClauseShape
    a sh:NodeShape ;
    sh:targetClass :RuleClause ;
    sh:property [ sh:path :clauseType ; sh:in ("AND" "OR") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :operand1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :operand2 ; sh:minCount 1 ; sh:maxCount 1 ] .

:ThresholdComparisonShape
    a sh:NodeShape ;
    sh:targetClass :ThresholdComparison ;
    sh:property [ sh:path :metricName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum"
                         "leverage.debt_to_equity" "cashflow.free_cash_flow_margin" "liquidity.current_ratio"
                         "max_drawdown_90d" "fundamental_score_age_days") ] ;
    sh:property [ sh:path :operator ; sh:in (">" "<" ">=" "<=") ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :thresholdValue ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:maxCount 1 ] .

:CategoricalComparisonShape
    a sh:NodeShape ;
    sh:targetClass :CategoricalComparison ;
    sh:property [ sh:path :attributeName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :expectedValue ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

:GraphPredicateShape
    a sh:NodeShape ;
    sh:targetClass :GraphPredicate ;
    sh:property [ sh:path :predicateName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

:UniverseMembershipShape
    a sh:NodeShape ;
    sh:targetClass :UniverseMembership ;
    sh:property [ sh:path :membershipAsset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :membershipUniverse ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:lessThan :validTo ] ;
    # T-100: validTo is exclusive, so a stint with validTo <= validFrom would hold on no date.
    sh:property [ sh:path :validTo ; sh:datatype xsd:date ; sh:maxCount 1 ] .

:PortfolioPositionShape
    a sh:NodeShape ;
    sh:targetClass :PortfolioPosition ;
    # T-106: optional upstream run provenance (D7). Valid-time record closed later by validTo: these four record the run that OPENED it (validFrom);
    # later runs must not re-emit them and the closing run is not recorded.
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :positionAsset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :weightPct ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 100.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] .

:AssetShape
    a sh:NodeShape ;
    sh:targetClass :Asset ;
    sh:property [ sh:path :tickerSymbol ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :cikNumber ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    # T-100 (D1): upstream's universe.db has no CIK for a company that has left the index. cikNumber is therefore
    # required unless the Asset has at least one UniverseMembership and EVERY one of them is closed (has a validTo):
    # a current (open-membership) Asset without a CIK still fails.
    sh:or (
        [ sh:path :cikNumber ; sh:minCount 1 ]
        [ sh:path :hasUniverseMembership ; sh:minCount 1 ;
          sh:node [ sh:property [ sh:path :validTo ; sh:minCount 1 ] ] ]
    ) .

:SectorAggregateSnapshotShape
    a sh:NodeShape ;
    sh:targetClass :SectorAggregateSnapshot ;
    # T-106: optional upstream run provenance (D7).
    sh:property [ sh:path :runId ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :runAsOf ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path :codeVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :engineVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path :sectorSnapshotOfSector ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :normalizedScore ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :metricType ; sh:hasValue "ScoreTecnico" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :agentOrigin ; sh:hasValue "SECTOR" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :timestamp ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .

:AttractivenessSnapshotShape
    a sh:NodeShape ;
    sh:targetClass :AttractivenessSnapshot ;
    sh:property [ sh:path :attractivenessOfAsset ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :attractivenessScore ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :computedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :computedWithScheme ; sh:minCount 1 ; sh:maxCount 1 ] .

:AttractivenessWeightSchemeShape
    a sh:NodeShape ;
    sh:targetClass :AttractivenessWeightScheme ;
    sh:property [ sh:path :schemeId ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :validFrom ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :hasWeightComponent ; sh:minCount 1 ] .

:WeightComponentShape
    a sh:NodeShape ;
    sh:targetClass :WeightComponent ;
    sh:property [ sh:path :weightMetricName ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ScoreFinanciero" "ScoreCuantitativo" "ScoreTecnico" "Sentiment" "SectorRelativeMomentum") ] ;
    sh:property [ sh:path :weightValue ; sh:datatype xsd:decimal ; sh:minInclusive 0.0 ; sh:maxInclusive 1.0 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :inverted ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ] .
