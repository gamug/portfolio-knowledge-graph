@prefix :      <https://thesis.local/kg/portfolio#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Presentation vocabulary for the final graph (Work item 43, T-751;
# Work item 46, PR D). It is in the load plan and FR-001 and contains
# no run IRI and no engine data.
#################################################################

:PresentationScheme a skos:Collection ;
    rdfs:label "Presentation vocabulary"@en, "Vocabulario de presentación"@es ;
    rdfs:comment "Labels for codes and literals that cannot carry rdfs:label directly. A concept is found by its skos:inScheme and skos:notation."@en, "Etiquetas para códigos y literales que no pueden llevar rdfs:label directamente. Un concepto se encuentra por su skos:inScheme y skos:notation."@es .

:labelScheme a owl:AnnotationProperty ;
    rdfs:label "presentation vocabulary marker"@en, "marcador del vocabulario de presentación"@es ;
    rdfs:comment "Marks a concept as part of this presentation vocabulary; the SHACL shape targets its subjects."@en, "Marca un concepto como parte de este vocabulario de presentación; la forma SHACL apunta a sus sujetos."@es .

:windowStart a owl:DatatypeProperty ;
    rdfs:label "window start"@en, "inicio de la ventana"@es ;
    rdfs:range xsd:date ;
    rdfs:comment "First calendar date of a window concept."@en, "Primera fecha de calendario de un concepto de ventana."@es .

:windowEnd a owl:DatatypeProperty ;
    rdfs:label "window end"@en, "fin de la ventana"@es ;
    rdfs:range xsd:date ;
    rdfs:comment "Last calendar date of a window concept."@en, "Última fecha de calendario de un concepto de ventana."@es .

:historicalCondition a owl:AnnotationProperty ;
    rdfs:label "historical condition"@en, "condición histórica"@es ;
    rdfs:comment "The condition under which the window was originally defined or reserved, kept separate from the final-configuration condition."@en, "La condición con la que la ventana se definió o reservó originalmente, separada de la condición para la configuración final."@es .

:finalConfigurationCondition a owl:AnnotationProperty ;
    rdfs:label "final-configuration condition"@en, "condición para la configuración final"@es ;
    rdfs:comment "The condition that applies to results from the final configuration (in-sample for every window)."@en, "La condición aplicable a los resultados de la configuración final (dentro de muestra en todas las ventanas)."@es .


:WindowScheme a skos:ConceptScheme ;
    rdfs:label "Window vocabulary"@en, "Vocabulario de ventanas"@es .

:RunLabelScheme a skos:ConceptScheme ;
    rdfs:label "Run-label vocabulary"@en, "Vocabulario de etiquetas de corrida"@es .

:StrategyScheme a skos:ConceptScheme ;
    rdfs:label "Strategy vocabulary"@en, "Vocabulario de estrategias"@es .

:GuardScheme a skos:ConceptScheme ;
    rdfs:label "GUARD vocabulary"@en, "Vocabulario de GUARD"@es .

:VetoClassScheme a skos:ConceptScheme ;
    rdfs:label "Veto-class vocabulary"@en, "Vocabulario de clases de veto"@es .

:MarkerScheme a skos:ConceptScheme ;
    rdfs:label "Ineligibility-marker vocabulary"@en, "Vocabulario de marcadores de inelegibilidad"@es .

:ScoreComponentScheme a skos:ConceptScheme ;
    rdfs:label "Score-component vocabulary"@en, "Vocabulario de componentes del puntaje"@es .

:RankScheme a skos:ConceptScheme ;
    rdfs:label "Rank-column vocabulary"@en, "Vocabulario de columnas de ranking"@es .

:ConfigScheme a skos:ConceptScheme ;
    rdfs:label "Configuration-parameter vocabulary"@en, "Vocabulario de parámetros de configuración"@es .

:ProcessScheme a skos:ConceptScheme ;
    rdfs:label "Process and evaluation vocabulary"@en, "Vocabulario de proceso y evaluación"@es .

:Window_1 a skos:Concept ;
    skos:inScheme :WindowScheme ;
    skos:notation "P1" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Window 1 · Jan–Oct 2022, bear market with inflation"@en, "Ventana 1 · ene–oct 2022, mercado bajista con inflación"@es ;
    rdfs:comment "A window of the final backtest, named by calendar number and dates."@en, "Una ventana del backtest final, nombrada por número de calendario y fechas."@es ;
    skos:altLabel "Window 1"@en, "2022-01-03 to 2022-10-12"@en, "P1"@en, "bear market with inflation"@en ;
    skos:altLabel "Ventana 1"@es, "2022-01-03 a 2022-10-12"@es, "P1"@es, "mercado bajista con inflación"@es ;
    :windowStart "2022-01-03"^^xsd:date ;
    :windowEnd "2022-10-12"^^xsd:date ;
    :historicalCondition "Design window; bear market with inflation (docs/backtest.md)."@en, "Ventana de diseño; mercado bajista con inflación (docs/backtest.md)."@es ;
    :finalConfigurationCondition "In-sample results."@en, "Resultados dentro de muestra."@es .

:Window_2 a skos:Concept ;
    skos:inScheme :WindowScheme ;
    skos:notation "H1" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Window 2 · Oct 2022–Oct 2023"@en, "Ventana 2 · oct 2022–oct 2023"@es ;
    rdfs:comment "A window of the final backtest, named by calendar number and dates."@en, "Una ventana del backtest final, nombrada por número de calendario y fechas."@es ;
    skos:altLabel "Window 2"@en, "2022-10-13 to 2023-10-26"@en, "H1"@en ;
    skos:altLabel "Ventana 2"@es, "2022-10-13 a 2023-10-26"@es, "H1"@es ;
    :windowStart "2022-10-13"^^xsd:date ;
    :windowEnd "2023-10-26"^^xsd:date ;
    :historicalCondition "Originally reserved in the champion preregistration."@en, "Reservada originalmente en el preregistro del campeón."@es ;
    :finalConfigurationCondition "In-sample results."@en, "Resultados dentro de muestra."@es .

:Window_3 a skos:Concept ;
    skos:inScheme :WindowScheme ;
    skos:notation "P3" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Window 3 · Oct 2023–Aug 2024, bull market"@en, "Ventana 3 · oct 2023–ago 2024, mercado alcista"@es ;
    rdfs:comment "A window of the final backtest, named by calendar number and dates."@en, "Una ventana del backtest final, nombrada por número de calendario y fechas."@es ;
    skos:altLabel "Window 3"@en, "2023-10-27 to 2024-08-02"@en, "P3"@en, "bull market"@en ;
    skos:altLabel "Ventana 3"@es, "2023-10-27 a 2024-08-02"@es, "P3"@es, "mercado alcista"@es ;
    :windowStart "2023-10-27"^^xsd:date ;
    :windowEnd "2024-08-02"^^xsd:date ;
    :historicalCondition "Design window; bull market (docs/backtest.md)."@en, "Ventana de diseño; mercado alcista (docs/backtest.md)."@es ;
    :finalConfigurationCondition "In-sample results."@en, "Resultados dentro de muestra."@es .

:Window_4 a skos:Concept ;
    skos:inScheme :WindowScheme ;
    skos:notation "H2" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Window 4 · Aug 2024–Feb 2025"@en, "Ventana 4 · ago 2024–feb 2025"@es ;
    rdfs:comment "A window of the final backtest, named by calendar number and dates."@en, "Una ventana del backtest final, nombrada por número de calendario y fechas."@es ;
    skos:altLabel "Window 4"@en, "2024-08-05 to 2025-02-18"@en, "H2"@en ;
    skos:altLabel "Ventana 4"@es, "2024-08-05 a 2025-02-18"@es, "H2"@es ;
    :windowStart "2024-08-05"^^xsd:date ;
    :windowEnd "2025-02-18"^^xsd:date ;
    :historicalCondition "Originally reserved."@en, "Reservada originalmente."@es ;
    :finalConfigurationCondition "In-sample results."@en, "Resultados dentro de muestra."@es .

:Window_5 a skos:Concept ;
    skos:inScheme :WindowScheme ;
    skos:notation "P2" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Window 5 · Feb–Sep 2025 (P2)"@en, "Ventana 5 · feb–sep 2025 (P2)"@es ;
    rdfs:comment "The neutral fifth window; its scenario is not labelled."@en, "La quinta ventana neutral; su escenario no está etiquetado."@es ;
    skos:altLabel "Window 5"@en, "2025-02-19 to 2025-09-23"@en, "P2"@en ;
    skos:altLabel "Ventana 5"@es, "2025-02-19 a 2025-09-23"@es, "P2"@es ;
    :windowStart "2025-02-19"^^xsd:date ;
    :windowEnd "2025-09-23"^^xsd:date ;
    :historicalCondition "Design window; the scenario is not labelled in docs/backtest.md."@en, "Ventana de diseño; el escenario no está etiquetado en docs/backtest.md."@es ;
    :finalConfigurationCondition "In-sample results."@en, "Resultados dentro de muestra."@es .

:Window_6 a skos:Concept ;
    skos:inScheme :WindowScheme ;
    skos:notation "H3" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Window 6 · Sep 2025–Oct 2026"@en, "Ventana 6 · sep 2025–oct 2026"@es ;
    rdfs:comment "A window of the final backtest, named by calendar number and dates."@en, "Una ventana del backtest final, nombrada por número de calendario y fechas."@es ;
    skos:altLabel "Window 6"@en, "2025-09-24 to 2026-10-15"@en, "H3"@en ;
    skos:altLabel "Ventana 6"@es, "2025-09-24 a 2026-10-15"@es, "H3"@es ;
    :windowStart "2025-09-24"^^xsd:date ;
    :windowEnd "2026-10-15"^^xsd:date ;
    :historicalCondition "Originally reserved."@en, "Reservada originalmente."@es ;
    :finalConfigurationCondition "In-sample results."@en, "Resultados dentro de muestra."@es .

:RunLabel_final a skos:Concept ;
    skos:inScheme :RunLabelScheme ;
    skos:notation "final" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Final configuration run"@en, "Corrida de la configuración final"@es ;
    rdfs:comment "The delivery final_corregida (code_commit 5958c6b): six windows, all results in-sample; the default run label for final results."@en, "La entrega final_corregida (code_commit 5958c6b): seis ventanas, todos los resultados dentro de muestra; etiqueta predeterminada para los resultados finales."@es ;
    skos:altLabel "final configuration"@en, "corrida final"@en ;
    skos:altLabel "configuración final"@es, "corrida final"@es .

:GuardSupervision a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "GUARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "GUARD supervision"@en, "Supervisión GUARD"@es ;
    rdfs:comment "Rules that reduce or close positions between rebalances to limit losses."@en, "Reglas que reducen o cierran posiciones entre rebalanceos para limitar pérdidas."@es .

:GuardLayer_1 a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation 1 ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Per-stock stop and stop memory (layer 1)"@en, "Parada por acción y memoria de la parada (capa 1)"@es ;
    rdfs:comment "Layer 1 of the Veto Hierarchy: Basing Points stop, stop memory and blocked re-entry; the stop level is a price and is never stored."@en, "Capa 1 de la Jerarquía de Veto: parada Basing Points, memoria de la parada y reentrada bloqueada; el nivel de la parada es un precio y nunca se almacena."@es .

:AlertState_ENTER a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "ENTER" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Rule activated"@en, "Regla activada"@es ;
    rdfs:comment "The rule became active. It is not a buy or sell order."@en, "La regla pasó a estar activa. No es una orden de compra o venta."@es .

:AlertState_EXIT a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "EXIT" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Rule deactivated"@en, "Regla desactivada"@es ;
    rdfs:comment "The rule stopped being active. It is not a sale."@en, "La regla dejó de estar activa. No es una venta."@es .

:AlertState_ACTIVE a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "ACTIVE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Rule in effect"@en, "Regla vigente"@es ;
    rdfs:comment "The rule is in effect; it may not appear in the final run."@en, "La regla está vigente; puede no aparecer en la corrida final."@es .

:AlertState_COOLDOWN a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "COOLDOWN" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Rule in cool-down"@en, "Regla en enfriamiento"@es ;
    rdfs:comment "The rule is in a cool-down period; it may not appear in the final run."@en, "La regla está en un período de enfriamiento; puede no aparecer en la corrida final."@es .

:AlertState_SCALE a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "SCALE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Exposure scaled"@en, "Exposición escalada"@es ;
    rdfs:comment "Total exposure was scaled by the portfolio tail-risk layer (L0_* rules)."@en, "La exposición total se escaló por la capa de riesgo de cola de la cartera (reglas L0_*)."@es .

:ActionStatus_APPLIED a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "APPLIED" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Action applied"@en, "Acción aplicada"@es ;
    rdfs:comment "The book applied the action associated with the alert; it is an engine-rule application, not a market order."@en, "El libro aplicó la acción asociada a la alerta; es una aplicación de una regla del motor, no una orden ejecutada en el mercado."@es .

:ActionStatus_ARM_DISABLED a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "ARM_DISABLED" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Arm without GUARD (shadow alert)"@en, "Brazo sin GUARD (alerta en sombra)"@es ;
    rdfs:comment "The arm has no GUARD; the alert is informative only."@en, "El brazo no tiene GUARD; la alerta es solo informativa."@es .

:ActionStatus_NOT_HELD a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "NOT_HELD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Asset not held"@en, "Activo no mantenido"@es ;
    rdfs:comment "The book did not hold the asset."@en, "El libro no tenía el activo."@es .

:ActionStatus_SUPERSEDED a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "SUPERSEDED" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Alert superseded"@en, "Alerta reemplazada"@es ;
    rdfs:comment "Another alert replaced this one."@en, "Otra alerta la reemplazó."@es .

:VetoClass_Hard a skos:Concept ;
    skos:inScheme :VetoClassScheme ;
    skos:notation "HARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Excluded by a hard veto"@en, "Excluida por veto duro"@es ;
    rdfs:comment "The asset has at least one hard veto and is excluded from the eligible universe while the condition holds."@en, "Tiene al menos un veto duro y queda excluida del universo elegible mientras la condición esté vigente."@es .

:VetoClass_Soft a skos:Concept ;
    skos:inScheme :VetoClassScheme ;
    skos:notation "SOFT" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Soft penalty"@en, "Penalización suave"@es ;
    rdfs:comment "Subtracts points from the combined score; the asset remains eligible."@en, "Resta puntos al puntaje combinado; el activo sigue elegible."@es .

:VetoClass_Indicator a skos:Concept ;
    skos:inScheme :VetoClassScheme ;
    skos:notation "INDICATOR" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Informative indicator"@en, "Indicador informativo"@es ;
    rdfs:comment "Marks the asset but neither excludes it nor subtracts points; BREAK_TREND_200 is the only member."@en, "Marca el activo pero no lo excluye ni resta puntos; BREAK_TREND_200 es el único miembro."@es .

:Marker_HARD a skos:Concept ;
    skos:inScheme :MarkerScheme ;
    skos:notation "HARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Excluded by a hard veto"@en, "Excluida por veto duro"@es ;
    rdfs:comment "The ranking marker for a hard veto or a hard-veto JSON token."@en, "Marcador de ranking de un veto duro o de un token HARD en el JSON."@es .

:Marker_UNSCORED a skos:Concept ;
    skos:inScheme :MarkerScheme ;
    skos:notation "UNSCORED" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "No score available"@en, "Sin puntaje"@es ;
    rdfs:comment "The asset never had a fundamental score; it is ineligible, not penalized."@en, "El activo nunca tuvo puntaje fundamental; es inelegible, no penalizado."@es .

:Marker_UNPRICED a skos:Concept ;
    skos:inScheme :MarkerScheme ;
    skos:notation "UNPRICED" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "No price history"@en, "Sin historia de precios"@es ;
    rdfs:comment "There is not enough price history."@en, "No hay precios suficientes."@es .

:Marker_NO_RISK_MODEL a skos:Concept ;
    skos:inScheme :MarkerScheme ;
    skos:notation "NO_RISK_MODEL" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Not covered by the risk model"@en, "Sin cobertura del modelo de riesgo"@es ;
    rdfs:comment "Not enough returns for the risk model; this is an ineligibility cause, not a catalog veto, and it is not loaded as a literal in the final graph."@en, "No hay retornos suficientes para el modelo de riesgo; es una causa de inelegibilidad, no un veto del catálogo, y no está cargada como literal en el grafo final."@es .

:ScoreComponent_FUNDAMENTAL a skos:Concept ;
    skos:inScheme :ScoreComponentScheme ;
    skos:notation "FUNDAMENTAL" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Fundamental score"@en, "Puntaje fundamental"@es ;
    rdfs:comment "Computed from each quarterly financial report."@en, "Se calcula por informe financiero trimestral."@es .

:ScoreComponent_TECHNICAL a skos:Concept ;
    skos:inScheme :ScoreComponentScheme ;
    skos:notation "TECHNICAL" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Technical score"@en, "Puntaje técnico"@es ;
    rdfs:comment "Price trend and momentum."@en, "Tendencia y momentum de precios."@es .

:ScoreComponent_VALORIZATION a skos:Concept ;
    skos:inScheme :ScoreComponentScheme ;
    skos:notation "VALORIZATION" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Valuation score"@en, "Puntaje de valoración"@es ;
    rdfs:comment "Valuation multiples."@en, "Múltiplos de valoración."@es .

:ScoreComponent_SECTOR a skos:Concept ;
    skos:inScheme :ScoreComponentScheme ;
    skos:notation "SECTOR" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Sector-relative technical score"@en, "Puntaje técnico relativo al sector"@es ;
    rdfs:comment "The asset technical raw score minus its GICS sector mean on the date; a diagnostic, not part of the combined score."@en, "Puntaje técnico bruto de la acción menos el promedio de su sector GICS en la fecha; diagnóstico, no entra en el puntaje combinado."@es .

:RankColumn_Raw a skos:Concept ;
    skos:inScheme :RankScheme ;
    skos:notation "rank" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Raw ranking position (includes excluded names)"@en, "Posición en el ranking bruto (incluye excluidas)"@es ;
    rdfs:comment "Order by combined score over every classified member of the date, including vetoed names."@en, "Orden por puntaje combinado sobre todos los miembros clasificados de la fecha, incluidas las vetadas."@es ;
    skos:altLabel "rank"@en ;
    skos:altLabel "rank"@es .

:RankColumn_Eligible a skos:Concept ;
    skos:inScheme :RankScheme ;
    skos:notation "rank_e" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Rank among eligible companies"@en, "Posición entre empresas elegibles"@es ;
    rdfs:comment "Order by combined score among eligible names only; not loaded as a column in the final graph, so it must never be estimated or substituted."@en, "Orden por puntaje combinado solo entre elegibles; no está cargada como columna en el grafo final, así que nunca debe estimarse ni sustituirse."@es ;
    skos:altLabel "rank_e"@en ;
    skos:altLabel "rank_e"@es .

:Config_core_weight a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "core_weight" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "SPY core weight"@en, "Peso del núcleo SPY"@es ;
    rdfs:comment "Nominal 50% SPY core."@en, "Núcleo SPY nominal del 50 %."@es .

:Config_pool_m a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "pool_m" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Candidate pool size"@en, "Tamaño del grupo de candidatas"@es ;
    rdfs:comment "60 names."@en, "60 nombres."@es .

:Config_top_n a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "top_n" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Maximum satellite holdings"@en, "Máximo de acciones del satélite"@es ;
    rdfs:comment "30; it is not the number actually held."@en, "30; no es el número real mantenido."@es .

:Config_satellite_weighting a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "satellite_weighting" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Satellite weighting: minimum CVaR"@en, "Ponderación del satélite: mínimo CVaR"@es ;
    rdfs:comment "The effective satellite weighting (mincvar in the System); it is not objective."@en, "Ponderación efectiva del satélite (mincvar en el Sistema); no es objective."@es .

:Config_cvar_scenarios a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "cvar_scenarios" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "CVaR optimizer scenarios: daily simple returns"@en, "Escenarios del optimizador CVaR: retornos simples diarios"@es ;
    rdfs:comment "The risk model stores log returns; the optimizer converts them to simple returns."@en, "El modelo de riesgo guarda retornos logarítmicos; el optimizador los convierte a simples."@es .

:Config_cov_estimator a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "cov_estimator" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Covariance estimator: Ledoit-Wolf, constant correlation"@en, "Estimador de covarianza: Ledoit-Wolf con correlación constante"@es ;
    rdfs:comment "Ledoit-Wolf constant-correlation covariance."@en, "Covarianza Ledoit-Wolf con correlación constante."@es .

:Config_lookback a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "lookback" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Return history"@en, "Historia de retornos"@es ;
    rdfs:comment "756 return sessions."@en, "756 sesiones de retorno."@es .

:Config_min_history a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "min_history" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Minimum return history"@en, "Historia mínima de retornos"@es ;
    rdfs:comment "740 return sessions."@en, "740 sesiones de retorno."@es .

:Config_returns_members a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "returns_members" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Return panel universe: every point-in-time member on any session of the window, leavers included"@en, "Panel de retornos: todos los miembros puntuales en alguna sesión de la ventana, incluidos los que salieron"@es ;
    rdfs:comment "The old as-of panel used the members at the end of the window."@en, "El panel antiguo as-of usaba los miembros al final de la ventana."@es .

:Config_trend_filter a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "trend_filter" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Trend filter"@en, "Filtro de tendencia"@es ;
    rdfs:comment "Evaluated at the decision date and in force until the next one; it affects the System core and satellite, not every strategy."@en, "Se evalúa en la fecha de decisión y rige hasta la siguiente; afecta al núcleo y al satélite del Sistema, no a toda estrategia."@es .

:Config_filter_exit a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "filter_exit" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Trend-filter exit fraction"@en, "Fracción de salida del filtro de tendencia"@es ;
    rdfs:comment "At a decision date, if SPY's total-return index is below its 210-session simple average, each target weight is multiplied by (1 - filter_exit); 0.5 moves half the exposure to cash until the next decision."@en, "En una fecha de decisión, si el índice de retorno total de SPY está por debajo de su media simple de 210 sesiones, cada peso objetivo se multiplica por (1 - filter_exit); 0,5 mueve la mitad de la exposición a efectivo hasta la siguiente decisión."@es .

:Config_stop_rule a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "stop_rule" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Stop rule: Basing Points, variant 4"@en, "Regla de parada: Basing Points, variante 4"@es ;
    rdfs:comment "Basing Points variant 4 for the System layer 1."@en, "Basing Points variante 4 para la capa 1 del Sistema."@es .

:Config_cost_bps a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "cost_bps" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Transaction cost (basis points of turnover)"@en, "Costo de transacción (puntos básicos de la rotación)"@es ;
    rdfs:comment "10 basis points, applied to the sum of absolute equity-weight changes."@en, "10 puntos básicos, aplicados a la suma de los cambios absolutos de peso en acciones."@es .

:Config_vol_target a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "vol_target" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Volatility target (layer 3)"@en, "Meta de volatilidad (capa 3)"@es ;
    rdfs:comment "Configured; the layer had no activity."@en, "Configurado; la capa no tuvo actividad."@es .

:Config_exclude_hard_vetoed a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "exclude_hard_vetoed" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Hard-veto filter in the shared covariance model (internal)"@en, "Filtro de vetos duros en el modelo de covarianza compartido (interno)"@es ;
    rdfs:comment "It is 0 also in the System because the shared model includes vetoed names; the System excludes hard vetoes earlier, in the preselection. Never say the System does not exclude hard-vetoed companies."@en, "Vale 0 también en el Sistema porque el modelo compartido incluye los vetados; el Sistema excluye los vetos duros antes, en la preselección. Nunca decir que el Sistema no excluye empresas con veto duro."@es .

:Config_tilt a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "tilt" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Score tilt (internal)"@en, "Inclinación por puntaje (interno)"@es ;
    rdfs:comment "Internal; hide in ordinary answers."@en, "Interno; ocultar en respuestas ordinarias."@es .

:Config_blend a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "blend" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Score blend (internal)"@en, "Mezcla de puntajes (interno)"@es ;
    rdfs:comment "Internal; hide in ordinary answers."@en, "Interno; ocultar en respuestas ordinarias."@es .

:Config_rp a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "rp" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Risk parity (internal)"@en, "Paridad de riesgo (interno)"@es ;
    rdfs:comment "Internal; hide in ordinary answers."@en, "Interno; ocultar en respuestas ordinarias."@es .

:Config_news_model a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "news_model" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "News model (internal)"@en, "Modelo de noticias (interno)"@es ;
    rdfs:comment "Internal; hide in ordinary answers."@en, "Interno; ocultar en respuestas ordinarias."@es .

:Config_news_db a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "news_db" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "News database (internal)"@en, "Base de noticias (interno)"@es ;
    rdfs:comment "Internal; hide in ordinary answers."@en, "Interno; ocultar en respuestas ordinarias."@es .

:Config_shadow_from a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "shadow_from" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Shadow start (internal)"@en, "Inicio en sombra (interno)"@es ;
    rdfs:comment "Internal; hide in ordinary answers."@en, "Interno; ocultar en respuestas ordinarias."@es .

:Config_objective_min_var a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "min_var" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Registered optimization class"@en, "Clasificación de optimización registrada"@es ;
    rdfs:comment "The fixed label the engine writes for every optimized arm; it documents the minimum-variance selection stage. It is NOT the satellite weighting objective (use satellite_weighting: mincvar in the System)."@en, "Etiqueta fija que el motor escribe para cada brazo optimizado; documenta la etapa de selección por mínima varianza. NO es la función objetivo de ponderación del satélite (usar satellite_weighting: mincvar en el Sistema)."@es ;
    skos:altLabel "objective"@en, "min_var"@en ;
    skos:altLabel "objective"@es, "min_var"@es .

:Process_PIT_UNIVERSE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "PIT_UNIVERSE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Point-in-time universe"@en, "Universo puntual en el tiempo"@es ;
    rdfs:comment "S&P 500 members reconstructed by their membership on each date, not the current constituents."@en, "Los miembros del S&P 500 se reconstruyen según su pertenencia en cada fecha, no según los componentes actuales."@es .

:Process_ELIGIBLE_UNIVERSE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "ELIGIBLE_UNIVERSE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Eligible universe for selection"@en, "Universo elegible para la selección"@es ;
    rdfs:comment "Members on the date that have score, prices and risk-model coverage and no hard veto (vetoed = 0); eligibility does not mean the asset reaches the final book."@en, "Miembros del índice en la fecha que cumplen la disponibilidad de puntaje, precios y cobertura del modelo de riesgo y no tienen veto duro (vetoed = 0); elegible no significa que llegue a la cartera final."@es .

:Process_CANDIDATE_POOL a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "CANDIDATE_POOL" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Candidate pool"@en, "Grupo de candidatas"@es ;
    rdfs:comment "In the System and the multifactor variants, the top 60 by eligible rank; it is not the number of stocks finally held."@en, "En el Sistema y las variantes multifactoriales, las 60 mejores por posición entre elegibles; no es el número de acciones finalmente mantenidas."@es .

:Process_MAX_SATELLITE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "MAX_SATELLITE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Maximum satellite holdings"@en, "Máximo de acciones del satélite"@es ;
    rdfs:comment "At most 30; the actual number of positions is lower."@en, "Hasta 30; el número real de posiciones es menor."@es .

:Process_SELECTION a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "SELECTION" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Selection"@en, "Selección"@es ;
    rdfs:comment "In the multifactor strategies, scores and vetoes determine the candidate pool; the Markowitz comparison books start from eligible members without that selection."@en, "En las estrategias multifactoriales, los puntajes y los vetos determinan el grupo de candidatas; los Markowitz de comparación parten de los miembros elegibles sin esa selección."@es .

:Process_WEIGHTING a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "WEIGHTING" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Weighting"@en, "Ponderación"@es ;
    rdfs:comment "In the System the satellite is weighted by minimum CVaR under its caps; the other strategies use their configured method (e.g. minimum variance)."@en, "En el Sistema el satélite se pondera por mínimo CVaR bajo sus topes; las demás estrategias usan el método de su configuración (p. ej. mínima varianza)."@es .

:Process_CORE_SATELLITE_CASH a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "CORE_SATELLITE_CASH" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Core / satellite / cash"@en, "Núcleo / satélite / efectivo"@es ;
    rdfs:comment "In the System, the nominal 50% SPY core and 50% satellite; the realized exposure can differ."@en, "En el Sistema, núcleo SPY nominal del 50 % y satélite del 50 %; la exposición realizada puede diferir."@es .

:Process_NOMINAL_REALIZED a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "NOMINAL_REALIZED" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Nominal / realized composition"@en, "Composición nominal / realizada"@es ;
    rdfs:comment "Nominal is what the configuration declares; realized is what results after the trend filter, the optimizer and GUARD."@en, "Nominal es la que declara la configuración; realizada es la que resulta tras el filtro de tendencia, el optimizador y GUARD."@es .

:Process_SCHEDULED_REBALANCE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "SCHEDULED_REBALANCE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Scheduled rebalance"@en, "Rebalanceo programado"@es ;
    rdfs:comment "Every 21 sessions the engine books recompute selection and weights and trade the difference; this is distinct from GUARD daily adjustments."@en, "Cada 21 sesiones los libros del motor recalculan la selección y los pesos y operan la diferencia; es distinto de los ajustes diarios de GUARD."@es .

:Process_TRADING_DAY a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "TRADING_DAY" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Trading day"@en, "Día con operaciones"@es ;
    rdfs:comment "A session with turnover greater than zero."@en, "Sesión con rotación mayor que cero."@es .

:Process_GROSS_NET a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "GROSS_NET" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Gross / net return"@en, "Retorno bruto / neto"@es ;
    rdfs:comment "Net return subtracts transaction costs."@en, "El retorno neto descuenta los costos de transacción."@es .

:Process_SHARPE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "SHARPE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Sharpe ratio"@en, "Ratio de Sharpe"@es ;
    rdfs:comment "Mean excess return over its standard deviation; state whether it is annualized."@en, "Media del retorno en exceso sobre su desviación estándar; indicar si está anualizado."@es .

:Process_CVAR_95 a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "CVAR_95" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "95% CVaR"@en, "CVaR 95 %"@es ;
    rdfs:comment "Mean loss conditional on being in the worst 5% of the evaluated returns; state the return frequency and sign convention."@en, "Pérdida media condicionada a estar en el 5 % de los peores retornos de la serie evaluada; indicar la frecuencia y la convención de signo."@es .

:Process_MDD a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "MDD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Maximum drawdown"@en, "Máxima caída"@es ;
    rdfs:comment "Largest percentage fall from a running peak to the later trough before recovering that peak; not a daily loss."@en, "Mayor caída porcentual desde un máximo acumulado hasta el mínimo posterior antes de recuperar ese máximo; no es una pérdida diaria."@es .

:Process_TURNOVER a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "TURNOVER" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Turnover"@en, "Rotación"@es ;
    rdfs:comment "Full sum of absolute equity-weight changes, not divided by two; cash does not count; it is the cost base."@en, "Suma completa de los cambios absolutos de peso en acciones, sin dividir entre dos; el efectivo no cuenta; es la base del costo."@es .

:Process_TRANSACTION_COSTS a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "TRANSACTION_COSTS" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Transaction costs"@en, "Costos de transacción"@es ;
    rdfs:comment "Basis points of turnover (10 in the main runs)."@en, "Puntos básicos de la rotación (10 en las corridas principales)."@es .

:Process_BENCHMARK a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "BENCHMARK" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Benchmark"@en, "Referencia"@es ;
    rdfs:comment "A comparison strategy; see the strategy vocabulary."@en, "Estrategia de comparación; ver el vocabulario de estrategias."@es .

:Process_DSR_PBO a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "DSR_PBO" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Deflated Sharpe ratio / probability of backtest overfitting"@en, "Ratio de Sharpe deflactado / probabilidad de sobreajuste"@es ;
    rdfs:comment "Selection and overfitting diagnostics; not superiority tests between strategies and not automatic acceptance criteria."@en, "Diagnósticos de selección y sobreajuste; no son pruebas de superioridad entre estrategias ni criterios automáticos de aceptación."@es .

:Process_DATA_STATE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "DATA_STATE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Data availability and quality"@en, "Disponibilidad y calidad del dato"@es ;
    rdfs:comment "Available, unavailable, insufficient, stale or provisional."@en, "Disponible, no disponible, insuficiente, desactualizado o provisional."@es .

:Process_DATA_NATURE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "DATA_NATURE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Data nature"@en, "Naturaleza del dato"@es ;
    rdfs:comment "Observed, calculated or derived; a different dimension from the data state."@en, "Observado, calculado o derivado; una dimensión distinta del estado del dato."@es .

:Process_IN_SAMPLE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "IN_SAMPLE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "In-sample result"@en, "Resultado dentro de muestra"@es ;
    rdfs:comment "A result from a window that was seen before the final configuration was chosen."@en, "Resultado de una ventana que se vio antes de elegir la configuración final."@es .

:Process_OUT_OF_SAMPLE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "OUT_OF_SAMPLE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Out-of-sample result"@en, "Resultado fuera de muestra"@es ;
    rdfs:comment "A result from data not seen before the configuration was chosen; the final configuration has none."@en, "Resultado de datos no vistos antes de elegir la configuración; la configuración final no tiene ninguno."@es .

:Process_COUNTING_RULE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "COUNTING_RULE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Counting rule"@en, "Regla de conteo"@es ;
    rdfs:comment "Rows whose date lies inside the window date range; formation-day alerts and warm-up vetoes are reported separately and included when a window total is given."@en, "Filas con fecha dentro de los límites de la ventana; las alertas del día de formación y los vetos del calentamiento se reportan aparte y se incluyen cuando se da el total de la ventana."@es .

:Process_FORMATION_DAY_ALERT a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "FORMATION_DAY_ALERT" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Formation-day alert"@en, "Alerta del día de formación"@es ;
    rdfs:comment "A layer-1 alert dated on the last session before the window; report it separately from the in-window alerts."@en, "Alerta de capa 1 fechada en la última sesión antes de la ventana; reportarla aparte de las alertas dentro de la ventana."@es .

:Process_WARMUP_VETO a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "WARMUP_VETO" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Warm-up veto"@en, "Veto del calentamiento"@es ;
    rdfs:comment "A veto dated before the window because the book starts its cycles 12 steps earlier; report it separately."@en, "Veto fechado antes de la ventana porque el libro arranca sus ciclos 12 pasos antes; reportarlo aparte."@es .

:Process_NOT_IN_KNOWLEDGE_BASE a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "NOT_IN_KNOWLEDGE_BASE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Not in the knowledge base used"@en, "No está en la base de conocimiento usada"@es ;
    rdfs:comment "The data is not available in the graph used for the answer; it does not mean the data does not exist in the project."@en, "El dato no está disponible en el grafo usado para la respuesta; no significa que no exista en el proyecto."@es .

:Process_CONCEPTUAL_ANSWER a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "CONCEPTUAL_ANSWER" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Conceptual answer"@en, "Respuesta conceptual"@es ;
    rdfs:comment "A definition or explanation needs no window, run or counting rule."@en, "Una definición o explicación no necesita ventana, corrida ni regla de conteo."@es .

:Process_OPERATIONS_NOT_ORDERS a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "OPERATIONS_NOT_ORDERS" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "GUARD states are not orders"@en, "Los estados de GUARD no son órdenes"@es ;
    rdfs:comment "States and alerts are not buy or sell orders; a weight change alone does not prove a trade."@en, "Los estados y alertas no son órdenes de compra o venta; un cambio de peso por sí solo no demuestra una operación."@es .

:Process_SCORE_NOT_WEIGHT a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "SCORE_NOT_WEIGHT" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Score is not weight"@en, "El puntaje no es el peso"@es ;
    rdfs:comment "The score determines the candidate pool; the weights come from the optimizer and satellite_weighting, not from the score or objective."@en, "El puntaje determina el grupo de candidatas; los pesos vienen del optimizador y de satellite_weighting, no del puntaje ni de objective."@es .

:Strategy_System a skos:Concept ;
    skos:inScheme :StrategyScheme ;
    skos:notation "TOPN_MV_GUARD_NO_NLP" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Core-satellite multifactor with CVaR weighting and GUARD supervision"@en, "Núcleo-satélite multifactorial con ponderación por CVaR y supervisión GUARD"@es ;
    rdfs:comment "Nominal mandate of 50% SPY and 50% in up to 30 stocks from the 60-name eligible candidate pool (technical, valuation and fundamental scores with vetoes), weighted by minimum CVaR with a per-name cap of 1.5 divided by the number of stocks, trend filter and GUARD supervision; the realized composition differs from the nominal mandate."@en, "Mandato nominal de 50 % en SPY y 50 % en hasta 30 acciones del grupo de 60 candidatas elegibles (puntajes técnico, de valoración y fundamental con vetos), ponderadas por mínimo CVaR con tope por nombre de 1.5 dividido entre el número de acciones, filtro de tendencia y supervisión GUARD; la composición realizada difiere del mandato nominal."@es ;
    skos:altLabel "The System"@en, "Sistema"@en, "NS-CVaR-GUARD"@en ;
    skos:altLabel "El Sistema"@es, "Sistema"@es, "NS-CVaR-GUARD"@es .

:Strategy_SystemNoGuard a skos:Concept ;
    skos:inScheme :StrategyScheme ;
    skos:notation "TOPN_MV_NOGUARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Core-satellite multifactor with CVaR weighting, without GUARD"@en, "Núcleo-satélite multifactorial con ponderación por CVaR, sin GUARD"@es ;
    rdfs:comment "The System without GUARD supervision."@en, "El Sistema sin la supervisión GUARD."@es ;
    skos:altLabel "FINAL NOGUARD"@en, "NS-CVaR"@en ;
    skos:altLabel "FINAL NOGUARD"@es, "NS-CVaR"@es .

:Strategy_MinVarianceLedoitWolf a skos:Concept ;
    skos:inScheme :StrategyScheme ;
    skos:notation "MARKOWITZ_BASE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Markowitz minimum variance (Ledoit-Wolf covariance)"@en, "Markowitz de mínima varianza (covarianza Ledoit-Wolf)"@es ;
    rdfs:comment "Minimum-variance portfolio over the eligible S&P 500 members, long-only, at most 5% per stock and 30% per sector, with Ledoit-Wolf shrinkage covariance; it does not estimate expected returns; no SPY, trend filter or selection."@en, "Cartera de mínima varianza sobre los miembros elegibles del S&P 500, solo largos, máximo 5 % por acción y 30 % por sector, con covarianza con contracción de Ledoit-Wolf; no estima retornos esperados; sin SPY, filtro ni selección."@es ;
    skos:altLabel "Minimum variance (MV-LW)"@en, "Mínima varianza (MV-LW)"@en ;
    skos:altLabel "Minimum variance (MV-LW)"@es, "Mínima varianza (MV-LW)"@es .

:Strategy_MinVarianceLedoitWolfGuard a skos:Concept ;
    skos:inScheme :StrategyScheme ;
    skos:notation "MARKOWITZ_BASE_GUARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Markowitz minimum variance (Ledoit-Wolf covariance) with GUARD supervision"@en, "Markowitz de mínima varianza (covarianza Ledoit-Wolf) con supervisión GUARD"@es ;
    rdfs:comment "The Ledoit-Wolf minimum-variance portfolio with GUARD supervision (21-session per-stock stop and drawdown scaling)."@en, "La cartera de mínima varianza (Ledoit-Wolf) con la supervisión GUARD (parada de 21 sesiones por acción y escalamiento por caída)."@es ;
    skos:altLabel "Minimum variance (MV-LW) + GUARD"@en, "Mínima varianza (MV-LW) + GUARD"@en ;
    skos:altLabel "Minimum variance (MV-LW) + GUARD"@es, "Mínima varianza (MV-LW) + GUARD"@es .

:Strategy_MeanVarianceBase a skos:Concept ;
    skos:inScheme :StrategyScheme ;
    skos:notation "MARKOWITZ_MV" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Base Markowitz (mean-variance)"@en, "Markowitz base de media-varianza (cartera de tangencia; medias y covarianza históricas)"@es ;
    rdfs:comment "Only per-window and segment summaries are loaded (no daily series, weights or alerts); computed outside the engine by an independent simulator validated against the engine MARKOWITZ_BASE book; in-sample; no GUARD."@en, "Solo se cargan resúmenes por ventana y segmento (sin serie diaria, pesos ni alertas); calculada fuera del motor por un simulador independiente validado contra el libro MARKOWITZ_BASE del motor; resultados dentro de muestra; sin GUARD."@es ;
    skos:altLabel "Markowitz base (MV-Tangencia)"@en, "MV-Tangencia"@en ;
    skos:altLabel "Markowitz base (MV-Tangencia)"@es, "MV-Tangencia"@es .

#################################################################
# Fundamentals block C metric vocabulary (Work item 45, T-816)
# 37 concepts = the 38 source names minus value_inputs. The approved
# labels/comments are the frozen table in docs/labels-fundamentals-review.md.
#################################################################

:FundamentalMetricScheme a skos:ConceptScheme ;
    rdfs:label "Fundamental metric vocabulary"@en, "Vocabulario de métricas fundamentales"@es .

:FundamentalMetric_asset_turnover a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "asset_turnover" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "efficiency" ;
    :metricUnit "x" ;
    rdfs:label "Asset turnover"@en, "Rotación de activos"@es ;
    rdfs:comment "Revenue divided by the total assets on the filing's balance sheet (not an average); times (x). Read verbatim from the delivery; absent when the source value is null."@en, "Ingresos divididos entre los activos totales del balance del informe (no el promedio); veces (x). Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_capex_intensity a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "capex_intensity" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "cashflow" ;
    :metricUnit "ratio" ;
    rdfs:label "Capex intensity"@en, "Intensidad de capex"@es ;
    rdfs:comment "Capital expenditure divided by revenue; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Inversión de capital dividida entre los ingresos; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_cash_ratio a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "cash_ratio" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "liquidity" ;
    :metricUnit "x" ;
    rdfs:label "Cash ratio"@en, "Ratio de caja"@es ;
    rdfs:comment "Cash and cash equivalents plus short-term investments, divided by current liabilities; times. Read verbatim from the delivery; absent when the source value is null."@en, "Efectivo y equivalentes más inversiones de corto plazo, divididos entre los pasivos corrientes; veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_current_ratio a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "current_ratio" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "liquidity" ;
    :metricUnit "x" ;
    rdfs:label "Current ratio"@en, "Ratio corriente"@es ;
    rdfs:comment "Current assets divided by current liabilities; times. Read verbatim from the delivery; absent when the source value is null."@en, "Activos corrientes divididos entre pasivos corrientes; veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_debt_to_assets a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "debt_to_assets" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "leverage" ;
    :metricUnit "ratio" ;
    rdfs:label "Debt to assets"@en, "Deuda sobre activos"@es ;
    rdfs:comment "Total debt divided by total assets; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Deuda total dividida entre los activos totales; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_debt_to_equity a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "debt_to_equity" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "leverage" ;
    :metricUnit "x" ;
    rdfs:label "Debt to equity"@en, "Deuda sobre patrimonio"@es ;
    rdfs:comment "Total debt divided by parent stockholders' equity; times. Read verbatim from the delivery; absent when the source value is null."@en, "Deuda total dividida entre el patrimonio de la controladora; veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_ebitda a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "ebitda" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "leverage" ;
    :metricUnit "usd" ;
    rdfs:label "EBITDA"@en, "EBITDA"@es ;
    rdfs:comment "Operating income plus depreciation and amortization (never depreciation alone); USD. Read verbatim from the delivery; absent when the source value is null."@en, "Utilidad operativa más depreciación y amortización (nunca solo la depreciación); USD. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_effective_tax_rate a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "effective_tax_rate" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "roic" ;
    :metricUnit "ratio" ;
    rdfs:label "Effective tax rate"@en, "Tasa impositiva efectiva"@es ;
    rdfs:comment "Income tax expense divided by pre-tax income; fraction. Empty when pre-tax income is zero or negative. Read verbatim from the delivery; absent when the source value is null."@en, "Gasto por impuesto a la renta dividido entre la utilidad antes de impuestos; fracción. Vacío cuando la utilidad antes de impuestos es cero o negativa. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_enterprise_fcf_yield a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "enterprise_fcf_yield" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "valuation" ;
    :metricUnit "ratio" ;
    rdfs:label "Enterprise FCF yield"@en, "Rendimiento del flujo de caja libre sobre el valor de empresa"@es ;
    rdfs:comment "Free cash flow to the firm (NOPAT minus net investment: capex minus depreciation and amortization plus the change in non-cash working capital) divided by enterprise value; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Flujo de caja libre de la firma (NOPAT menos la inversión neta: capex menos depreciación y amortización más la variación del capital de trabajo no monetario) dividido entre el valor de empresa; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_enterprise_value a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "enterprise_value" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "valuation" ;
    :metricUnit "usd" ;
    rdfs:label "Enterprise value"@en, "Valor de empresa"@es ;
    rdfs:comment "Market capitalization plus debt plus noncontrolling interest, minus cash and short-term investments, at the end of the filing's period; USD. Empty when market capitalization, debt or cash is missing. Read verbatim from the delivery; absent when the source value is null."@en, "Capitalización de mercado más deuda más participación no controladora, menos efectivo e inversiones de corto plazo, al fin del período del informe; USD. Vacío si falta la capitalización, la deuda o el efectivo. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_free_cash_flow_conversion a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "free_cash_flow_conversion" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "cashflow" ;
    :metricUnit "x" ;
    rdfs:label "Free cash flow conversion"@en, "Conversión de flujo de caja libre"@es ;
    rdfs:comment "Free cash flow divided by net income; times. Read verbatim from the delivery; absent when the source value is null."@en, "Flujo de caja libre dividido entre la utilidad neta; veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_free_cash_flow_growth a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "free_cash_flow_growth" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "growth" ;
    :metricUnit "ratio" ;
    rdfs:label "Free cash flow growth"@en, "Crecimiento del flujo de caja libre"@es ;
    rdfs:comment "Year-over-year growth of free cash flow; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Crecimiento interanual del flujo de caja libre; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_free_cash_flow_margin a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "free_cash_flow_margin" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "cashflow" ;
    :metricUnit "ratio" ;
    rdfs:label "Free cash flow margin"@en, "Margen de flujo de caja libre"@es ;
    rdfs:comment "Free cash flow divided by revenue; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Flujo de caja libre dividido entre los ingresos; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_free_cash_flow_yield a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "free_cash_flow_yield" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "valuation" ;
    :metricUnit "ratio" ;
    rdfs:label "Free cash flow yield"@en, "Rendimiento del flujo de caja libre"@es ;
    rdfs:comment "Free cash flow divided by market capitalization; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Flujo de caja libre dividido entre la capitalización de mercado; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_gross_margin a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "gross_margin" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "profitability" ;
    :metricUnit "ratio" ;
    rdfs:label "Gross margin"@en, "Margen bruto"@es ;
    rdfs:comment "Gross profit divided by revenue; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Utilidad bruta dividida entre los ingresos; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_interest_coverage a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "interest_coverage" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "leverage" ;
    :metricUnit "x" ;
    rdfs:label "Interest coverage"@en, "Cobertura de intereses"@es ;
    rdfs:comment "Operating income divided by interest expense; times. Read verbatim from the delivery; absent when the source value is null."@en, "Utilidad operativa dividida entre el gasto por intereses; veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_inventory_turnover a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "inventory_turnover" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "efficiency" ;
    :metricUnit "x" ;
    rdfs:label "Inventory turnover"@en, "Rotación de inventario"@es ;
    rdfs:comment "Cost of revenue divided by the inventory on the filing's balance sheet (not an average); times. Read verbatim from the delivery; absent when the source value is null."@en, "Costo de ventas dividido entre el inventario del balance del informe (no el promedio); veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_market_capitalization a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "market_capitalization" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "valuation" ;
    :metricUnit "usd" ;
    rdfs:label "Market capitalization"@en, "Capitalización de mercado"@es ;
    rdfs:comment "Closing price at the end of the filing's period (or the last close before it) times the shares outstanding of every class; USD. Read verbatim from the delivery; absent when the source value is null."@en, "Precio de cierre al fin del período del informe (o el último cierre anterior) por las acciones en circulación de todas las clases; USD. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_net_debt_to_ebitda a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "net_debt_to_ebitda" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "leverage" ;
    :metricUnit "x" ;
    rdfs:label "Net debt to EBITDA"@en, "Deuda neta sobre EBITDA"@es ;
    rdfs:comment "Net debt divided by EBITDA; times. Read verbatim from the delivery; absent when the source value is null."@en, "Deuda neta dividida entre EBITDA; veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_net_income_cagr a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "net_income_cagr" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "cagr" ;
    :metricUnit "ratio" ;
    rdfs:label "Net income CAGR"@en, "CAGR de la utilidad neta"@es ;
    rdfs:comment "Compound annual growth rate of parent net income between the first and last years reported in the same 10-K (usually two years); fraction. Empty when either end is zero or negative. Read verbatim from the delivery; absent when the source value is null."@en, "Tasa de crecimiento anual compuesta de la utilidad neta de la controladora entre el primer y el último año que reporta el mismo 10-K (en general, dos años); fracción. Vacía si alguno de los extremos es cero o negativo. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_net_income_growth a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "net_income_growth" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "growth" ;
    :metricUnit "ratio" ;
    rdfs:label "Net income growth"@en, "Crecimiento de la utilidad neta"@es ;
    rdfs:comment "Year-over-year growth of net income; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Crecimiento interanual de la utilidad neta; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_net_margin a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "net_margin" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "profitability" ;
    :metricUnit "ratio" ;
    rdfs:label "Net margin"@en, "Margen neto"@es ;
    rdfs:comment "Net income divided by revenue; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Utilidad neta dividida entre los ingresos; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_nopat a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "nopat" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "roic" ;
    :metricUnit "usd" ;
    rdfs:label "NOPAT"@en, "NOPAT"@es ;
    rdfs:comment "Operating income times (1 − 21%), the statutory rate; zero tax on an operating loss; USD. Read verbatim from the delivery; absent when the source value is null."@en, "Utilidad operativa por (1 − 21%), la tasa legal; impuesto cero cuando hay pérdida operativa; USD. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_operating_cash_flow_cagr a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "operating_cash_flow_cagr" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "cagr" ;
    :metricUnit "ratio" ;
    rdfs:label "Operating cash flow CAGR"@en, "CAGR del flujo de caja operativo"@es ;
    rdfs:comment "Compound annual growth rate of operating cash flow between the first and last years reported in the same 10-K (usually two years); fraction. Empty when either end is zero or negative. Read verbatim from the delivery; absent when the source value is null."@en, "Tasa de crecimiento anual compuesta del flujo de caja operativo entre el primer y el último año que reporta el mismo 10-K (en general, dos años); fracción. Vacía si alguno de los extremos es cero o negativo. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_operating_cash_flow_margin a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "operating_cash_flow_margin" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "cashflow" ;
    :metricUnit "ratio" ;
    rdfs:label "Operating cash flow margin"@en, "Margen de flujo de caja operativo"@es ;
    rdfs:comment "Operating cash flow divided by revenue; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Flujo de caja operativo dividido entre los ingresos; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_operating_income_growth a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "operating_income_growth" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "growth" ;
    :metricUnit "ratio" ;
    rdfs:label "Operating income growth"@en, "Crecimiento de la utilidad operativa"@es ;
    rdfs:comment "Year-over-year growth of operating income; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Crecimiento interanual de la utilidad operativa; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_operating_margin a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "operating_margin" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "profitability" ;
    :metricUnit "ratio" ;
    rdfs:label "Operating margin"@en, "Margen operativo"@es ;
    rdfs:comment "Operating income divided by revenue; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Utilidad operativa dividida entre los ingresos; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_quick_ratio a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "quick_ratio" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "liquidity" ;
    :metricUnit "x" ;
    rdfs:label "Quick ratio"@en, "Ratio rápido"@es ;
    rdfs:comment "(Current assets minus inventory) divided by current liabilities; times. Read verbatim from the delivery; absent when the source value is null."@en, "(Activos corrientes menos inventario) divididos entre pasivos corrientes; veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_receivables_turnover a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "receivables_turnover" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "efficiency" ;
    :metricUnit "x" ;
    rdfs:label "Receivables turnover"@en, "Rotación de cuentas por cobrar"@es ;
    rdfs:comment "Revenue divided by the receivables on the filing's balance sheet (not an average); times. Read verbatim from the delivery; absent when the source value is null."@en, "Ingresos divididos entre las cuentas por cobrar del balance del informe (no el promedio); veces. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_return_on_assets a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "return_on_assets" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "profitability" ;
    :metricUnit "ratio" ;
    rdfs:label "Return on assets"@en, "Retorno sobre activos"@es ;
    rdfs:comment "Annual NOPAT divided by total assets at the end of the prior fiscal year; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "NOPAT anual dividido entre los activos totales al cierre del año fiscal anterior; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_return_on_equity a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "return_on_equity" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "profitability" ;
    :metricUnit "ratio" ;
    rdfs:label "Return on equity"@en, "Retorno sobre patrimonio"@es ;
    rdfs:comment "Trailing-twelve-month parent net income divided by parent equity at the end of the prior fiscal year; fraction. Empty when that equity is zero or negative. Read verbatim from the delivery; absent when the source value is null."@en, "Utilidad neta de la controladora de los últimos doce meses dividida entre el patrimonio de la controladora al cierre del año fiscal anterior; fracción. Vacío cuando ese patrimonio es cero o negativo. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_return_on_invested_capital a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "return_on_invested_capital" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "roic" ;
    :metricUnit "ratio" ;
    rdfs:label "Return on invested capital"@en, "Retorno sobre el capital invertido"@es ;
    rdfs:comment "NOPAT divided by invested capital at the end of the prior fiscal year (debt plus parent equity plus noncontrolling interest, minus cash and short-term investments); fraction. Read verbatim from the delivery; absent when the source value is null."@en, "NOPAT dividido entre el capital invertido al cierre del año fiscal anterior (deuda más patrimonio de la controladora más participación no controladora, menos efectivo e inversiones de corto plazo); fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_return_on_invested_capital_effective_rate a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "return_on_invested_capital_effective_rate" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "roic" ;
    :metricUnit "ratio" ;
    rdfs:label "Return on invested capital (effective tax rate)"@en, "Retorno sobre el capital invertido (tasa impositiva efectiva)"@es ;
    rdfs:comment "As ROIC, but with NOPAT computed at the filing's effective tax rate instead of the statutory rate; a robustness variant; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Como el ROIC, pero con el NOPAT calculado con la tasa impositiva efectiva del informe en lugar de la legal; variante de robustez; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_revenue_cagr a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "revenue_cagr" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "cagr" ;
    :metricUnit "ratio" ;
    rdfs:label "Revenue CAGR"@en, "CAGR de los ingresos"@es ;
    rdfs:comment "Compound annual growth rate of revenue between the first and last years reported in the same 10-K (usually two years); fraction. Empty when either end is zero or negative. Read verbatim from the delivery; absent when the source value is null."@en, "Tasa de crecimiento anual compuesta de los ingresos entre el primer y el último año que reporta el mismo 10-K (en general, dos años); fracción. Vacía si alguno de los extremos es cero o negativo. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_revenue_growth a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "revenue_growth" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "growth" ;
    :metricUnit "ratio" ;
    rdfs:label "Revenue growth"@en, "Crecimiento de los ingresos"@es ;
    rdfs:comment "Year-over-year growth of revenue; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Crecimiento interanual de los ingresos; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_sbc_adjusted_fcf_yield a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "sbc_adjusted_fcf_yield" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "valuation" ;
    :metricUnit "ratio" ;
    rdfs:label "SBC-adjusted FCF yield"@en, "Rendimiento del flujo de caja libre ajustado por SBC"@es ;
    rdfs:comment "SBC-adjusted free cash flow divided by market capitalization; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Flujo de caja libre ajustado por compensación en acciones dividido entre la capitalización de mercado; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

:FundamentalMetric_utility_cash_coverage_3y a skos:Concept ;
    skos:inScheme :FundamentalMetricScheme ;
    skos:notation "utility_cash_coverage_3y" ;
    :labelScheme :PresentationScheme ;
    :metricGroup "rule_input" ;
    :metricUnit "ratio" ;
    rdfs:label "Utility cash coverage (3 years)"@en, "Cobertura de caja de servicios públicos (3 años)"@es ;
    rdfs:comment "Three-year average of operating cash flow before working-capital changes, divided by total debt; regulated utilities only. It is the input of the `UTILITY_CASH_COVERAGE` rule; fraction. Read verbatim from the delivery; absent when the source value is null."@en, "Promedio de tres años del flujo de caja operativo antes de cambios en el capital de trabajo, dividido entre la deuda total; solo empresas de servicios públicos reguladas. Es la entrada de la regla `UTILITY_CASH_COVERAGE`; fracción. Leído verbatim de la entrega; ausente cuando el valor de origen es nulo."@es .

#################################################################
# Veto Hierarchy labels (Work item 46, PR D, T-860–T-862)
# Reviewer A approved the texts in the 2026-11-13 letter; the
# frozen table is docs/labels-veto-review.md.
#################################################################

:Concept_Window_C1 a skos:Concept ;
    skos:inScheme :WindowScheme ;
    skos:notation "C1" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Window C1"@en, "Ventana C1"@es ;
    rdfs:comment "The continuous C1 window, 2022-01 to 2026-10: an independent run that starts at scale 1.0 and shares no state (scale, memory or holdings) with P1-P3/H1-H3. It is added as a label concept in PR D; the loader does not write it to `labels.ttl` in PR A."@en, "La ventana continua C1, de 2022-01 a 2026-10: una corrida independiente que empieza con escala 1,0 y no comparte estado (escala, memoria ni posiciones) con P1-P3/H1-H3. Se añade como concepto de etiqueta en el PR D; el cargador no la escribe en `labels.ttl` en el PR A."@es ;
    :windowStart "2022-01-03"^^xsd:date ;
    :windowEnd "2026-10-15"^^xsd:date .

:Concept_VetoHierarchy a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "VETO_HIERARCHY" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Veto Hierarchy"@en, "Jerarquía de Veto"@es ;
    rdfs:comment "The System's layered protection scheme: rule veto in selection, the trend filter on the index, the portfolio GUARD (per-stock stops, stop memory, exposure scale and destination of freed weight) and, if the final variant carries it, the news rule. The rules bound the manager agent; the agent never loosens them."@en, "El esquema de protección del Sistema, por capas: el veto de reglas en la selección, el filtro de tendencia sobre el índice, el GUARD de cartera (paradas por acción, memoria de la parada, escala de exposición y destino del peso liberado) y, si la variante final la lleva, la regla de noticias. Las reglas limitan al agente gestor; el agente nunca las afloja."@es .

:Concept_RulesGuard a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "RULES_GUARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Rules GUARD"@en, "GUARD de reglas"@es ;
    rdfs:comment "The hard/soft rule layer that excludes or penalises names before selection; not the portfolio GUARD."@en, "La capa de reglas duras y suaves que excluyen o penalizan nombres antes de la selección; no es el GUARD de cartera."@es .

:Concept_NewsGuard a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "NEWS_GUARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "News GUARD"@en, "GUARD de noticias"@es ;
    rdfs:comment "The news layer: at each decision date it removes from the candidate pool the companies whose recent news are clearly more negative than their base rate, and brings in companies just outside the pool whose news are clearly more positive. Loaded only if the System's final variant carries news."@en, "La capa de noticias: en cada fecha de decisión saca del grupo de candidatas a las empresas cuyas noticias recientes son claramente más negativas que su tasa base, y hace entrar a empresas cercanas al grupo con noticias claramente más positivas. Se carga solo si la variante final del Sistema lleva noticias."@es .

:Concept_PortfolioGuard a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "PORTFOLIO_GUARD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Portfolio GUARD"@en, "GUARD de cartera"@es ;
    rdfs:comment "The daily supervision layer between decisions: per-stock stops (Basing Points, L1_BP_* rules), stop memory, exposure scale driven by the portfolio's tail risk (L0_* rules) and destination of the weight a stop frees."@en, "La capa de supervisión diaria entre decisiones: paradas por acción (Basing Points, reglas L1_BP_*), memoria de la parada, escala de exposición por el riesgo de cola de la cartera (reglas L0_*) y destino del peso que libera una parada."@es .

:Concept_SystemWithoutHierarchy a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "SYSTEM_WITHOUT_HIERARCHY" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "System without the Veto Hierarchy"@en, "Sistema sin jerarquía"@es ;
    rdfs:comment "The control arm without risk rules, trend filter or portfolio GUARD; it keeps data quality, earnings-missing, pool 100 and retention."@en, "El brazo de control sin reglas de riesgo, filtro de tendencia ni GUARD de cartera; conserva calidad de datos, faltantes de resultados, grupo 100 y retención."@es .

:Concept_TailRiskThreshold a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "TAIL_RISK_THRESHOLD" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Tail-risk threshold"@en, "Umbral de riesgo de cola"@es ;
    rdfs:comment "The 80th percentile of the previous 252 values of the 63-session CVaR95 that triggers layer-0 activation; published as `:alertThreshold` on L0_* alerts."@en, "El percentil 80 de los 252 valores anteriores del CVaR95 a 63 sesiones que dispara la activación de capa 0; se publica como `:alertThreshold` en las alertas L0_*."@es .

:Concept_PortfolioTailRisk a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "PORTFOLIO_TAIL_RISK" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Portfolio tail risk"@en, "Riesgo de cola de la cartera"@es ;
    rdfs:comment "The portfolio's 63-session CVaR95 that layer 0 measures; published as `:alertValue` on L0_* alerts."@en, "El CVaR95 a 63 sesiones de la cartera que la capa 0 mide; se publica como `:alertValue` en las alertas L0_*."@es .

:Concept_RiskRatio a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "RISK_RATIO" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Risk ratio (rho)"@en, "Razón de riesgo (ρ)"@es ;
    rdfs:comment "ρ = C/θ: the book's 95% CVaR over the last 63 sessions (weights held fixed) divided by its threshold θ, the 80th percentile of its previous 252 values; 1 is the threshold and lower values mean less risk. Published in `:rhoW0`, `:rho` and `:optionRho`."@en, "ρ = C/θ: el CVaR al 95% de las últimas 63 sesiones del libro (pesos fijos) dividido por su umbral θ, el percentil 80 de sus 252 valores anteriores; 1 es el umbral y los valores menores indican menos riesgo. Se publica en `:rhoW0`, `:rho` y `:optionRho`."@es .

:Concept_RiskZone a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "RISK_ZONE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Risk zone"@en, "Zona de riesgo"@es ;
    rdfs:comment "Derived rho classification: LOW with rho ≤ 0.90, MIDDLE with rho ≤ 1 and HIGH with rho > 1; not stored as a literal."@en, "Clasificación derivada de rho: LOW con rho ≤ 0,90, MIDDLE con rho ≤ 1 y HIGH con rho > 1; no se almacena como literal."@es .

:Concept_ExposureScale a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "EXPOSURE_SCALE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Exposure scale"@en, "Escala de exposición"@es ;
    rdfs:comment "The exposure multiplier in force; 1 means no cut and values between 0 and 1 cut the book. Published on decisions, stops and L0_* alerts."@en, "El multiplicador de exposición en vigor; 1 significa sin recorte y los valores entre 0 y 1 recortan el libro. Se publica en decisiones, paradas y alertas L0_*."@es .

:Concept_RiskEpisode a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "RISK_EPISODE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Risk episode"@en, "Episodio de riesgo"@es ;
    rdfs:comment "The interval between layer-0 activation and recovery, derived from the `:exposureScale` dates and the L0_* alerts; it has no individual of its own."@en, "El intervalo entre la activación de capa 0 y su recuperación, derivado de las fechas de `:exposureScale` y de las alertas L0_*; no tiene individuo propio."@es .

:Concept_FreedWeightDestination a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "FREED_WEIGHT_DESTINATION" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Destination of the freed weight"@en, "Destino del peso liberado"@es ;
    rdfs:comment "What receives a stop's weight: a menu option, SPY or cash, through `:chosenOption`, `:chosenCash` and `:cashLeft`."@en, "Lo que recibe el peso de una parada: una opción del menú, SPY o efectivo, con `:chosenOption`, `:chosenCash` y `:cashLeft`."@es .

:Concept_Replacement a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "REPLACEMENT" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Replacement"@en, "Reemplazo"@es ;
    rdfs:comment "The purchase that uses the weight freed by a stop and the check of whether it was still a candidate at the next decision."@en, "La compra que usa el peso liberado por una parada y la verificación de si seguía siendo candidata en la decisión siguiente."@es .

:Concept_DestinationMenu a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "DESTINATION_MENU" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Destination menu"@en, "Menú de destinos"@es ;
    rdfs:comment "The ordered set of allowed destinations of a stop, each with its rho, R, beta, rank, score, sector, size and weight."@en, "El conjunto ordenado de destinos permitidos de una parada, cada uno con su rho, R, beta, puesto, puntaje, sector, tamaño y peso."@es .

:Concept_CashCause a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "CASH_CAUSE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Cash cause"@en, "Causa de efectivo"@es ;
    rdfs:comment "Why the freed weight stayed in cash: FILTER_OFF, SCALE_BELOW_ONE, NO_SIGNAL or NO_ALLOWED_DESTINATION."@en, "Por qué el peso liberado quedó en efectivo: FILTER_OFF, SCALE_BELOW_ONE, NO_SIGNAL o NO_ALLOWED_DESTINATION."@es .

:Concept_StopMemory a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "STOP_MEMORY" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Stop memory"@en, "Memoria de la parada"@es ;
    rdfs:comment "The per-asset record of the first stop and of its release from the memory (by price or by leaving the ranking); the stop level is not stored because it is a price."@en, "El registro por activo de la primera parada y de su salida de la memoria (por precio o por salir del ranking); el nivel de la parada no se almacena porque es un precio."@es .

:Concept_BlockedReentry a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "BLOCKED_REENTRY" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Blocked re-entry"@en, "Reentrada bloqueada"@es ;
    rdfs:comment "The state of a name in the stop memory that is still below the stored level at a decision; published as a BLOCKED alert and action of `L1_BP_STOP_BLOCKED`."@en, "La situación de un nombre en la memoria de la parada que sigue por debajo del nivel guardado en una decisión; se publica como alerta y acción BLOCKED de `L1_BP_STOP_BLOCKED`."@es .

:Concept_BasicSystem a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "BASIC_SYSTEM" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Basic system"@en, "Sistema básico"@es ;
    rdfs:comment "The System variant with pool 60 and retention off; read from `:systemVariant \"basic\"`, `:poolSize 60` and `:retentionEnabled false`."@en, "La variante del Sistema con grupo 60 y retención apagada; se lee de `:systemVariant \"basic\"`, `:poolSize 60` y `:retentionEnabled false`."@es .

:Concept_CompleteSystem a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "COMPLETE_SYSTEM" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Complete system"@en, "Sistema completo"@es ;
    rdfs:comment "The System variant with pool 100 and retention on; read from `:systemVariant \"complete\"`, `:poolSize 100` and `:retentionEnabled true`."@en, "La variante del Sistema con grupo 100 y retención encendida; se lee de `:systemVariant \"complete\"`, `:poolSize 100` y `:retentionEnabled true`."@es .

:Concept_Retention a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "RETENTION" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Retention"@en, "Retención"@es ;
    rdfs:comment "The rule that keeps held names as candidates for up to three decisions; published in `:RetentionDecision` and `:RetentionHold`."@en, "La regla que mantiene nombres del libro como candidatas hasta tres decisiones; se publica en `:RetentionDecision` y `:RetentionHold`."@es .

:Concept_RetentionCounter a skos:Concept ;
    skos:inScheme :ConfigScheme ;
    skos:notation "RETENTION_COUNTER" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Retention counter"@en, "Contador de retención"@es ;
    rdfs:comment "The number of decisions in which a held name was a candidate only by retention; 1 to 3 on retained holdings and 0 to 3 on rejections (0 = rejected before its first retention)."@en, "El número de decisiones en que una mantenida fue candidata solo por retención; de 1 a 3 en las retenidas y de 0 a 3 en los rechazos (0 = rechazada antes de su primera retención)."@es .

:Concept_NewsVeto a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "NEWS_VETO" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "News veto"@en, "Veto por noticias"@es ;
    rdfs:comment "A company's removal from the candidate pool at one decision because of news clearly more negative than its base rate; it lasts one decision. Loaded only if the final variant carries news."@en, "La salida de una empresa del grupo de candidatas en una decisión por noticias claramente más negativas que su tasa base; dura una decisión. Se carga solo si la variante final lleva noticias."@es .

:Concept_NewsPromotion a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "NEWS_PROMOTION" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "News promotion"@en, "Promoción por noticias"@es ;
    rdfs:comment "The entry into the candidate pool of a company just outside it because of news clearly more positive than its base rate. Loaded only if the final variant carries news."@en, "La entrada al grupo de candidatas de una empresa cercana al grupo por noticias claramente más positivas que su tasa base. Se carga solo si la variante final lleva noticias."@es .

:Concept_NewsBaseRate a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "NEWS_BASE_RATE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "News base rate"@en, "Tasa base de noticias"@es ;
    rdfs:comment "The future news base rate, with numerator and denominator; it has no pilot data."@en, "La tasa base futura de noticias, con numerador y denominador; no tiene datos en el piloto."@es .

:Concept_NewsTemporalCoverage a skos:Concept ;
    skos:inScheme :GuardScheme ;
    skos:notation "NEWS_TEMPORAL_COVERAGE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "News temporal coverage"@en, "Cobertura temporal de noticias"@es ;
    rdfs:comment "The future interval covered by news evidence, with first and last dates; it has no pilot data."@en, "El intervalo futuro que cubre la evidencia de noticias, con primera y última fecha; no tiene datos en el piloto."@es .

:Concept_ManagerAgent a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "MANAGER_AGENT" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Manager agent"@en, "Agente gestor"@es ;
    rdfs:comment "The language agent that, as chooser, decides the destination of the weight a stop frees within what the rules allow, and writes its reason; it does not narrate events (the narrator does). Its calls are loaded only if the final chooser is the agent."@en, "El agente de lenguaje que, como elector, decide el destino del peso que libera una parada dentro de lo que permiten las reglas, y escribe su razón; no narra eventos (eso lo hace el narrador). Sus llamadas se cargan solo si el elector final es el agente."@es .

:Concept_Chooser a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "CHOOSER" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Chooser"@en, "Elector"@es ;
    rdfs:comment "Who chose the destination: `rule` or `agent`; published in `:chooser` and, in the future, in `:answerChoice`."@en, "Quién eligió el destino: `rule` o `agent`; se publica en `:chooser` y, en el futuro, en `:answerChoice`."@es .

:Concept_Narrator a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "NARRATOR" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Narrator"@en, "Narrador"@es ;
    rdfs:comment "The future component that produces narrative text; it has no texts in the pilot."@en, "El componente futuro que produce texto narrativo; no tiene textos en el piloto."@es .

:Concept_ManagerInvestmentPolicy a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "MANAGER_INVESTMENT_POLICY" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Manager investment policy"@en, "Política de inversión del gestor"@es ;
    rdfs:comment "The future manager policy with skill/policy hashes; it has no file in the pilot."@en, "La política futura del gestor con hashes de habilidad y política; no tiene archivo en el piloto."@es .

:Concept_FallbackChoice a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "FALLBACK_CHOICE" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Fallback choice"@en, "Elección de respaldo"@es ;
    rdfs:comment "The rule's choice used when the call to the agent fails or its answer does not pass the validator, with the cause."@en, "La elección de la regla que se usa cuando la llamada al agente falla o su respuesta no pasa el validador, con la causa."@es .

:Concept_Validator a skos:Concept ;
    skos:inScheme :ProcessScheme ;
    skos:notation "VALIDATOR" ;
    :labelScheme :PresentationScheme ;
    rdfs:label "Validator"@en, "Validador"@es ;
    rdfs:comment "The future validation of a manager choice, with the result and the cause."@en, "La validación futura de una elección del agente, con el resultado y la causa."@es .
