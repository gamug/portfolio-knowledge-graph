:accessionNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :SECFiling ;
    rdfs:range xsd:string .

:agentOrigin a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "One of FUNDAMENTAL | SEMANTIC | QUANTITATIVE | TECHNICAL. SHACL sh:in enforced." ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:string .

:appliesRule a owl:ObjectProperty ;
    rdfs:comment "All rules that fired for this Veto (v1 'Mapeo de Activaciones Multiples')." ;
    rdfs:domain :Veto ;
    rdfs:range :RuleDefinition .

:atr14 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :PriceObservation ;
    rdfs:range xsd:decimal .

:attributeName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "e.g. 'category', 'severity' — a RiskEvent field name." ;
    rdfs:domain :CategoricalComparison ;
    rdfs:range xsd:string .

:canonicalId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Executive ;
    rdfs:range xsd:string .

:category a owl:DatatypeProperty ;
    rdfs:comment "On RiskEvent: LEGAL | FINANCIAL | MARKET | NETWORK. On RuleDefinition: free-text category label matching v1's catalog table." ;
    rdfs:range xsd:string .

:cikNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "SEC Central Index Key — stable join key to edgar_tool.py output." ;
    rdfs:domain :Asset ;
    rdfs:range xsd:string .

:classifiedAs a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "An Asset's GICS industry group. Functional: one primary industry per Asset at a time." ;
    rdfs:domain :Asset ;
    rdfs:range :Industry ;
    owl:inverseOf :industryOfAsset .

:closePrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :PriceObservation ;
    rdfs:range xsd:decimal .

:companyName a owl:DatatypeProperty ;
    rdfs:domain :Asset ;
    rdfs:range xsd:string .

:dailyReturnPct a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :PriceObservation ;
    rdfs:range xsd:decimal .

:decidedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Veto ;
    rdfs:range xsd:dateTime .

:detectedAt a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :RiskEvent ;
    rdfs:range xsd:dateTime .

:executiveName a owl:DatatypeProperty ;
    rdfs:domain :Executive ;
    rdfs:range xsd:string .

:expectedValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :CategoricalComparison ;
    rdfs:range xsd:string .

:filingDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :SECFiling ;
    rdfs:range xsd:date .

:filingOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :SECFiling ;
    rdfs:range :Asset .

:formType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "'10-K' | '10-Q' | '8-K' | 'DEF 14A'." ;
    rdfs:domain :SECFiling ;
    rdfs:range xsd:string .

:hasExecutive a owl:ObjectProperty ;
    rdfs:comment "Extracted from DEF 14A (v1 §2B)." ;
    rdfs:domain :Asset ;
    rdfs:range :Executive .

:hasScoreObservation a owl:ObjectProperty ;
    rdfs:comment "v1 §3A: (Asset)-[:HAS_SCORE_OBSERVATION]->(ScoreSnapshot)." ;
    rdfs:domain :Asset ;
    rdfs:range :ScoreSnapshot ;
    owl:inverseOf :scoreSnapshotOfAsset .

:hasUniverseMembership a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :UniverseMembership ;
    owl:inverseOf :membershipAsset .

:holdsPosition a owl:ObjectProperty ;
    rdfs:domain :Portfolio ;
    rdfs:range :PortfolioPosition .

:itemLabel a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "'ITEM_1A_RISK_FACTORS' | 'ITEM_3_LEGAL_PROCEEDINGS' | 'DEF14A_DIRECTORS'." ;
    rdfs:domain :SECFilingSection ;
    rdfs:range xsd:string .

:memberOfSector a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "GICS industry -> sector roll-up (07-ontology-topology.md reasoning profile)." ;
    rdfs:domain :Industry ;
    rdfs:range :Sector ;
    owl:inverseOf :sectorIndustries .

:membershipUniverse a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :UniverseMembership ;
    rdfs:range :Universe .

:metricName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ThresholdComparison ;
    rdfs:range xsd:string .

:metricType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:string .

:normalizedScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "[0.0, 1.0], 0=no risk, 1=critical risk (v1 §3A). Range enforced by SHACL." ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:decimal .

:observationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :PriceObservation ;
    rdfs:range xsd:date .

:operator a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "'>' | '<' | '>=' | '<='." ;
    rdfs:domain :ThresholdComparison ;
    rdfs:range xsd:string .

:partOfFiling a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :SECFilingSection ;
    rdfs:range :SECFiling .

:portfolioName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Portfolio ;
    rdfs:range xsd:string .

:positionAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :PortfolioPosition ;
    rdfs:range :Asset .

:predicateName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "e.g. 'HasSharedPrimaryVetoExecutive' — identifies which named traversal the Orchestrator runs." ;
    rdfs:domain :GraphPredicate ;
    rdfs:range xsd:string .

:priceObservationOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :PriceObservation ;
    rdfs:range :Asset .

:primaryRule a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "The single lowest-priorityRank rule among appliesRule (v1 §4)." ;
    rdfs:domain :Veto ;
    rdfs:range :RuleDefinition .

:priorityRank a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "1 (highest) .. 6 (lowest), used to pick primaryRule (v1 §4)." ;
    rdfs:domain :RuleDefinition ;
    rdfs:range xsd:integer .

:provenanceId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "On NewsArticle: 'articles:<id>' / 'discovered_urls:<id>' from the existing SQLite pipeline. On SECFilingSection: an accession-number-based id from the EDGAR batch pipeline." ;
    rdfs:range xsd:string .

:publishedDate a owl:DatatypeProperty ;
    rdfs:domain :NewsArticle ;
    rdfs:range xsd:date .

:rawValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:decimal .

:ruleId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :RuleDefinition ;
    rdfs:range xsd:string .

:severity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "CRITICAL | HIGH | MODERATE | LOW." ;
    rdfs:domain :RiskEvent ;
    rdfs:range xsd:string .

:sharedExecutiveWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Derived/asserted by the entity-resolution service (roadmap step 7), never hand-authored. Backs VETO_RED_01's HasSharedPrimaryVetoExecutive(A) check (v1 §4)." ;
    rdfs:domain :Asset ;
    rdfs:range :Asset .

:sourceNamedGraph a owl:AnnotationProperty ;
    rdfs:label "Source Named Graph" ;
    rdfs:comment "Generated ONLY in protege-view.ttl (not part of the ontology itself): records which named graph an individual originally came from in schema/instances.trig, since Protege has no concept of named graphs/quads and would otherwise silently flatten that information away." .

:sourceURL a owl:DatatypeProperty ;
    rdfs:domain :NewsArticle ;
    rdfs:range xsd:anyURI .

:supersededBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Points from an original section to its corrected/restated replacement. The named-graph the replacement lands in carries the new transaction-time; both stay queryable (closes critique #8, worked example in instances.trig)." ;
    rdfs:domain :SECFilingSection ;
    rdfs:range :SECFilingSection .

:thresholdValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ThresholdComparison ;
    rdfs:range xsd:decimal .

:tickerSymbol a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :Asset ;
    rdfs:range xsd:string .

:timestamp a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range xsd:dateTime .

:triggeredBy a owl:ObjectProperty ;
    rdfs:comment "v1 §3B: (Veto)-[:DISPARADO_POR]->(RiskEvent)." ;
    rdfs:domain :Veto ;
    rdfs:range :RiskEvent .

:triggeredVeto a owl:ObjectProperty ;
    rdfs:domain :Asset ;
    rdfs:range :Veto ;
    owl:inverseOf :vetoOfAsset .

:validFrom a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Valid-time start (06-ontology-definition.md §1.4)." ;
    rdfs:range xsd:date .

:validTo a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "Valid-time end. Absent/unbound == currently active." ;
    rdfs:range xsd:date .

:weightPct a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain :PortfolioPosition ;
    rdfs:range xsd:decimal .

