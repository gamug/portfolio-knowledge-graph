:backedBy a owl:ObjectProperty ;
    rdfs:comment "SHACL requires sh:minCount 1: no RiskEvent may exist without >=1 evidence link (closes critique #5)." ;
    rdfs:domain :RiskEvent ;
    rdfs:range :EvidenceSource ;
    owl:inverseOf :evidenceForRiskEvent .

:clauseType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "'AND' | 'OR'. SHACL sh:in enforced." ;
    rdfs:domain :RuleClause ;
    rdfs:range xsd:string .

:evidenceForRiskEvent a owl:ObjectProperty ;
    rdfs:comment "Inverse of backedBy — supports 'which risk events cite this article/section' audit queries (evolution layer B9)." ;
    rdfs:domain :EvidenceSource ;
    rdfs:range :RiskEvent .

:hasClause a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Root of the rule's expression tree. May point directly to a leaf comparison for single-signal rules (e.g. VETO_FIN_01) — the tree degenerates gracefully to one node." ;
    rdfs:domain :RuleDefinition ;
    rdfs:range :RuleOperand .

:industryOfAsset a owl:ObjectProperty ;
    rdfs:domain :Industry ;
    rdfs:range :Asset .

:membershipAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :UniverseMembership ;
    rdfs:range :Asset .

:operand1 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :RuleClause ;
    rdfs:range :RuleOperand .

:operand2 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :RuleClause ;
    rdfs:range :RuleOperand .

:scoreSnapshotOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :ScoreSnapshot ;
    rdfs:range :Asset .

:sectorIndustries a owl:ObjectProperty ;
    rdfs:domain :Sector ;
    rdfs:range :Industry .

:vetoOfAsset a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain :Veto ;
    rdfs:range :Asset .

:EvidenceSource a owl:Class ;
