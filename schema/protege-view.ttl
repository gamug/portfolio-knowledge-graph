:Cat_COMP02_Category a :CategoricalComparison ;
    :attributeName "category" ;
    :expectedValue "LEGAL" .

:Cat_COMP02_Severity a :CategoricalComparison ;
    :attributeName "severity" ;
    :expectedValue "HIGH" .

:Cat_LEG01_Category a :CategoricalComparison ;
    :attributeName "category" ;
    :expectedValue "LEGAL" .

:Cat_LEG01_Severity a :CategoricalComparison ;
    :attributeName "severity" ;
    :expectedValue "CRITICAL" .

:Clause_COMP01_Inner a :RuleClause ;
    :clauseType "OR" ;
    :operand1 :Cmp_COMP01_SentLow ;
    :operand2 :Cmp_COMP01_TecHigh .

:Clause_COMP01_Root a :RuleClause ;
    :clauseType "AND" ;
    :operand1 :Cmp_COMP01_FinHigh ;
    :operand2 :Clause_COMP01_Inner .

:Clause_COMP02_LegalHigh a :RuleClause ;
    :clauseType "AND" ;
    :operand1 :Cat_COMP02_Category ;
    :operand2 :Cat_COMP02_Severity .

:Clause_COMP02_Root a :RuleClause ;
    :clauseType "AND" ;
    :operand1 :Clause_COMP02_LegalHigh ;
    :operand2 :Clause_COMP02_SentOrQuant .

:Clause_COMP02_SentOrQuant a :RuleClause ;
    :clauseType "OR" ;
    :operand1 :Cmp_COMP02_SentLow ;
    :operand2 :Cmp_COMP02_QuantHigh .

:Clause_COMP03_Root a :RuleClause ;
    :clauseType "AND" ;
    :operand1 :Cmp_COMP03_QuantHigh ;
    :operand2 :Cmp_COMP03_TecHigh .

:Clause_LEG01_Root a :RuleClause ;
    :clauseType "AND" ;
    :operand1 :Cat_LEG01_Category ;
    :operand2 :Cat_LEG01_Severity .

:Clause_RED01_Inner a :RuleClause ;
    :clauseType "OR" ;
    :operand1 :Cmp_RED01_SentLow ;
    :operand2 :Cmp_RED01_FinHigh .

:Clause_RED01_Root a :RuleClause ;
    :clauseType "AND" ;
    :operand1 :Pred_RED01_SharedExec ;
    :operand2 :Clause_RED01_Inner .

